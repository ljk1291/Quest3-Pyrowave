+}
+
 #[derive(SettingsSchema, Serialize, Deserialize, Clone, PartialEq)]
 pub struct FoveatedEncodingConfig {
     #[schema(strings(help = "Force enable on smartphone clients"))]
     #[schema(flag = "hidden")]
     pub force_enable: bool,
 
+    #[schema(strings(display_name = "Foveation profile", help = "Light, Medium and H.264 fit pin the documented fixed centre and edge values. Custom exposes the advanced values below. The feature remains disabled until its parent switch is enabled."))]
