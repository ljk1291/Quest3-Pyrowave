+    #[schema(strings(display_name = "Blur peripheral only", help = "Keeps the full encoded geometry and applies the same smoothly ramped peripheral prefilter. It can reduce codec artifacts but does not reduce decoder pixels."))]
+    #[schema(flag = "steamvr-restart")]
+    pub blur_only: bool,
+
     #[schema(strings(
