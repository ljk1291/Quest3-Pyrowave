+++ b/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl
@@ -14,7 +14,8 @@ SamplerState trilinearSampler {
 
 float4 main(float2 uv : TEXCOORD0) : SV_Target {
 	bool isRightEye = uv.x > 0.5;
-	float2 eyeUV = TextureToEyeUV(uv, isRightEye) / eyeSizeRatio;
+	float2 outputEyeUV = TextureToEyeUV(uv, isRightEye);
+	float2 eyeUV = outputEyeUV / eyeSizeRatio;
 
 	float2 shift = CenterShiftForEye(isRightEye);
 
@@ -39,6 +40,31 @@ float4 main(float2 uv : TEXCOORD0) : SV_Target {
 	float2 rightEdge = g2 * center + (1. - g2) * d3;
 
 	float2 compressedUV = underBound * leftEdge + inBound * center + overBound * rightEdge;
+	if (blurOnly > .5) compressedUV = outputEyeUV;
 
-	return compositionTexture.Sample(trilinearSampler, EyeToTextureUV(compressedUV, isRightEye));
+	// One bilinear source tap aliases a 1.5–2x squeezed band. Integrate the
+	// source-pixel box with exact overlap weights. The bounded 7x7 support covers
+	// the 2x profile plus s=1 while smoothstep is C1 at the centre-band join.
+	float edge = max(abs(outputEyeUV.x - .5), abs(outputEyeUV.y - .5)) * 2.;
+	float ramp = smoothstep(centerSize.x, 1., edge);
+	float2 texel = float2(1. / targetResolution.x, 1. / targetResolution.y);
+	float2 sourceStep = max(abs(ddx(compressedUV)), abs(ddy(compressedUV)));
+	float2 localSqueeze = max(float2(1., 1.), sourceStep / texel);
+	float2 footprint = localSqueeze * (1. + peripheralSoftness * ramp) * texel;
+	float2 centrePx = compressedUV * targetResolution;
+	float2 loPx = centrePx - footprint * targetResolution * .5;
+	float2 hiPx = centrePx + footprint * targetResolution * .5;
+	int2 basePx = int2(floor(centrePx));
+	float4 colour = 0.; float totalWeight = 0.;
+	[unroll] for (int x = -3; x <= 3; ++x) [unroll] for (int y = -3; y <= 3; ++y) {
+		int2 pixel = basePx + int2(x, y);
+		float2 p0 = float2(pixel); float2 p1 = p0 + 1.;
+		float2 overlap = max(0., min(hiPx, p1) - max(loPx, p0));
+		float weight = overlap.x * overlap.y;
+		float2 sampleUV = (clamp(float2(pixel), 0., targetResolution - 1.) + .5) / targetResolution;
+		colour += weight * compositionTexture.SampleLevel(trilinearSampler, EyeToTextureUV(sampleUV, isRightEye), 0);
+		totalWeight += weight;
+	}
+
+	return colour / max(totalWeight, 1e-6);
 }
