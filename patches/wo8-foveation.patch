diff --git a/alvr/server_openvr/cpp/platform/win32/FFR.cpp b/alvr/server_openvr/cpp/platform/win32/FFR.cpp
index f6dcb9f16f748bd60698408638666d40ec4fd234..9188ea5b8fb0579d6eff54bef152aed1d8aff795 100644
--- a/alvr/server_openvr/cpp/platform/win32/FFR.cpp
+++ b/alvr/server_openvr/cpp/platform/win32/FFR.cpp
@@ -28,13 +28,13 @@ struct FoveationVars {
     float centerShiftRightY;
     float edgeRatioX;
     float edgeRatioY;
+    float peripheralSoftness;
+    float blurOnly;
 
     // D3D11 rejects a constant buffer whose size is not a multiple of 16, and the HLSL cbuffer
     // packs these float2s into four 16-byte registers (64 bytes). Without this the struct is 56
     // bytes, CreateBuffer fails, and the failure surfaces as "Failed to initialize CEncoder" --
     // i.e. no video at all, which looks nothing like a foveation bug.
-    float _padding0;
-    float _padding1;
 };
 
 static_assert(sizeof(FoveationVars) % 16 == 0, "FoveationVars must be 16-byte aligned for D3D11");
@@ -70,8 +70,8 @@ FoveationVars CalculateFoveationVars(
     float centerShiftRightYAligned = ceil(centerShiftRightY * edgeSizeYAligned / (edgeRatioY * 2.))
         * (edgeRatioY * 2.) / edgeSizeYAligned;
 
-    float foveationScaleX = (centerSizeXAligned + (1. - centerSizeXAligned) / edgeRatioX);
-    float foveationScaleY = (centerSizeYAligned + (1. - centerSizeYAligned) / edgeRatioY);
+    float foveationScaleX = Settings::Instance().m_foveationBlurOnly ? 1.f : (centerSizeXAligned + (1. - centerSizeXAligned) / edgeRatioX);
+    float foveationScaleY = Settings::Instance().m_foveationBlurOnly ? 1.f : (centerSizeYAligned + (1. - centerSizeYAligned) / edgeRatioY);
 
     float optimizedEyeWidth = foveationScaleX * targetEyeWidth;
     float optimizedEyeHeight = foveationScaleY * targetEyeHeight;
@@ -97,8 +97,8 @@ FoveationVars CalculateFoveationVars(
              centerShiftRightYAligned,
              edgeRatioX,
              edgeRatioY,
-             0.f,
-             0.f };
+             std::clamp(Settings::Instance().m_foveationPeripheralSoftness, 0.f, 1.f),
+             Settings::Instance().m_foveationBlurOnly ? 1.f : 0.f };
 }
 }
 
