         help = "Moves the full-resolution centre to where the eyes are looking, per eye, using the headset's eye tracking. Off pins it to the middle of the view."
@@ -1906,12 +1932,17 @@ pub fn session_settings_default() -> SettingsDefault {
                 enabled: false,
