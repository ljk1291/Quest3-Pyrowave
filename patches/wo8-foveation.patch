@@ -540,6 +557,15 @@ pub struct FoveatedEncodingConfig {
     #[schema(flag = "steamvr-restart")]
     pub edge_ratio_y: f32,
 
+    #[schema(strings(display_name = "Peripheral softness", help = "Area-prefilters the squeezed peripheral bands. 0 retains anti-alias filtering only; keep the light profile at 0.5 or below until in-headset review."))]
