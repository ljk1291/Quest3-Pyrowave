diff --git "a/alvr/client_openxr/src/layer_filter.rs" "b/alvr/client_openxr/src/layer_filter.rs"
new file mode 100644
index 0000000000000000000000000000000000000000..dd8ac37722ae4b7010d7dcbeb773b1762fd5fcd6
--- /dev/null
+++ "b/alvr/client_openxr/src/layer_filter.rs"
@@ -0,0 +1,125 @@
+//! Pure policy for the Quest-only compositor layer-filter experiment.
+//!
+//! The policy is resolved before creating the OpenXR instance so unsupported
+//! extensions never enter its enabled-extension list. The raw flags are kept
+//! here to make the decision testable without an OpenXR runtime.
+
+pub const PROPERTY: &str = "debug.q3pw.layer_filter";
+
+const NORMAL_SUPER_SAMPLING: u64 = 1 << 0;
+const QUALITY_SUPER_SAMPLING: u64 = 1 << 1;
+const AUTO_LAYER_FILTER: u64 = 1 << 5;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Requested {
+    Off,
+    Normal,
+    Quality,
+    Auto,
+    Invalid,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Decision {
+    Disabled { requested: Requested },
+    Active { requested: Requested, flags: u64, enable_meta: bool },
+    Unsupported { requested: Requested, missing_fb: bool, missing_meta: bool },
+}
+
+impl Decision {
+    pub fn flags(self) -> Option<u64> {
+        match self {
+            Self::Active { flags, .. } => Some(flags),
+            _ => None,
+        }
+    }
+
+    pub fn enables_fb(self) -> bool {
+        matches!(self, Self::Active { .. })
+    }
+
+    pub fn enables_meta(self) -> bool {
+        matches!(self, Self::Active { enable_meta: true, .. })
+    }
+}
+
+pub fn requested_from_property(value: &str) -> Requested {
+    match value.trim() {
+        "" | "0" => Requested::Off,
+        "1" => Requested::Normal,
+        "2" => Requested::Quality,
+        "3" => Requested::Auto,
+        _ => Requested::Invalid,
+    }
+}
+
+pub fn resolve(value: &str, has_fb_settings: bool, has_meta_auto: bool) -> Decision {
+    let requested = requested_from_property(value);
+    match requested {
+        Requested::Off | Requested::Invalid => Decision::Disabled { requested },
+        Requested::Normal | Requested::Quality if !has_fb_settings => Decision::Unsupported {
+            requested,
+            missing_fb: true,
+            missing_meta: false,
+        },
+        Requested::Normal => Decision::Active {
+            requested,
+            flags: NORMAL_SUPER_SAMPLING,
+            enable_meta: false,
+        },
+        Requested::Quality => Decision::Active {
+            requested,
+            flags: QUALITY_SUPER_SAMPLING,
+            enable_meta: false,
+        },
+        Requested::Auto if !has_fb_settings || !has_meta_auto => Decision::Unsupported {
+            requested,
+            missing_fb: !has_fb_settings,
+            missing_meta: !has_meta_auto,
+        },
+        // XR_META_automatic_layer_filter requires a non-auto flag too. Normal is
+        // deliberate: auto is an opt-in low-cost candidate, not an implicit quality mode.
+        Requested::Auto => Decision::Active {
+            requested,
+            flags: NORMAL_SUPER_SAMPLING | AUTO_LAYER_FILTER,
+            enable_meta: true,
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_and_bad_values_never_enable_an_extension() {
+        for value in ["", "0", "-1", "4", "quality"] {
+            let decision = resolve(value, true, true);
+            assert!(!decision.enables_fb(), "{value}");
+            assert_eq!(decision.flags(), None, "{value}");
+        }
+    }
+
+    #[test]
+    fn normal_and_quality_require_only_fb_settings() {
+        assert_eq!(
+            resolve("1", true, false),
+            Decision::Active { requested: Requested::Normal, flags: NORMAL_SUPER_SAMPLING, enable_meta: false }
+        );
+        assert_eq!(
+            resolve("2", true, false),
+            Decision::Active { requested: Requested::Quality, flags: QUALITY_SUPER_SAMPLING, enable_meta: false }
+        );
+        assert!(matches!(resolve("1", false, true), Decision::Unsupported { missing_fb: true, missing_meta: false, .. }));
+    }
+
+    #[test]
+    fn auto_requires_both_extensions_and_never_sets_auto_alone() {
+        assert!(matches!(resolve("3", false, true), Decision::Unsupported { missing_fb: true, .. }));
+        assert!(matches!(resolve("3", true, false), Decision::Unsupported { missing_meta: true, .. }));
+        let active = resolve("3", true, true);
+        assert_eq!(active.flags(), Some(NORMAL_SUPER_SAMPLING | AUTO_LAYER_FILTER));
+        assert!(active.enables_fb());
+        assert!(active.enables_meta());
+    }
+}
