+/// A crop expressed in tangent space, so both the server and the OpenXR projection
+/// layer use the same physical field of view. Values are fractions of the runtime
+/// FOV, not degrees; applying them about zero retains asymmetric eye frusta.
+#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq)]
+pub struct FovTangentMultipliers {
+    pub horizontal: f32,
+    pub vertical: f32,
+}
+
+impl Default for FovTangentMultipliers {
+    fn default() -> Self {
+        Self {
+            horizontal: 1.0,
+            vertical: 1.0,
+        }
+    }
+}
+
+impl FovTangentMultipliers {
+    pub const MIN: f32 = 0.5;
+    pub const MAX: f32 = 1.0;
+
+    pub fn validate(self) -> Result<Self> {
+        if !self.horizontal.is_finite()
+            || !self.vertical.is_finite()
+            || !(Self::MIN..=Self::MAX).contains(&self.horizontal)
+            || !(Self::MIN..=Self::MAX).contains(&self.vertical)
+        {
+            bail!(
+                "FOV tangent multipliers must be finite values in [{}, {}]",
+                Self::MIN,
+                Self::MAX
+            );
+        }
+
+        Ok(self)
+    }
+
+    /// Scale a four-sided OpenXR FOV around the optical axis. Scaling tangents,
+    /// rather than angles, keeps the requested pixel density and eye asymmetry.
+    pub fn scale_fov(self, fov: Fov) -> Fov {
+        // Default-off must be bit-exact. atan(tan(angle)) is close but not
+        // necessarily identical to the runtime-provided floating-point angle.
+        if self == Self::default() {
+            return fov;
+        }
+        let h = self.horizontal;
+        let v = self.vertical;
+        Fov {
+            left: (fov.left.tan() * h).atan(),
+            right: (fov.right.tan() * h).atan(),
+            up: (fov.up.tan() * v).atan(),
+            down: (fov.down.tan() * v).atan(),
+        }
+    }
+
+    /// Scale one eye's source dimensions and pad upward for encoder alignment.
+    /// Padding never reduces the requested FOV crop or source density.
+    pub fn scale_aligned_view_resolution(self, resolution: UVec2, alignment: u32) -> UVec2 {
+        assert!(alignment > 0);
+        let align = |value: f32| (value / alignment as f32).ceil() as u32 * alignment;
+        UVec2::new(
+            align(resolution.x as f32 * self.horizontal).max(alignment),
+            align(resolution.y as f32 * self.vertical).max(alignment),
+        )
+    }
+}
