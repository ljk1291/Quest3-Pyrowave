diff --git a/alvr/common/src/frame_loss.rs b/alvr/common/src/frame_loss.rs
new file mode 100644
index 0000000000000000000000000000000000000000..61969a48c09eaa7ccdc71d4c1f06b98501fe3ec4
--- /dev/null
+++ b/alvr/common/src/frame_loss.rs
@@ -0,0 +1,92 @@
+//! Default-off process-lifetime counters; compare deltas within one process.
+//! No clocks, allocations or locks on the disabled path after the first lookup.
+use crate::parking_lot::Mutex;
+use std::{collections::BTreeMap, sync::OnceLock, time::{Duration, Instant}};
+
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        #[cfg(target_os = "android")]
+        {
+            extern "C" {
+                fn __system_property_get(name: *const std::ffi::c_char, value: *mut std::ffi::c_char) -> i32;
+            }
+            let mut value = [0u8; 92];
+            (unsafe { __system_property_get(c"debug.q3pw.frame_loss".as_ptr(), value.as_mut_ptr().cast()) == 1 })
+                && value[0] == b'1'
+        }
+        #[cfg(not(target_os = "android"))]
+        { std::env::var("ALVR_FRAME_LOSS").ok().as_deref() == Some("1") }
+    })
+}
+
+struct Counters {
+    started: Instant,
+    last_log: Instant,
+    counts: BTreeMap<&'static str, u64>,
+    timestamps: BTreeMap<&'static str, (u64, u64, u64, u64)>, // n, equal, regressed, last ns
+}
+
+impl Counters {
+    fn observe(&mut self, stage: &'static str, ns: u64) {
+        let entry = self.timestamps.entry(stage).or_default();
+        if entry.0 != 0 {
+            entry.1 += u64::from(ns == entry.3);
+            entry.2 += u64::from(ns < entry.3);
+        }
+        entry.0 += 1;
+        entry.3 = ns;
+    }
+}
+
+fn update(f: impl FnOnce(&mut Counters)) {
+    if !enabled() { return; }
+    static COUNTERS: OnceLock<Mutex<Counters>> = OnceLock::new();
+    let mut state = COUNTERS.get_or_init(|| Mutex::new(Counters {
+        started: Instant::now(), last_log: Instant::now(),
+        counts: BTreeMap::new(), timestamps: BTreeMap::new(),
+    })).lock();
+    f(&mut state);
+    if state.last_log.elapsed() < Duration::from_secs(1) { return; }
+    state.last_log = Instant::now();
+    let mut line = format!("[Q3PW_FRAME_LOSS] rust cumulative elapsed_ms={}", state.started.elapsed().as_millis());
+    for (key, value) in &state.counts { line.push_str(&format!(" {key}={value}")); }
+    for (key, (n, equal, regressed, ns)) in &state.timestamps {
+        line.push_str(&format!(" {key}_n={n} {key}_equal={equal} {key}_regressed={regressed} {key}_last_ns={ns}"));
+    }
+    drop(state);
+    #[cfg(target_os = "android")]
+    {
+        // Bypass client log mirroring's Error-only filter.
+        #[link(name = "log")]
+        extern "C" {
+            fn __android_log_write(priority: i32, tag: *const std::ffi::c_char, text: *const std::ffi::c_char) -> i32;
+        }
+        let text = std::ffi::CString::new(line).unwrap();
+        unsafe { __android_log_write(4, c"Q3PW_FRAME_LOSS".as_ptr(), text.as_ptr()); }
+    }
+    #[cfg(not(target_os = "android"))]
+    crate::warn!("{line}");
+}
+
+pub fn count(site: &'static str) {
+    update(|state| *state.counts.entry(site).or_default() += 1);
+}
+
+pub fn timestamp(stage: &'static str, timestamp: Duration) {
+    update(|state| state.observe(stage, timestamp.as_nanos() as u64));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn timestamps_distinguish_repeats_regressions_and_stage_boundaries() {
+        let mut state = Counters { started: Instant::now(), last_log: Instant::now(),
+            counts: BTreeMap::new(), timestamps: BTreeMap::new() };
+        for ns in [20, 20, 10, 30] { state.observe("received", ns); }
+        state.observe("selected", 10);
+        assert_eq!(state.timestamps["received"], (4, 1, 1, 30));
+        assert_eq!(state.timestamps["selected"], (1, 0, 0, 10));
+    }
+}
