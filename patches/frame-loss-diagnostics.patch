diff --git a/alvr/server_openvr/cpp/alvr_server/FrameLoss.h b/alvr/server_openvr/cpp/alvr_server/FrameLoss.h
new file mode 100644
index 0000000000000000000000000000000000000000..3baf71317871c7cb092215a59953b2898a56b435
--- /dev/null
+++ b/alvr/server_openvr/cpp/alvr_server/FrameLoss.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "Logger.h"
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+
+// Separate native and Rust cumulative counters; never subtract across process restarts.
+inline void FrameLoss(const char* site) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("ALVR_FRAME_LOSS");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled) return;
+    static std::mutex mutex;
+    static std::map<std::string, unsigned long long> counters;
+    static const auto started = std::chrono::steady_clock::now();
+    static auto lastLog = started;
+    std::lock_guard<std::mutex> lock(mutex);
+    ++counters[site];
+    const auto now = std::chrono::steady_clock::now();
+    if (now - lastLog < std::chrono::seconds(1)) return;
+    lastLog = now;
+    std::string line = "[Q3PW_FRAME_LOSS] native cumulative elapsed_ms="
+        + std::to_string(std::chrono::duration_cast<std::chrono::milliseconds>(now - started).count());
+    for (const auto& counter : counters)
+        line += " " + counter.first + "=" + std::to_string(counter.second);
+    Warn("%s\n", line.c_str());
+}
