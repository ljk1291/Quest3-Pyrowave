+
+    fn config(profile: FoveationProfile) -> FoveatedEncodingConfig {
+        FoveatedEncodingConfig { force_enable: false, profile,
+            center_size_x: 0.2, center_size_y: 0.178,
+            center_shift_x: 0., center_shift_y: 0.,
+            edge_ratio_x: 3., edge_ratio_y: 4.,
+            peripheral_softness: 0.5, blur_only: false, follow_gaze: false }
+            .resolved_geometry()
+    }
+
+    unsafe fn texture(gl: &glow::Context, width: u32, height: u32, format: u32, data: Option<&[u8]>) -> glow::Texture {
+        gl.bind_buffer(glow::PIXEL_UNPACK_BUFFER,None);
+        let tex=gl.create_texture().unwrap();
+        gl.bind_texture(glow::TEXTURE_2D,Some(tex));
+        gl.tex_parameter_i32(glow::TEXTURE_2D,glow::TEXTURE_MIN_FILTER,glow::LINEAR as i32);
+        gl.tex_parameter_i32(glow::TEXTURE_2D,glow::TEXTURE_MAG_FILTER,glow::LINEAR as i32);
+        gl.tex_image_2d(glow::TEXTURE_2D,0,format as i32,width as i32,height as i32,0,
+            glow::RGBA,glow::UNSIGNED_BYTE,glow::PixelUnpackData::Slice(data));
+        tex
+    }
+
+    #[test]
+    fn software_gles_staging_both_eyes_survive_fixed_profile_inverse_and_gl_state() {
+        assert_eq!(std::env::var("LIBGL_ALWAYS_SOFTWARE").as_deref(),Ok("1"),
+            "run this gate only in the explicitly software-rendered CI environment");
+        struct Diagnostics;
+        impl log::Log for Diagnostics {
+            fn enabled(&self, metadata: &log::Metadata) -> bool {
+                metadata.level() <= log::Level::Info || metadata.target() == "wgpu_hal::gles::egl"
+            }
+            fn log(&self, record: &log::Record) {
+                if self.enabled(record.metadata()) { eprintln!("{} {}",record.target(),record.args()); }
+            }
+            fn flush(&self) {}
+        }
+        static DIAGNOSTICS: Diagnostics=Diagnostics;
+        log::set_logger(&DIAGNOSTICS).unwrap();
+        log::set_max_level(log::LevelFilter::Debug);
+        let context=Rc::new(GraphicsContext::new_gl());
+        let adapter=context.adapter.get_info();
+        assert_eq!(adapter.device_type,wgpu::DeviceType::Cpu,"this gate must use a CPU renderer");
+        eprintln!("software adapter: {adapter:?}");
+        let gl=&context.gl_context;
+        for profile in [FoveationProfile::Light,FoveationProfile::Medium,FoveationProfile::H264Fit] {
+          for format in [glow::RGBA8,glow::SRGB8_ALPHA8] {
+            for isolated in [false,true] {
+                let cfg=config(profile.clone());
+                let expanded=UVec2::new(160,160);
+                let (packed,_) = foveated_encoding_shader_constants(expanded,cfg.clone());
+                let colors=[[192u8,48,32,255],[16u8,144,224,255]];
+                let pixels=(0..packed.y).flat_map(|_| (0..packed.x*2)
+                    .flat_map(|x| colors[usize::from(x>=packed.x)])).collect::<Vec<_>>();
+                unsafe {
+                    context.make_current();
+                    let source=texture(gl,packed.x*2,packed.y,glow::RGBA8,Some(&pixels));
+                    let targets=[texture(gl,160,160,format,None),texture(gl,160,160,format,None)];
+                    gl.finish();
+                    let image=(context.create_image)(context.egl_display.as_ptr(),
+                        context.egl_context.as_ptr(),0x30B1, // EGL_GL_TEXTURE_2D_KHR
+                        source.0.get() as usize as *mut _,ptr::null());
+                    assert!(!image.is_null(),"software EGLImage source creation failed");
+                    let mut renderer=StreamRenderer::new(Rc::clone(&context),expanded,expanded,
+                        [vec![targets[0].0.get()],vec![targets[1].0.get()]],format,
+                        Some(cfg),format==glow::SRGB8_ALPHA8,false,1.0,None);
+                    renderer.set_import_copy_sync(true);
+                    renderer.set_staging_isolation(isolated);
+                    if isolated {
+                        // Poison foreign state to verify the opt-in copy restores
