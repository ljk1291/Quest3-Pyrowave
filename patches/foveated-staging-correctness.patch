+impl FoveatedEncodingConfig {
+    /// Resolve fixed profiles identically on both sides of the stream. Never
+    /// mutate persisted raw Custom fields or silently change a Custom request.
+    pub fn resolved_geometry(&self) -> Self {
+        let mut result = self.clone();
+        let (center, edge) = match self.profile {
+            FoveationProfile::Light => (0.8, 1.5),
+            FoveationProfile::Medium => (0.6, 2.0),
+            FoveationProfile::H264Fit => (0.5, 2.0),
+            FoveationProfile::Custom => return result,
+        };
+        result.center_size_x = center;
+        result.center_size_y = center;
+        result.edge_ratio_x = edge;
+        result.edge_ratio_y = edge;
+        result.center_shift_x = 0.0;
+        result.center_shift_y = 0.0;
+        // These named profiles are fixed-centre; only Custom may follow gaze.
+        result.follow_gaze = false;
+        result
+    }
+}
