+#[cfg(test)]
+mod fixed_profile_geometry_tests {
+    use super::*;
+    fn stale(profile: FoveationProfile) -> FoveatedEncodingConfig {
+        FoveatedEncodingConfig { force_enable: false, profile,
+            center_size_x: 0.2, center_size_y: 0.178,
+            center_shift_x: 0.25, center_shift_y: -0.1,
+            edge_ratio_x: 3.0, edge_ratio_y: 4.0,
+            peripheral_softness: 0.5, blur_only: false, follow_gaze: true }
+    }
+    #[test]
+    fn fixed_profiles_resolve_stale_fields_without_mutating_the_session() {
+        for (profile, center, edge) in [(FoveationProfile::Light,0.8,1.5),
+            (FoveationProfile::Medium,0.6,2.0),(FoveationProfile::H264Fit,0.5,2.0)] {
+            let raw=stale(profile); let resolved=raw.resolved_geometry();
+            assert_eq!((resolved.center_size_x,resolved.center_size_y),(center,center));
+            assert_eq!((resolved.edge_ratio_x,resolved.edge_ratio_y),(edge,edge));
+            assert_eq!((resolved.center_shift_x,resolved.center_shift_y),(0.0,0.0));
+            assert!(!resolved.follow_gaze);
+            assert_eq!(resolved.peripheral_softness,raw.peripheral_softness);
+            assert_eq!(raw.center_size_x,0.2);
+            assert!(raw.follow_gaze);
+        }
+    }
+    #[test]
+    fn custom_asymmetric_geometry_is_preserved_exactly() {
+        let raw=stale(FoveationProfile::Custom);
+        assert!(raw == raw.resolved_geometry());
+    }
