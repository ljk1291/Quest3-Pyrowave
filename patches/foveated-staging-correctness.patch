+// Software GLES test of production staging + production WGSL + projection.
+// EGLImage is created from an owned GL texture; Android AHB import and Qualcomm
+// driver behavior are deliberately not claimed by this test.
+#[cfg(all(test, target_os = "linux"))]
+mod staging_correctness_tests {
+    use super::*;
+    use alvr_common::log;
+    use alvr_session::FoveationProfile;
