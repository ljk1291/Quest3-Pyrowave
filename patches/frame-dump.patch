diff --git a/alvr/graphics/src/frame_dump.rs b/alvr/graphics/src/frame_dump.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7d934d85d7ca737f3ca5f8e5b6fc5384ff1c930e
--- /dev/null
+++ b/alvr/graphics/src/frame_dump.rs
@@ -0,0 +1,486 @@
+//! Lossless SDR diagnostics (`debug.q3pw.frame_dump=count:interval`, docs/FRAME-DUMP.md). Never
+//! changes the decoder's AHB allocation or lease. glReadPixels stalls the render thread on selected
+//! frames only; disk writes, including the CPU unpack of packed YCbCr, run on a bounded worker.
+use super::{frame_dump_config::{self, Config}, GraphicsContext, GL_TEXTURE_EXTERNAL_OES};
+use alvr_common::glam::UVec2;
+use glow::{self as gl, HasContext};
+use std::{ffi::c_void, fs, num::NonZeroU32, path::{Path, PathBuf}, rc::Rc,
+    sync::mpsc::{self, SyncSender}, thread::{self, JoinHandle}, time::{Instant, SystemTime, UNIX_EPOCH}};
+
+/// PyroWave's packed-YCbCr decoder outputs (resources/present_ycbcr.glsl): mode 5 stores one
+/// chroma pixel per texel, mode 6 two.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Packing { Mode5, Mode6 }
+
+impl Packing {
+    fn name(self) -> &'static str {
+        match self { Packing::Mode5 => "mode5", Packing::Mode6 => "mode6" }
+    }
+}
+
+struct Image {
+    stage: &'static str,
+    size: UVec2,
+    pixels: Vec<u8>,
+    row_order: &'static str,
+    /// A packed decoder buffer: its layout and the decoded frame (both eyes) it holds.
+    packed: Option<(Packing, UVec2)>,
+}
+struct Job { timestamp: u64, index: u64, images: Vec<Image> }
+
+pub(super) struct FrameDump {
+    config: Config,
+    seen: u64,
+    attempted: u32,
+    last_timestamp: Option<u64>,
+    last_layout: Option<Option<Packing>>,
+    pending: Option<Job>,
+    sender: Option<SyncSender<Job>>,
+    writer: Option<JoinHandle<()>>,
+}
+
+fn marker(text: String) { super::log_quest_experiment(format!("[Q3PW_FRAME_DUMP] {text}")); }
+
+/// The app's external files directory. The fork and upstream builds have different application
+/// ids; the main process is named after its package.
+fn dump_root() -> PathBuf {
+    let package = fs::read("/proc/self/cmdline").ok()
+        .and_then(|bytes| bytes.split(|b| *b == 0).next().map(|name| String::from_utf8_lossy(name).into_owned()))
+        .filter(|name| !name.is_empty() && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'_'))
+        .unwrap_or_else(|| "io.github.ljk1291.quest3pyrowave".into());
+    PathBuf::from("/sdcard/Android/data").join(package).join("files/q3pw-dumps")
+}
+
+/// Which decoder buffer this is, from its extent and the decoded size per eye; the same choice
+/// direct_eye::present_ycbcr_layout makes for the eye shader. None is a full-size RGBA frame.
+fn decoded_layout(extent: UVec2, eye: UVec2) -> Option<Packing> {
+    if eye.y == 0 || extent.y * 2 != eye.y { return None; }
+    if extent.x == 2 * eye.x { Some(Packing::Mode5) }
+    else if extent.x == 2 * eye.x / 4 * 3 { Some(Packing::Mode6) }
+    else { None }
+}
+
+/// Rearranges a packed buffer (`texels` wide, frame.y/2 high, rows in buffer order) into yuv420p:
+/// Y (frame.x x frame.y), then Cb and Cr (frame.x/2 x frame.y/2). Luma texel (x, y) holds the 2x2
+/// pixels (2x, 2y) (2x+1, 2y) (2x, 2y+1) (2x+1, 2y+1) in R, G, B, A. Chroma starts at texel
+/// x = frame.x/2: mode 5 has (Cb, Cr) of one pixel in RG, mode 6 two adjacent pixels in RG and BA.
+/// Every byte the eye shader can sample is kept; mode 5's unused chroma B and A are not.
+pub(super) fn unpack_packed_ycbcr420(raw: &[u8], texels: UVec2, frame: UVec2, packing: Packing) -> Result<Vec<u8>, String> {
+    let (w, h) = (frame.x as usize, frame.y as usize);
+    let (tw, th) = (texels.x as usize, texels.y as usize);
+    if w == 0 || h == 0 || w % 4 != 0 || h % 4 != 0 { return Err("frame not a multiple of 4".into()); }
+    let chroma_texels = match packing { Packing::Mode5 => w / 2, Packing::Mode6 => w / 4 };
+    if tw != w / 2 + chroma_texels || th * 2 != h || raw.len() != tw * th * 4 {
+        return Err("packed extent mismatch".into());
+    }
+    let (cw, ch) = (w / 2, h / 2);
+    let mut out = Vec::new();
+    out.try_reserve_exact(w * h + 2 * cw * ch).map_err(|_| "unpack allocation failed".to_owned())?;
+    out.resize(w * h + 2 * cw * ch, 0);
+    let (luma, chroma) = out.split_at_mut(w * h);
+    let (cb, cr) = chroma.split_at_mut(cw * ch);
+    for (r, row) in raw.chunks_exact(tw * 4).enumerate() {
+        for (x, quad) in row[..w / 2 * 4].chunks_exact(4).enumerate() {
+            luma[2 * r * w + 2 * x] = quad[0];
+            luma[2 * r * w + 2 * x + 1] = quad[1];
+            luma[(2 * r + 1) * w + 2 * x] = quad[2];
+            luma[(2 * r + 1) * w + 2 * x + 1] = quad[3];
+        }
+        let pixels = &row[w / 2 * 4..];
+        for c in 0..cw {
+            let at = match packing { Packing::Mode5 => c * 4, Packing::Mode6 => c / 2 * 4 + (c & 1) * 2 };
+            cb[r * cw + c] = pixels[at];
+            cr[r * cw + c] = pixels[at + 1];
+        }
+    }
+    Ok(out)
+}
+
+fn write_record(directory: &Path, timestamp: u64, index: u64, stage: &str, size: UVec2, format: &str,
+                row_order: &str, extra: &str, bytes: &[u8]) {
+    let base = directory.join(format!("{timestamp}-{stage}"));
+    let result = (|| -> std::io::Result<()> {
+        fs::write(base.with_extension("raw"), bytes)?;
+        // Only a complete sidecar admits this frame to the scorer.
+        fs::write(base.with_extension("json"), format!(
+            "{{\"schema\":1,\"timestamp_ns\":{timestamp},\"frame_index\":{index},\"stage\":\"{stage}\",\"width\":{},\"height\":{},\"format\":\"{format}\",\"range\":\"full\",\"matrix\":\"bt709\",\"row_order\":\"{row_order}\",\"bytes\":{}{extra},\"complete\":true}}\n",
+            size.x, size.y, bytes.len()))?;
+        Ok(())
+    })();
+    marker(format!("timestamp_ns={timestamp} stage={stage} write={result:?}"));
+}
+
+fn write_image(directory: &Path, timestamp: u64, index: u64, image: Image) {
+    let Some((packing, frame)) = image.packed else {
+        write_record(directory, timestamp, index, image.stage, image.size, "rgba8", image.row_order, "", &image.pixels);
+        return;
+    };
+    // The exact buffer the eye shader samples, then the same bytes as the planes a scorer reads.
+    let extra = format!(",\"packing\":\"{}\",\"frame_width\":{},\"frame_height\":{}", packing.name(), frame.x, frame.y);
+    write_record(directory, timestamp, index, "post_decode_packed", image.size, "q3pw_ycbcr420_packed",
+        image.row_order, &extra, &image.pixels);
+    match unpack_packed_ycbcr420(&image.pixels, image.size, frame, packing) {
+        Ok(planes) => write_record(directory, timestamp, index, image.stage, frame, "yuv420p", image.row_order,
+            ",\"source\":\"post_decode_packed\"", &planes),
+        Err(reason) => marker(format!("timestamp_ns={timestamp} stage={} unpack_failed={reason}", image.stage)),
+    }
+}
+
+impl FrameDump {
+    pub fn new(value: &str) -> Option<Self> {
+        let config = match frame_dump_config::parse(value) {
+            Ok(Some(config)) => config,
+            Ok(None) => return None,
+            Err(reason) => { marker(format!("disabled reason={reason}")); return None; }
+        };
+        // No private identifiers in file names.
+        let directory = dump_root()
+            .join(format!("client-{}", SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()));
+        if let Err(e) = fs::create_dir_all(&directory) {
+            marker(format!("disabled setup_failed={e}")); return None;
+        }
+        let (sender, receiver) = mpsc::sync_channel::<Job>(1);
+        let writer = match thread::Builder::new().name("q3pw-dump".into()).spawn(move || {
+            while let Ok(job) = receiver.recv() {
+                for image in job.images {
+                    write_image(&directory, job.timestamp, job.index, image);
+                }
+            }
+        }) {
+            Ok(writer) => writer,
+            Err(e) => { marker(format!("disabled worker_failed={e}")); return None; }
+        };
+        marker(format!("enabled count={} interval={} synchronous_gpu_readback=1 async_disk=1",
+            config.count, config.interval));
+        Some(Self { config, seen: 0, attempted: 0, last_timestamp: None, last_layout: None, pending: None,
+            sender: Some(sender), writer: Some(writer) })
+    }
+
+    /// `eye` is the decoded size per eye (smaller than the view with light foveation).
+    pub unsafe fn begin(&mut self, context: &Rc<GraphicsContext>, source: *mut c_void,
+        timestamp: u64, eye: UVec2) {
+        self.pending = None;
+        if source.is_null() || self.last_timestamp == Some(timestamp) { return; }
+        self.last_timestamp = Some(timestamp);
+        let index = self.seen;
+        self.seen += 1;
+        if self.attempted >= self.config.count || index % u64::from(self.config.interval) != 0 { return; }
+        self.attempted += 1;
+        context.make_current();
+        let start = Instant::now();
+        // Read the buffer at its own extent, texel for texel. A packed-YCbCr buffer (PyroWave modes
+        // 5 and 6) is half the frame's height and the eye shader converts it, so its bytes are kept
+        // as they are and unpacked on the writer thread. Read BEFORE the production renderer
+        // imports it (the legacy EGL import need not preserve contents).
+        let frame = UVec2::new(2 * eye.x, eye.y);
+        let extent = super::direct_eye::hardware_buffer_extent(source).unwrap_or(frame);
+        let packing = decoded_layout(extent, eye);
+        if self.last_layout != Some(packing) {
+            self.last_layout = Some(packing);
+            marker(format!("decoded_layout={} buffer={}x{} frame={}x{}",
+                packing.map_or("rgba8", Packing::name), extent.x, extent.y, frame.x, frame.y));
+        }
+        let mut images = vec![];
+        match read_decoded(context, source, extent, None) {
+            Ok(mut image) => {
+                image.packed = packing.map(|packing| (packing, frame));
+                images.push(image);
+            }
+            Err(reason) => marker(format!("timestamp_ns={timestamp} readback_failed={reason}")),
+        }
+        self.pending = Some(Job { timestamp, index, images });
+        marker(format!("timestamp_ns={timestamp} phase=decode client_stall_ms={:.3}", start.elapsed().as_secs_f64() * 1000.0));
+    }
+
+    pub unsafe fn finish(&mut self, context: &Rc<GraphicsContext>, presented: UVec2, textures: [u32; 2]) {
+        let Some(mut job) = self.pending.take() else { return; };
+        context.make_current();
+        let start = Instant::now();
+        match read_presented(context, presented, textures) {
+            Ok(images) => job.images.extend(images),
+            Err(reason) => marker(format!("timestamp_ns={} presented_readback_failed={reason}", job.timestamp)),
+        }
+        marker(format!("timestamp_ns={} phase=presented client_stall_ms={:.3}", job.timestamp, start.elapsed().as_secs_f64() * 1000.0));
+        if let Some(sender) = &self.sender {
+            let timestamp = job.timestamp;
+            if sender.try_send(job).is_err() {
+                marker(format!("timestamp_ns={timestamp} dropped=writer_busy"));
+            }
+        }
+    }
+}
+
+impl Drop for FrameDump {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(writer) = self.writer.take() { let _ = writer.join(); }
+    }
+}
+
+// Raw GLES shares WGPU's context. Restore every state changed here, including unit-0
+// bindings and pixel-pack state; merely binding FBO 0 would corrupt WGPU's cached state.
+struct State<'a> {
+    gl: &'a gl::Context, program: i32, vao: i32, draw: i32, read: i32,
+    active: i32, external: i32, texture: i32, sampler: i32, pack_buffer: i32,
+    viewport: [i32; 4], mask: [i32; 4], pack: [i32; 4], caps: Vec<(u32, bool)>,
+}
+fn name(n: i32) -> Option<NonZeroU32> { NonZeroU32::new(n as u32) }
+impl<'a> State<'a> {
+    unsafe fn save(gl: &'a gl::Context) -> Self {
+        let active = gl.get_parameter_i32(gl::ACTIVE_TEXTURE);
+        gl.active_texture(gl::TEXTURE0);
+        let mut viewport = [0; 4]; gl.get_parameter_i32_slice(gl::VIEWPORT, &mut viewport);
+        let mut mask = [0; 4]; gl.get_parameter_i32_slice(gl::COLOR_WRITEMASK, &mut mask);
+        let mut caps: Vec<_> = [gl::BLEND, gl::DEPTH_TEST, gl::STENCIL_TEST, gl::SCISSOR_TEST,
+            gl::CULL_FACE, gl::DITHER, gl::RASTERIZER_DISCARD, gl::SAMPLE_ALPHA_TO_COVERAGE,
+            gl::SAMPLE_COVERAGE].iter().map(|&cap| (cap, gl.is_enabled(cap))).collect();
+        if gl.supported_extensions().contains("GL_EXT_sRGB_write_control") { caps.push((0x8DB9, gl.is_enabled(0x8DB9))); }
+        let state = Self { gl, active, caps, viewport, mask,
+            program: gl.get_parameter_i32(gl::CURRENT_PROGRAM), vao: gl.get_parameter_i32(gl::VERTEX_ARRAY_BINDING),
+            draw: gl.get_parameter_i32(gl::DRAW_FRAMEBUFFER_BINDING), read: gl.get_parameter_i32(gl::READ_FRAMEBUFFER_BINDING),
+            external: gl.get_parameter_i32(0x8D67), texture: gl.get_parameter_i32(gl::TEXTURE_BINDING_2D),
+            sampler: gl.get_parameter_i32(gl::SAMPLER_BINDING), pack_buffer: gl.get_parameter_i32(gl::PIXEL_PACK_BUFFER_BINDING),
+            pack: [gl::PACK_ALIGNMENT, gl::PACK_ROW_LENGTH, gl::PACK_SKIP_ROWS, gl::PACK_SKIP_PIXELS].map(|p| gl.get_parameter_i32(p)) };
+        gl.active_texture(active as u32);
+        state
+    }
+}
+impl Drop for State<'_> {
+    fn drop(&mut self) { unsafe {
+        let gl = self.gl;
+        gl.use_program(name(self.program).map(gl::NativeProgram));
+        gl.bind_vertex_array(name(self.vao).map(gl::NativeVertexArray));
+        gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, name(self.draw).map(gl::NativeFramebuffer));
+        gl.bind_framebuffer(gl::READ_FRAMEBUFFER, name(self.read).map(gl::NativeFramebuffer));
+        gl.active_texture(gl::TEXTURE0);
+        gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, name(self.external).map(gl::NativeTexture));
+        gl.bind_texture(gl::TEXTURE_2D, name(self.texture).map(gl::NativeTexture));
+        gl.bind_sampler(0, name(self.sampler).map(gl::NativeSampler));
+        gl.active_texture(self.active as u32);
+        gl.bind_buffer(gl::PIXEL_PACK_BUFFER, name(self.pack_buffer).map(gl::NativeBuffer));
+        for (p, v) in [gl::PACK_ALIGNMENT, gl::PACK_ROW_LENGTH, gl::PACK_SKIP_ROWS, gl::PACK_SKIP_PIXELS].into_iter().zip(self.pack) { gl.pixel_store_i32(p, v); }
+        gl.viewport(self.viewport[0], self.viewport[1], self.viewport[2], self.viewport[3]);
+        gl.color_mask(self.mask[0] != 0, self.mask[1] != 0, self.mask[2] != 0, self.mask[3] != 0);
+        for &(cap, enabled) in &self.caps { if enabled { gl.enable(cap); } else { gl.disable(cap); } }
+    } }
+}
+
+struct Objects<'a> {
+    context: &'a GraphicsContext, textures: Vec<gl::Texture>, shaders: Vec<gl::Shader>,
+    program: Option<gl::Program>, vao: Option<gl::VertexArray>, fbo: Option<gl::Framebuffer>,
+    image: super::egl::EGLImage, owns_image: bool,
+}
+impl Drop for Objects<'_> {
+    fn drop(&mut self) { unsafe {
+        let gl = &self.context.gl_context;
+        // Complete all sampling before deleting the EGL sibling or releasing the AHB lease.
+        gl.finish();
+        for &texture in &self.textures { gl.delete_texture(texture); }
+        for &shader in &self.shaders { gl.delete_shader(shader); }
+        if let Some(program) = self.program { gl.delete_program(program); }
+        if let Some(vao) = self.vao { gl.delete_vertex_array(vao); }
+        if let Some(fbo) = self.fbo { gl.delete_framebuffer(fbo); }
+        if self.owns_image && !self.image.is_null() { (self.context.destroy_image)(self.context.egl_display.as_ptr(), self.image); }
+        // A diagnostic GL allocation/import error must not poison the renderer's
+        // next ck! call. Bound the drain even if the context has been lost.
+        for _ in 0..8 {
+            let error = gl.get_error();
+            if error == gl::NO_ERROR { break; }
+            marker(format!("readback_cleanup_gl_error={error:#x}"));
+        }
+    } }
+}
+
+unsafe fn read_pixels(gl: &gl::Context, size: UVec2) -> Result<Vec<u8>, String> {
+    if size.x == 0 || size.y == 0 || u64::from(size.x) * u64::from(size.y) * 4 > 256 * 1024 * 1024 { return Err("invalid extent".into()); }
+    if gl.check_framebuffer_status(gl::FRAMEBUFFER) != gl::FRAMEBUFFER_COMPLETE { return Err("incomplete framebuffer".into()); }
+    gl.bind_buffer(gl::PIXEL_PACK_BUFFER, None);
+    for (p, value) in [(gl::PACK_ALIGNMENT, 1), (gl::PACK_ROW_LENGTH, 0), (gl::PACK_SKIP_ROWS, 0), (gl::PACK_SKIP_PIXELS, 0)] { gl.pixel_store_i32(p, value); }
+    let length = size.x as usize * size.y as usize * 4;
+    let mut pixels = Vec::new();
+    pixels.try_reserve_exact(length).map_err(|_| "readback allocation failed".to_owned())?;
+    pixels.resize(length, 0);
+    gl.read_pixels(0, 0, size.x as i32, size.y as i32, gl::RGBA, gl::UNSIGNED_BYTE, gl::PixelPackData::Slice(Some(&mut pixels)));
+    let error = gl.get_error();
+    if error != gl::NO_ERROR { return Err(format!("GLES readback error {error:#x}")); }
+    Ok(pixels)
+}
+
+/// Samples the external image at its texel centres into an RGBA8 target of `extent`, with nearest
+/// filtering and no range, gamma, FFE or YCbCr conversion: the buffer's own bytes. Rows are in
+/// buffer order (texture v = 0 first).
+unsafe fn read_decoded(context: &GraphicsContext, source: *mut c_void,
+    extent: UVec2, test_image: Option<super::egl::EGLImage>) -> Result<Image, String> {
+    let gl = &context.gl_context;
+    if !gl.supported_extensions().contains("GL_OES_EGL_image_external_essl3") { return Err("missing external-image ESSL3".into()); }
+    if extent.x == 0 || extent.y == 0 || u64::from(extent.x) * u64::from(extent.y) * 4 > 256 * 1024 * 1024 { return Err("decoded extent too large".into()); }
+    let _state = State::save(gl);
+    gl.active_texture(gl::TEXTURE0);
+    let mut objects = Objects { context, textures: vec![], shaders: vec![], program: None,
+        vao: None, fbo: None, image: std::ptr::null_mut(), owns_image: test_image.is_none() };
+    let program = gl.create_program()?; objects.program = Some(program);
+    for (kind, code) in [(gl::VERTEX_SHADER, include_str!("../resources/frame_dump_vertex.glsl")),
+        (gl::FRAGMENT_SHADER, include_str!("../resources/frame_dump_fragment.glsl"))] {
+        let shader = gl.create_shader(kind)?; objects.shaders.push(shader);
+        gl.shader_source(shader, code); gl.compile_shader(shader);
+        if !gl.get_shader_compile_status(shader) { return Err(gl.get_shader_info_log(shader)); }
+        gl.attach_shader(program, shader);
+    }
+    gl.link_program(program);
+    if !gl.get_program_link_status(program) { return Err(gl.get_program_info_log(program)); }
+    let vao = gl.create_vertex_array()?; objects.vao = Some(vao); gl.bind_vertex_array(Some(vao));
+    let fbo = gl.create_framebuffer()?; objects.fbo = Some(fbo); gl.bind_framebuffer(gl::FRAMEBUFFER, Some(fbo));
+    let target = gl.create_texture()?; objects.textures.push(target);
+    gl.bind_texture(gl::TEXTURE_2D, Some(target));
+    gl.tex_storage_2d(gl::TEXTURE_2D, 1, gl::RGBA8, extent.x as i32, extent.y as i32);
+    gl.framebuffer_texture_2d(gl::FRAMEBUFFER, gl::COLOR_ATTACHMENT0, gl::TEXTURE_2D, Some(target), 0);
+    let external = gl.create_texture()?; objects.textures.push(external);
+    objects.image = if let Some(image) = test_image { image } else {
+        let native = (context.get_native_client_buffer)(source);
+        if native.is_null() { return Err("missing native client buffer".into()); }
+        let attributes = [0x30D2, 1, super::egl::NONE]; // EGL_IMAGE_PRESERVED_KHR
+        (context.create_image)(context.egl_display.as_ptr(), super::egl::NO_CONTEXT,
+            0x3140, native, attributes.as_ptr())
+    };
+    if objects.image.is_null() { return Err("preserved EGL import failed".into()); }
+    gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, Some(external));
+    (context.image_target_texture_2d)(GL_TEXTURE_EXTERNAL_OES, objects.image);
+    gl.bind_sampler(0, None);
+    for (p, v) in [(gl::TEXTURE_MIN_FILTER, gl::NEAREST), (gl::TEXTURE_MAG_FILTER, gl::NEAREST),
+        (gl::TEXTURE_WRAP_S, gl::CLAMP_TO_EDGE), (gl::TEXTURE_WRAP_T, gl::CLAMP_TO_EDGE)] { gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, p, v as i32); }
+    for &(cap, _) in &_state.caps { gl.disable(cap); }
+    gl.color_mask(true, true, true, true);
+    gl.viewport(0, 0, extent.x as i32, extent.y as i32);
+    gl.use_program(Some(program));
+    gl.uniform_1_i32(gl.get_uniform_location(program, "tex").as_ref(), 0);
+    gl.draw_arrays(gl::TRIANGLES, 0, 3);
+    Ok(Image { stage: "post_decode", size: extent, pixels: read_pixels(gl, extent)?, row_order: "top_down", packed: None })
+}
+
+unsafe fn read_presented(context: &GraphicsContext, size: UVec2, textures: [u32; 2]) -> Result<Vec<Image>, String> {
+    let gl = &context.gl_context;
+    let _state = State::save(gl);
+    let mut objects = Objects { context, textures: vec![], shaders: vec![], program: None,
+        vao: None, fbo: None, image: std::ptr::null_mut(), owns_image: false };
+    let fbo = gl.create_framebuffer()?; objects.fbo = Some(fbo);
+    gl.bind_framebuffer(gl::FRAMEBUFFER, Some(fbo));
+    let mut images = vec![];
+    // Raw swapchain rows are bottom-up. Scorer flips these into presented top-down coordinates.
+    for (stage, texture) in ["presented_left", "presented_right"].into_iter().zip(textures) {
+        let texture = name(texture as i32).ok_or("missing swapchain texture")?;
+        gl.framebuffer_texture_2d(gl::FRAMEBUFFER, gl::COLOR_ATTACHMENT0, gl::TEXTURE_2D, Some(gl::NativeTexture(texture)), 0);
+        images.push(Image { stage, size, pixels: read_pixels(gl, size)?, row_order: "bottom_up", packed: None });
+    }
+    Ok(images)
+}
+
+#[cfg(test)]
+mod packed_tests {
+    use super::*;
+
+    // Packs planes the way present_ycbcr.glsl reads them; unused bytes hold a marker.
+    fn pack(y: &[u8], cb: &[u8], cr: &[u8], frame: UVec2, packing: Packing) -> (Vec<u8>, UVec2) {
+        let (w, h) = (frame.x as usize, frame.y as usize);
+        let tw = w / 2 + if packing == Packing::Mode5 { w / 2 } else { w / 4 };
+        let mut raw = vec![0xEE; tw * h / 2 * 4];
+        for py in 0..h {
+            for px in 0..w {
+                raw[((py / 2) * tw + px / 2) * 4 + ((px & 1) | ((py & 1) << 1))] = y[py * w + px];
+            }
+        }
+        for cy in 0..h / 2 {
+            for cx in 0..w / 2 {
+                let (texel, channel) = if packing == Packing::Mode5 { (cx, 0) } else { (cx / 2, (cx & 1) * 2) };
+                let at = (cy * tw + w / 2 + texel) * 4 + channel;
+                raw[at] = cb[cy * (w / 2) + cx];
+                raw[at + 1] = cr[cy * (w / 2) + cx];
+            }
+        }
+        (raw, UVec2::new(tw as u32, (h / 2) as u32))
+    }
+
+    #[test]
+    fn packed_buffers_unpack_to_the_exact_planes() {
+        let frame = UVec2::new(16, 8);
+        let eye = UVec2::new(8, 8);
+        let y: Vec<u8> = (0..16 * 8).map(|i: usize| (i * 7 + 3) as u8).collect();
+        let cb: Vec<u8> = (0..8 * 4).map(|i: usize| (i * 11 + 100) as u8).collect();
+        let cr: Vec<u8> = (0..8 * 4).map(|i: usize| (i * 13 + 50) as u8).collect();
+        for packing in [Packing::Mode5, Packing::Mode6] {
+            let (raw, texels) = pack(&y, &cb, &cr, frame, packing);
+            assert_eq!(decoded_layout(texels, eye), Some(packing));
+            let planes = unpack_packed_ycbcr420(&raw, texels, frame, packing).unwrap();
+            assert_eq!(planes, [y.clone(), cb.clone(), cr.clone()].concat());
+            assert!(unpack_packed_ycbcr420(&raw[4..], texels, frame, packing).is_err());
+            assert!(unpack_packed_ycbcr420(&raw, texels, UVec2::new(18, 8), packing).is_err());
+        }
+        assert_eq!(decoded_layout(frame, eye), None, "a full-size RGBA frame");
+        assert_eq!(decoded_layout(UVec2::new(16, 4), UVec2::ZERO), None);
+    }
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod frame_dump_gles_tests {
+    use super::*;
+
+    #[test]
+    fn external_decode_and_eye_readback_are_exact_and_restore_gl_state() {
+        assert_eq!(std::env::var("LIBGL_ALWAYS_SOFTWARE").as_deref(), Ok("1"));
+        let context = GraphicsContext::new_gl();
+        assert_eq!(context.adapter.get_info().device_type, wgpu::DeviceType::Cpu);
+        context.make_current();
+        let gl = &context.gl_context;
+        unsafe {
+            let width = 64;
+            let height = 32;
+            let pixels: Vec<u8> = (0..width*height).flat_map(|i|
+                [((i % width)*3) as u8, ((i/width)*7) as u8, 80, 255]).collect();
+            let texture = gl.create_texture().unwrap();
+            gl.bind_texture(gl::TEXTURE_2D, Some(texture));
+            gl.tex_storage_2d(gl::TEXTURE_2D, 1, gl::RGBA8, width, height);
+            gl.tex_sub_image_2d(gl::TEXTURE_2D, 0, 0, 0, width, height, gl::RGBA,
+                gl::UNSIGNED_BYTE, gl::PixelUnpackData::Slice(Some(&pixels)));
+            let attrs = [0x30D2, 1, super::super::egl::NONE];
+            let image = (context.create_image)(context.egl_display.as_ptr(), context.egl_context.as_ptr(),
+                0x30B1, texture.0.get() as usize as *mut c_void, attrs.as_ptr());
+            assert!(!image.is_null());
+            let fbo = gl.create_framebuffer().unwrap();
+            gl.bind_framebuffer(gl::FRAMEBUFFER, Some(fbo));
+            gl.framebuffer_texture_2d(gl::FRAMEBUFFER, gl::COLOR_ATTACHMENT0, gl::TEXTURE_2D, Some(texture), 0);
+            let vao = gl.create_vertex_array().unwrap();
+            gl.bind_vertex_array(Some(vao));
+            gl.viewport(2, 3, 13, 17);
+            gl.color_mask(false, true, false, true);
+            gl.enable(gl::SCISSOR_TEST);
+            gl.enable(gl::BLEND);
+            gl.pixel_store_i32(gl::PACK_ALIGNMENT, 8);
+            gl.pixel_store_i32(gl::PACK_ROW_LENGTH, 100);
+            gl.pixel_store_i32(gl::PACK_SKIP_ROWS, 2);
+            gl.pixel_store_i32(gl::PACK_SKIP_PIXELS, 3);
+            gl.active_texture(gl::TEXTURE3);
+            let before = State::save(gl);
+            let decoded = read_decoded(&context, std::ptr::null_mut(), UVec2::new(64, 32), Some(image)).unwrap();
+            let mut images = read_presented(&context, UVec2::new(64, 32), [texture.0.get(); 2]).unwrap();
+            images.push(decoded);
+            assert_eq!(images.len(), 3);
+            assert_eq!(images[2].stage, "post_decode");
+            assert!(images[2].packed.is_none());
+            assert_eq!(images[2].pixels, pixels);
+            assert_eq!(images[0].pixels, pixels);
+            let after = State::save(gl);
+            assert_eq!(after.viewport, before.viewport);
+            assert_eq!(after.mask, before.mask);
+            assert_eq!(after.pack, before.pack);
+            assert_eq!(after.caps, before.caps);
+            assert_eq!((after.active, after.vao, after.draw, after.read, after.program,
+                after.texture, after.external, after.sampler, after.pack_buffer),
+                (before.active, before.vao, before.draw, before.read, before.program,
+                before.texture, before.external, before.sampler, before.pack_buffer));
+            drop(after); drop(before);
+            (context.destroy_image)(context.egl_display.as_ptr(), image);
+            gl.bind_framebuffer(gl::FRAMEBUFFER, None);
+            gl.bind_vertex_array(None);
+            gl.delete_framebuffer(fbo); gl.delete_vertex_array(vao); gl.delete_texture(texture);
+        }
+    }
+}
