+#pragma once
+#include <cstdint>
+#include <string>
+
+namespace q3pw {
+struct FrameDumpConfig {
+    std::string directory;
+    uint32_t count = 0, interval = 0;
+};
+
+inline bool DumpNumber(const std::string& text, uint32_t maximum, uint32_t& value) {
+    if (text.empty()) return false;
+    uint64_t n = 0;
+    for (char c : text) {
+        if (c < '0' || c > '9') return false;
+        n = n * 10 + unsigned(c - '0');
+        if (n > maximum) return false;
+    }
+    if (!n) return false;
+    value = uint32_t(n);
+    return true;
+}
+
+// Split from the RIGHT: a Windows drive letter and directory colons are not delimiters.
+inline bool ParseFrameDump(const std::string& text, FrameDumpConfig& out) {
+    const auto last = text.rfind(':');
+    if (last == std::string::npos || last == 0) return false;
+    const auto previous = text.rfind(':', last - 1);
+    if (previous == std::string::npos || previous == 0) return false;
+    FrameDumpConfig parsed;
+    parsed.directory = text.substr(0, previous);
+    if (!DumpNumber(text.substr(previous + 1, last - previous - 1), 128, parsed.count)
+        || !DumpNumber(text.substr(last + 1), 9000, parsed.interval)) return false;
+    out = parsed;
+    return true;
+}
+} // namespace q3pw
