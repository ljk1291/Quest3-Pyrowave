+/// A hardware buffer's width and height (frame dumps read it texel for texel); None off Android.
+pub(super) fn hardware_buffer_extent(buffer: *const c_void) -> Option<UVec2> {
+    #[cfg(target_os = "android")]
+    {
+        if buffer.is_null() { return None; }
+        let mut desc = AHardwareBufferDesc::default();
+        unsafe { AHardwareBuffer_describe(buffer, &mut desc) };
+        Some(UVec2::new(desc.width, desc.height))
+    }
+    #[cfg(not(target_os = "android"))]
+    { let _ = buffer; None }
+}
