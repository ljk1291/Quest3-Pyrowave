diff --git a/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDump.h b/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDump.h
new file mode 100644
index 0000000000000000000000000000000000000000..5490787d07a97dbfdd59c840a910a31243209d7a
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDump.h
@@ -0,0 +1,182 @@
+#pragma once
+#include "Q3PWFrameDumpConfig.h"
+#include "alvr_server/Logger.h"
+#include "alvr_server/Settings.h"
+#include "shared/d3drender.h"
+#include <wrl.h>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+namespace q3pw {
+// Diagnostic only: synchronous GPU readback, bounded asynchronous disk writer.
+// The immediate context is touched only by CEncoder::Run, while its input is stable.
+class FrameDump {
+    struct Job {
+        uint64_t timestamp, index;
+        uint32_t width, height;
+        std::string format, range;
+        std::vector<uint8_t> pixels;
+    };
+    FrameDumpConfig config;
+    std::shared_ptr<CD3DRender> render;
+    std::filesystem::path directory;
+    uint64_t seen = 0;
+    uint32_t attempted = 0;
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::deque<Job> queue;
+    bool stopping = false;
+    std::thread writer;
+
+    static void ReadPlane(CD3DRender& render, ID3D11Texture2D* source,
+                          unsigned bytesPerPixel, std::vector<uint8_t>& pixels) {
+        if (!source) throw std::runtime_error("missing encoder input plane");
+        D3D11_TEXTURE2D_DESC desc;
+        source->GetDesc(&desc);
+        if (desc.SampleDesc.Count != 1 || desc.ArraySize != 1 || desc.MipLevels != 1
+            || uint64_t(desc.Width) * desc.Height * bytesPerPixel > 256ull * 1024 * 1024)
+            throw std::runtime_error("unsupported input extent");
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = desc.MiscFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        Microsoft::WRL::ComPtr<ID3D11Texture2D> staging;
+        if (FAILED(render.GetDevice()->CreateTexture2D(&desc, nullptr, &staging)))
+            throw std::runtime_error("CreateTexture2D failed");
+        auto* context = render.GetContext();
+        context->CopyResource(staging.Get(), source);
+        D3D11_MAPPED_SUBRESOURCE mapped;
+        if (FAILED(context->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)))
+            throw std::runtime_error("Map failed");
+        const auto stride = size_t(desc.Width) * bytesPerPixel;
+        // Always unmap if vector growth fails.
+        try {
+            const auto offset = pixels.size();
+            pixels.resize(offset + stride * desc.Height);
+            for (unsigned row = 0; row < desc.Height; ++row)
+                memcpy(pixels.data() + offset + row * stride,
+                       static_cast<const uint8_t*>(mapped.pData) + row * mapped.RowPitch, stride);
+        } catch (...) { context->Unmap(staging.Get(), 0); throw; }
+        context->Unmap(staging.Get(), 0);
+    }
+
+    void Write() {
+        for (;;) {
+            Job job;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                wake.wait(lock, [this] { return stopping || !queue.empty(); });
+                if (queue.empty()) return;
+                job = std::move(queue.front());
+                queue.pop_front();
+            }
+            try {
+                const auto base = directory / (std::to_string(job.timestamp) + "-encoder_input");
+                auto raw = base; raw += ".raw";
+                auto meta = base; meta += ".json";
+                std::ofstream bytes(raw, std::ios::binary);
+                bytes.exceptions(std::ios::badbit | std::ios::failbit);
+                bytes.write(reinterpret_cast<const char*>(job.pixels.data()), job.pixels.size());
+                bytes.close();
+                // Sidecar is the completion record. A partial raw file is never paired.
+                std::ofstream json(meta);
+                json.exceptions(std::ios::badbit | std::ios::failbit);
+                json << "{\"schema\":1,\"timestamp_ns\":" << job.timestamp
+                     << ",\"frame_index\":" << job.index << ",\"stage\":\"encoder_input\""
+                     << ",\"width\":" << job.width << ",\"height\":" << job.height
+                     << ",\"format\":\"" << job.format << "\",\"range\":\"" << job.range
+                     << "\",\"matrix\":\"bt709\",\"row_order\":\"top_down\",\"bytes\":"
+                     << job.pixels.size() << ",\"complete\":true}\n";
+                json.close();
+                Warn("[Q3PW_FRAME_DUMP] stage=encoder_input timestamp_ns=%llu written=1\n",
+                     (unsigned long long)job.timestamp);
+            } catch (const std::exception& e) {
+                Warn("[Q3PW_FRAME_DUMP] write_failed=%s\n", e.what());
+            }
+        }
+    }
+
+    FrameDump(FrameDumpConfig c, std::shared_ptr<CD3DRender> r)
+        : config(std::move(c)), render(std::move(r)) {
+        directory = std::filesystem::path(config.directory) / ("server-" + std::to_string(
+            std::chrono::system_clock::now().time_since_epoch().count()));
+        std::filesystem::create_directories(directory);
+        writer = std::thread([this] { Write(); });
+        Warn("[Q3PW_FRAME_DUMP] enabled count=%u interval=%u synchronous_gpu_readback=1 async_disk=1\n",
+             config.count, config.interval);
+    }
+
+public:
+    static std::unique_ptr<FrameDump> FromEnvironment(std::shared_ptr<CD3DRender> render) {
+        // Read once at encoder initialization. Off: no allocation, thread, GPU work or per-frame env reads.
+        const char* value = std::getenv("ALVR_Q3PW_FRAME_DUMP");
+        if (!value || !*value) return nullptr;
+        FrameDumpConfig config;
+        if (!ParseFrameDump(value, config)) {
+            Warn("[Q3PW_FRAME_DUMP] invalid ALVR_Q3PW_FRAME_DUMP; disabled\n");
+            return nullptr;
+        }
+        try { return std::unique_ptr<FrameDump>(new FrameDump(config, std::move(render))); }
+        catch (const std::exception& e) {
+            Warn("[Q3PW_FRAME_DUMP] setup_failed=%s; disabled\n", e.what());
+            return nullptr;
+        }
+    }
+
+    ~FrameDump() {
+        { std::lock_guard<std::mutex> lock(mutex); stopping = true; }
+        wake.notify_one();
+        if (writer.joinable()) writer.join();
+    }
+
+    void Capture(ID3D11Texture2D* texture, ID3D11Texture2D* const* planes, uint64_t timestamp) {
+        const auto index = seen++;
+        if (attempted >= config.count || index % config.interval) return;
+        ++attempted;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (queue.size() >= 1) {
+                Warn("[Q3PW_FRAME_DUMP] timestamp_ns=%llu dropped=writer_busy\n", (unsigned long long)timestamp);
+                return;
+            }
+        }
+        const auto start = std::chrono::steady_clock::now();
+        try {
+            D3D11_TEXTURE2D_DESC desc;
+            (planes ? planes[0] : texture)->GetDesc(&desc);
+            Job job {timestamp, index, desc.Width, desc.Height, "", "full", {}};
+            if (planes) {
+                D3D11_TEXTURE2D_DESC chroma;
+                planes[1]->GetDesc(&chroma);
+                job.format = chroma.Width == desc.Width ? "yuv444p" : "yuv420p";
+                job.range = Settings::Instance().m_useFullRangeEncoding ? "full" : "limited";
+                for (int i = 0; i < 3; ++i) ReadPlane(*render, planes[i], 1, job.pixels);
+            } else {
+                switch (desc.Format) {
+                case DXGI_FORMAT_R8G8B8A8_UNORM:
+                case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB: job.format = "rgba8"; break;
+                case DXGI_FORMAT_B8G8R8A8_UNORM:
+                case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: job.format = "bgra8"; break;
+                default: throw std::runtime_error("only SDR RGBA8/BGRA8 or PyroWave planes supported");
+                }
+                ReadPlane(*render, texture, 4, job.pixels);
+            }
+            { std::lock_guard<std::mutex> lock(mutex); queue.push_back(std::move(job)); }
+            wake.notify_one();
+        } catch (const std::exception& e) {
+            Warn("[Q3PW_FRAME_DUMP] timestamp_ns=%llu readback_failed=%s\n", (unsigned long long)timestamp, e.what());
+        }
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+        Warn("[Q3PW_FRAME_DUMP] timestamp_ns=%llu encoder_stall_ms=%.3f\n", (unsigned long long)timestamp, ms);
+    }
+};
+} // namespace q3pw
diff --git a/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDumpConfig.h b/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDumpConfig.h
new file mode 100644
index 0000000000000000000000000000000000000000..c5eae5845e0c25264ea1cb65d334277887319730
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/Q3PWFrameDumpConfig.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstdint>
+#include <string>
+
+namespace q3pw {
+struct FrameDumpConfig {
+    std::string directory;
+    uint32_t count = 0, interval = 0;
+};
+
+inline bool DumpNumber(const std::string& text, uint32_t maximum, uint32_t& value) {
+    if (text.empty()) return false;
+    uint64_t n = 0;
+    for (char c : text) {
+        if (c < '0' || c > '9') return false;
+        n = n * 10 + unsigned(c - '0');
+        if (n > maximum) return false;
+    }
+    if (!n) return false;
+    value = uint32_t(n);
+    return true;
+}
+
+// Split from the RIGHT: a Windows drive letter and directory colons are not delimiters.
+inline bool ParseFrameDump(const std::string& text, FrameDumpConfig& out) {
+    const auto last = text.rfind(':');
+    if (last == std::string::npos || last == 0) return false;
+    const auto previous = text.rfind(':', last - 1);
+    if (previous == std::string::npos || previous == 0) return false;
+    FrameDumpConfig parsed;
+    parsed.directory = text.substr(0, previous);
+    if (!DumpNumber(text.substr(previous + 1, last - previous - 1), 128, parsed.count)
+        || !DumpNumber(text.substr(last + 1), 9000, parsed.interval)) return false;
+    out = parsed;
+    return true;
+}
+} // namespace q3pw
