+//! Lossless SDR diagnostics. Never changes the decoder's AHB allocation/lease.
+//! glReadPixels stalls on selected frames; disk I/O uses a bounded worker queue.
+use super::{frame_dump_config::{self, Config}, GraphicsContext, GL_TEXTURE_EXTERNAL_OES};
+use alvr_common::glam::UVec2;
+use glow::{self as gl, HasContext};
+use std::{ffi::c_void, fs, num::NonZeroU32, path::PathBuf, rc::Rc,
+    sync::mpsc::{self, SyncSender}, thread::{self, JoinHandle}, time::{Instant, SystemTime, UNIX_EPOCH}};
+
+struct Image { stage: &'static str, size: UVec2, pixels: Vec<u8>, row_order: &'static str }
+struct Job { timestamp: u64, index: u64, images: Vec<Image> }
+
+pub(super) struct FrameDump {
+    config: Config,
+    seen: u64,
+    attempted: u32,
+    last_timestamp: Option<u64>,
+    pending: Option<Job>,
+    sender: Option<SyncSender<Job>>,
+    writer: Option<JoinHandle<()>>,
+}
+
+fn marker(text: String) { super::log_quest_experiment(format!("[Q3PW_FRAME_DUMP] {text}")); }
+
+impl FrameDump {
+    pub fn new(value: &str) -> Option<Self> {
+        let config = match frame_dump_config::parse(value) {
+            Ok(Some(config)) => config,
+            Ok(None) => return None,
+            Err(reason) => { marker(format!("disabled reason={reason}")); return None; }
+        };
+        // Fork package identity is pinned in fork.json. No private identifiers in file names.
+        let directory = PathBuf::from("/sdcard/Android/data/io.github.ljk1291.quest3pyrowave/files/q3pw-dumps")
+            .join(format!("client-{}", SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()));
+        if let Err(e) = fs::create_dir_all(&directory) {
+            marker(format!("disabled setup_failed={e}")); return None;
+        }
+        let (sender, receiver) = mpsc::sync_channel::<Job>(1);
+        let writer = match thread::Builder::new().name("q3pw-dump".into()).spawn(move || {
+            while let Ok(job) = receiver.recv() {
+                for image in job.images {
+                    let base = directory.join(format!("{}-{}", job.timestamp, image.stage));
+                    let result = (|| -> std::io::Result<()> {
+                        fs::write(base.with_extension("raw"), &image.pixels)?;
+                        // Only a complete sidecar admits this frame to the scorer.
+                        fs::write(base.with_extension("json"), format!(
+                            "{{\"schema\":1,\"timestamp_ns\":{},\"frame_index\":{},\"stage\":\"{}\",\"width\":{},\"height\":{},\"format\":\"rgba8\",\"range\":\"full\",\"matrix\":\"bt709\",\"row_order\":\"{}\",\"bytes\":{},\"complete\":true}}\n",
+                            job.timestamp, job.index, image.stage, image.size.x, image.size.y,
+                            image.row_order, image.pixels.len()))?;
+                        Ok(())
+                    })();
+                    marker(format!("timestamp_ns={} stage={} write={result:?}", job.timestamp, image.stage));
+                }
+            }
+        }) {
+            Ok(writer) => writer,
+            Err(e) => { marker(format!("disabled worker_failed={e}")); return None; }
+        };
+        marker(format!("enabled count={} interval={} synchronous_gpu_readback=1 async_disk=1",
+            config.count, config.interval));
+        Some(Self { config, seen: 0, attempted: 0, last_timestamp: None, pending: None,
+            sender: Some(sender), writer: Some(writer) })
+    }
+
+    pub unsafe fn begin(&mut self, context: &Rc<GraphicsContext>, source: *mut c_void,
+        timestamp: u64, packed: UVec2) {
+        self.pending = None;
+        if source.is_null() || self.last_timestamp == Some(timestamp) { return; }
+        self.last_timestamp = Some(timestamp);
+        let index = self.seen;
+        self.seen += 1;
+        if self.attempted >= self.config.count || index % u64::from(self.config.interval) != 0 { return; }
+        self.attempted += 1;
+        context.make_current();
+        let start = Instant::now();
+        // Preserve/sample the decoder output BEFORE the production renderer imports
+        // it (the legacy EGL import need not preserve contents).
+        let result = read_decoded(context, source, packed, None);
+        let mut images = vec![];
+        match result {
+            Ok(image) => images.push(image),
+            Err(reason) => marker(format!("timestamp_ns={timestamp} readback_failed={reason}")),
+        }
+        self.pending = Some(Job { timestamp, index, images });
+        marker(format!("timestamp_ns={timestamp} phase=decode client_stall_ms={:.3}", start.elapsed().as_secs_f64() * 1000.0));
+    }
+
+    pub unsafe fn finish(&mut self, context: &Rc<GraphicsContext>, presented: UVec2, textures: [u32; 2]) {
+        let Some(mut job) = self.pending.take() else { return; };
+        context.make_current();
+        let start = Instant::now();
+        match read_presented(context, presented, textures) {
+            Ok(images) => job.images.extend(images),
+            Err(reason) => marker(format!("timestamp_ns={} presented_readback_failed={reason}", job.timestamp)),
+        }
+        marker(format!("timestamp_ns={} phase=presented client_stall_ms={:.3}", job.timestamp, start.elapsed().as_secs_f64() * 1000.0));
+        if let Some(sender) = &self.sender {
+            let timestamp = job.timestamp;
+            if sender.try_send(job).is_err() {
+                marker(format!("timestamp_ns={timestamp} dropped=writer_busy"));
+            }
+        }
+    }
+}
+
+impl Drop for FrameDump {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(writer) = self.writer.take() { let _ = writer.join(); }
+    }
+}
+
+// Raw GLES shares WGPU's context. Restore every state changed here, including unit-0
+// bindings and pixel-pack state; merely binding FBO 0 would corrupt WGPU's cached state.
+struct State<'a> {
+    gl: &'a gl::Context, program: i32, vao: i32, draw: i32, read: i32,
+    active: i32, external: i32, texture: i32, sampler: i32, pack_buffer: i32,
+    viewport: [i32; 4], mask: [i32; 4], pack: [i32; 4], caps: Vec<(u32, bool)>,
+}
+fn name(n: i32) -> Option<NonZeroU32> { NonZeroU32::new(n as u32) }
+impl<'a> State<'a> {
+    unsafe fn save(gl: &'a gl::Context) -> Self {
+        let active = gl.get_parameter_i32(gl::ACTIVE_TEXTURE);
+        gl.active_texture(gl::TEXTURE0);
+        let mut viewport = [0; 4]; gl.get_parameter_i32_slice(gl::VIEWPORT, &mut viewport);
+        let mut mask = [0; 4]; gl.get_parameter_i32_slice(gl::COLOR_WRITEMASK, &mut mask);
+        let mut caps: Vec<_> = [gl::BLEND, gl::DEPTH_TEST, gl::STENCIL_TEST, gl::SCISSOR_TEST,
+            gl::CULL_FACE, gl::DITHER, gl::RASTERIZER_DISCARD, gl::SAMPLE_ALPHA_TO_COVERAGE,
+            gl::SAMPLE_COVERAGE].iter().map(|&cap| (cap, gl.is_enabled(cap))).collect();
+        if gl.supported_extensions().contains("GL_EXT_sRGB_write_control") { caps.push((0x8DB9, gl.is_enabled(0x8DB9))); }
+        let state = Self { gl, active, caps, viewport, mask,
+            program: gl.get_parameter_i32(gl::CURRENT_PROGRAM), vao: gl.get_parameter_i32(gl::VERTEX_ARRAY_BINDING),
+            draw: gl.get_parameter_i32(gl::DRAW_FRAMEBUFFER_BINDING), read: gl.get_parameter_i32(gl::READ_FRAMEBUFFER_BINDING),
+            external: gl.get_parameter_i32(0x8D67), texture: gl.get_parameter_i32(gl::TEXTURE_BINDING_2D),
+            sampler: gl.get_parameter_i32(gl::SAMPLER_BINDING), pack_buffer: gl.get_parameter_i32(gl::PIXEL_PACK_BUFFER_BINDING),
+            pack: [gl::PACK_ALIGNMENT, gl::PACK_ROW_LENGTH, gl::PACK_SKIP_ROWS, gl::PACK_SKIP_PIXELS].map(|p| gl.get_parameter_i32(p)) };
+        gl.active_texture(active as u32);
+        state
+    }
+}
+impl Drop for State<'_> {
+    fn drop(&mut self) { unsafe {
+        let gl = self.gl;
+        gl.use_program(name(self.program).map(gl::NativeProgram));
+        gl.bind_vertex_array(name(self.vao).map(gl::NativeVertexArray));
+        gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, name(self.draw).map(gl::NativeFramebuffer));
+        gl.bind_framebuffer(gl::READ_FRAMEBUFFER, name(self.read).map(gl::NativeFramebuffer));
+        gl.active_texture(gl::TEXTURE0);
+        gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, name(self.external).map(gl::NativeTexture));
+        gl.bind_texture(gl::TEXTURE_2D, name(self.texture).map(gl::NativeTexture));
+        gl.bind_sampler(0, name(self.sampler).map(gl::NativeSampler));
+        gl.active_texture(self.active as u32);
+        gl.bind_buffer(gl::PIXEL_PACK_BUFFER, name(self.pack_buffer).map(gl::NativeBuffer));
+        for (p, v) in [gl::PACK_ALIGNMENT, gl::PACK_ROW_LENGTH, gl::PACK_SKIP_ROWS, gl::PACK_SKIP_PIXELS].into_iter().zip(self.pack) { gl.pixel_store_i32(p, v); }
+        gl.viewport(self.viewport[0], self.viewport[1], self.viewport[2], self.viewport[3]);
+        gl.color_mask(self.mask[0] != 0, self.mask[1] != 0, self.mask[2] != 0, self.mask[3] != 0);
+        for &(cap, enabled) in &self.caps { if enabled { gl.enable(cap); } else { gl.disable(cap); } }
+    } }
+}
+
+struct Objects<'a> {
+    context: &'a GraphicsContext, textures: Vec<gl::Texture>, shaders: Vec<gl::Shader>,
+    program: Option<gl::Program>, vao: Option<gl::VertexArray>, fbo: Option<gl::Framebuffer>,
+    image: super::egl::EGLImage, owns_image: bool,
+}
+impl Drop for Objects<'_> {
+    fn drop(&mut self) { unsafe {
+        let gl = &self.context.gl_context;
+        // Complete all sampling before deleting the EGL sibling or releasing the AHB lease.
+        gl.finish();
+        for &texture in &self.textures { gl.delete_texture(texture); }
+        for &shader in &self.shaders { gl.delete_shader(shader); }
+        if let Some(program) = self.program { gl.delete_program(program); }
+        if let Some(vao) = self.vao { gl.delete_vertex_array(vao); }
+        if let Some(fbo) = self.fbo { gl.delete_framebuffer(fbo); }
+        if self.owns_image && !self.image.is_null() { (self.context.destroy_image)(self.context.egl_display.as_ptr(), self.image); }
+        // A diagnostic GL allocation/import error must not poison the renderer's
+        // next ck! call. Bound the drain even if the context has been lost.
+        for _ in 0..8 {
+            let error = gl.get_error();
+            if error == gl::NO_ERROR { break; }
+            marker(format!("readback_cleanup_gl_error={error:#x}"));
+        }
+    } }
+}
+
+unsafe fn read_pixels(gl: &gl::Context, size: UVec2) -> Result<Vec<u8>, String> {
+    if size.x == 0 || size.y == 0 || u64::from(size.x) * u64::from(size.y) * 4 > 256 * 1024 * 1024 { return Err("invalid extent".into()); }
+    if gl.check_framebuffer_status(gl::FRAMEBUFFER) != gl::FRAMEBUFFER_COMPLETE { return Err("incomplete framebuffer".into()); }
+    gl.bind_buffer(gl::PIXEL_PACK_BUFFER, None);
+    for (p, value) in [(gl::PACK_ALIGNMENT, 1), (gl::PACK_ROW_LENGTH, 0), (gl::PACK_SKIP_ROWS, 0), (gl::PACK_SKIP_PIXELS, 0)] { gl.pixel_store_i32(p, value); }
+    let length = size.x as usize * size.y as usize * 4;
+    let mut pixels = Vec::new();
+    pixels.try_reserve_exact(length).map_err(|_| "readback allocation failed".to_owned())?;
+    pixels.resize(length, 0);
+    gl.read_pixels(0, 0, size.x as i32, size.y as i32, gl::RGBA, gl::UNSIGNED_BYTE, gl::PixelPackData::Slice(Some(&mut pixels)));
+    let error = gl.get_error();
+    if error != gl::NO_ERROR { return Err(format!("GLES readback error {error:#x}")); }
+    Ok(pixels)
+}
+
+unsafe fn read_decoded(context: &GraphicsContext, source: *mut c_void,
+    packed: UVec2, test_image: Option<super::egl::EGLImage>) -> Result<Image, String> {
+    let gl = &context.gl_context;
+    if !gl.supported_extensions().contains("GL_OES_EGL_image_external_essl3") { return Err("missing external-image ESSL3".into()); }
+    let _state = State::save(gl);
+    gl.active_texture(gl::TEXTURE0);
+    let mut objects = Objects { context, textures: vec![], shaders: vec![], program: None,
+        vao: None, fbo: None, image: std::ptr::null_mut(), owns_image: test_image.is_none() };
+    let program = gl.create_program()?; objects.program = Some(program);
+    for (kind, code) in [(gl::VERTEX_SHADER, include_str!("../resources/frame_dump_vertex.glsl")),
+        (gl::FRAGMENT_SHADER, include_str!("../resources/frame_dump_fragment.glsl"))] {
+        let shader = gl.create_shader(kind)?; objects.shaders.push(shader);
+        gl.shader_source(shader, code); gl.compile_shader(shader);
+        if !gl.get_shader_compile_status(shader) { return Err(gl.get_shader_info_log(shader)); }
+        gl.attach_shader(program, shader);
+    }
+    gl.link_program(program);
+    if !gl.get_program_link_status(program) { return Err(gl.get_program_info_log(program)); }
+    let vao = gl.create_vertex_array()?; objects.vao = Some(vao); gl.bind_vertex_array(Some(vao));
+    let fbo = gl.create_framebuffer()?; objects.fbo = Some(fbo); gl.bind_framebuffer(gl::FRAMEBUFFER, Some(fbo));
+    let size = UVec2::new(packed.x * 2, packed.y);
+    if u64::from(size.x) * u64::from(size.y) * 4 > 256 * 1024 * 1024 { return Err("decoded extent too large".into()); }
+    let target = gl.create_texture()?; objects.textures.push(target);
+    gl.bind_texture(gl::TEXTURE_2D, Some(target));
+    gl.tex_storage_2d(gl::TEXTURE_2D, 1, gl::RGBA8, size.x as i32, size.y as i32);
+    gl.framebuffer_texture_2d(gl::FRAMEBUFFER, gl::COLOR_ATTACHMENT0, gl::TEXTURE_2D, Some(target), 0);
+    let external = gl.create_texture()?; objects.textures.push(external);
+    objects.image = if let Some(image) = test_image { image } else {
+        let native = (context.get_native_client_buffer)(source);
+        if native.is_null() { return Err("missing native client buffer".into()); }
+        let attributes = [0x30D2, 1, super::egl::NONE]; // EGL_IMAGE_PRESERVED_KHR
+        (context.create_image)(context.egl_display.as_ptr(), super::egl::NO_CONTEXT,
+            0x3140, native, attributes.as_ptr())
+    };
+    if objects.image.is_null() { return Err("preserved EGL import failed".into()); }
+    gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, Some(external));
+    (context.image_target_texture_2d)(GL_TEXTURE_EXTERNAL_OES, objects.image);
+    gl.bind_sampler(0, None);
+    for (p, v) in [(gl::TEXTURE_MIN_FILTER, gl::NEAREST), (gl::TEXTURE_MAG_FILTER, gl::NEAREST),
+        (gl::TEXTURE_WRAP_S, gl::CLAMP_TO_EDGE), (gl::TEXTURE_WRAP_T, gl::CLAMP_TO_EDGE)] { gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, p, v as i32); }
+    for &(cap, _) in &_state.caps { gl.disable(cap); }
+    gl.color_mask(true, true, true, true);
+    gl.viewport(0, 0, size.x as i32, size.y as i32);
+    gl.use_program(Some(program));
+    gl.uniform_1_i32(gl.get_uniform_location(program, "tex").as_ref(), 0);
+    gl.draw_arrays(gl::TRIANGLES, 0, 3);
+    Ok(Image { stage: "post_decode", size, pixels: read_pixels(gl, size)?, row_order: "top_down" })
+}
+
+unsafe fn read_presented(context: &GraphicsContext, size: UVec2, textures: [u32; 2]) -> Result<Vec<Image>, String> {
+    let gl = &context.gl_context;
+    let _state = State::save(gl);
+    let mut objects = Objects { context, textures: vec![], shaders: vec![], program: None,
+        vao: None, fbo: None, image: std::ptr::null_mut(), owns_image: false };
+    let fbo = gl.create_framebuffer()?; objects.fbo = Some(fbo);
+    gl.bind_framebuffer(gl::FRAMEBUFFER, Some(fbo));
+    let mut images = vec![];
+    // Raw swapchain rows are bottom-up. Scorer flips these into presented top-down coordinates.
+    for (stage, texture) in ["presented_left", "presented_right"].into_iter().zip(textures) {
+        let texture = name(texture as i32).ok_or("missing swapchain texture")?;
+        gl.framebuffer_texture_2d(gl::FRAMEBUFFER, gl::COLOR_ATTACHMENT0, gl::TEXTURE_2D, Some(gl::NativeTexture(texture)), 0);
+        images.push(Image { stage, size, pixels: read_pixels(gl, size)?, row_order: "bottom_up" });
+    }
+    Ok(images)
+}
