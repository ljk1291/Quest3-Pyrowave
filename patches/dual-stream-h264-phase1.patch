diff --git a/alvr/client_core/src/stereo_pairing.rs b/alvr/client_core/src/stereo_pairing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..503bb289163955a4f64ee9abd3f09275a95d702c
--- /dev/null
+++ b/alvr/client_core/src/stereo_pairing.rs
@@ -0,0 +1,358 @@
+//! Bounded decoded-eye pairing policy. No decoder, network, OpenXR or clock dependency.
+//! The caller owns both decoder queues and MUST honor every Recovery before new input.
+use alvr_packets::dual_stream::{AccessUnitHeader, MAX_ACCESS_UNIT_BYTES};
+use std::{collections::BTreeMap, time::Duration};
+
+pub const MAX_PENDING_PAIRS: usize = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DropReason {
+    Generation, InvalidHeader, Duplicate, PoseMismatch, IdOrder, Timeout,
+    QueueFull, DecoderFault, Disconnect, ClockRegression,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Recovery {
+    pub reason: DropReason,
+    pub flush_decoder_queues: [bool; 2],
+    pub request_idr: [bool; 2],
+    pub require_new_generation: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct PairingStats {
+    pub paired: u64,
+    pub dropped: u64,
+    pub incomplete: u64,
+    pub late: u64,
+    pub duplicates: u64,
+    pub pose_mismatch: u64,
+    pub resync: u64,
+    pub queue_full: u64,
+}
+
+pub struct StereoPair<T> {
+    pub generation: u64,
+    pub stereo_frame_id: u64,
+    pub pose_id: u64,
+    pub headers: [AccessUnitHeader; 2],
+    pub eyes: [T; 2],
+}
+
+struct Entry<T> {
+    deadline: Duration,
+    eyes: [Option<(AccessUnitHeader, T)>; 2],
+}
+
+pub struct PairingTable<T> {
+    capacity: usize,
+    timeout: Duration,
+    generation: Option<u64>,
+    last_generation: u64,
+    last_now: Option<Duration>,
+    retired: Option<(u64, [u64; 2])>,
+    // Generation is fixed for this table; frame and pose complete the key.
+    entries: BTreeMap<(u64, u64), Entry<T>>,
+    stats: PairingStats,
+}
+
+impl<T> PairingTable<T> {
+    pub fn new(capacity: usize, timeout: Duration) -> Result<Self, &'static str> {
+        if capacity == 0 || capacity > MAX_PENDING_PAIRS || timeout.is_zero() {
+            return Err("invalid_pairing_bounds");
+        }
+        Ok(Self { capacity, timeout, generation: None, last_generation: 0, last_now: None,
+            retired: None, entries: BTreeMap::new(), stats: PairingStats::default() })
+    }
+
+    pub fn len(&self) -> usize { self.entries.len() }
+    pub fn is_empty(&self) -> bool { self.entries.is_empty() }
+    pub fn stats(&self) -> PairingStats { self.stats }
+
+    /// Called only AFTER both queues were flushed and both IDRs requested.
+    /// Generations never wrap/reuse: exhausted u64 requires a new connection identity.
+    pub fn begin_generation(&mut self, generation: u64) -> Result<(), Recovery> {
+        if generation == 0 || generation <= self.last_generation {
+            return Err(self.recover(DropReason::Generation));
+        }
+        if self.generation.is_some() { self.recover(DropReason::Generation); }
+        self.generation = Some(generation);
+        self.last_generation = generation;
+        self.retired = None;
+        self.last_now = None;
+        Ok(())
+    }
+
+    fn recover(&mut self, reason: DropReason) -> Recovery {
+        self.stats.dropped += self.entries.len() as u64;
+        self.stats.incomplete += self.entries.values()
+            .filter(|entry| entry.eyes.iter().any(Option::is_none)).count() as u64;
+        self.stats.resync += 1;
+        match reason {
+            DropReason::Timeout => self.stats.late += 1,
+            DropReason::Duplicate => self.stats.duplicates += 1,
+            DropReason::PoseMismatch => self.stats.pose_mismatch += 1,
+            DropReason::QueueFull => self.stats.queue_full += 1,
+            _ => (),
+        }
+        self.entries.clear();
+        self.generation = None;
+        self.retired = None;
+        Recovery { reason, flush_decoder_queues: [true; 2], request_idr: [true; 2],
+            require_new_generation: true }
+    }
+
+    /// Use the same monotonic now for both eyes; a deadline is never extended.
+    pub fn expire(&mut self, now: Duration) -> Result<(), Recovery> {
+        if self.last_now.is_some_and(|last| now < last) {
+            return Err(self.recover(DropReason::ClockRegression));
+        }
+        self.last_now = Some(now);
+        if self.entries.values().any(|entry| now >= entry.deadline) {
+            return Err(self.recover(DropReason::Timeout));
+        }
+        Ok(())
+    }
+
+    /// AU identity is independent for each eye. Delivery may be out of order,
+    /// but encode order must agree with frame order within a generation.
+    pub fn insert(&mut self, header: AccessUnitHeader, encoded_bytes: usize, eye: T,
+        now: Duration) -> Result<(), Recovery> {
+        self.expire(now)?;
+        if Some(header.generation) != self.generation {
+            return Err(self.recover(DropReason::Generation));
+        }
+        if header.byte_count == 0 || header.byte_count > MAX_ACCESS_UNIT_BYTES
+            || encoded_bytes != header.byte_count as usize {
+            return Err(self.recover(DropReason::InvalidHeader));
+        }
+        let index = header.stream_id.index();
+        if let Some((frame, aus)) = self.retired {
+            if header.stereo_frame_id <= frame || header.access_unit_id <= aus[index] {
+                return Err(self.recover(DropReason::IdOrder));
+            }
+        }
+        let key = (header.stereo_frame_id, header.pose_id);
+        let mut fault = None;
+        for (&(frame, pose), entry) in &self.entries {
+            // Reorder only within the bounded frame window. Without this, a
+            // simultaneous frame/AU wrap could look like an ancient reordered AU.
+            if frame.abs_diff(header.stereo_frame_id) > MAX_PENDING_PAIRS as u64 {
+                fault = Some(DropReason::IdOrder); break;
+            }
+            if frame == header.stereo_frame_id && pose != header.pose_id {
+                fault = Some(DropReason::PoseMismatch); break;
+            }
+            if let Some((other, _)) = &entry.eyes[index] {
+                if frame == header.stereo_frame_id {
+                    fault = Some(DropReason::Duplicate); break;
+                }
+                if (frame < header.stereo_frame_id && other.access_unit_id >= header.access_unit_id)
+                    || (frame > header.stereo_frame_id && other.access_unit_id <= header.access_unit_id) {
+                    fault = Some(DropReason::IdOrder); break;
+                }
+            }
+        }
+        if let Some(reason) = fault { return Err(self.recover(reason)); }
+        if !self.entries.contains_key(&key) {
+            if self.entries.len() == self.capacity { return Err(self.recover(DropReason::QueueFull)); }
+            let Some(deadline) = now.checked_add(self.timeout) else {
+                return Err(self.recover(DropReason::Timeout));
+            };
+            self.entries.insert(key, Entry { deadline, eyes: [None, None] });
+        }
+        self.entries.get_mut(&key).unwrap().eyes[index] = Some((header, eye));
+        Ok(())
+    }
+
+    /// Only the oldest pending frame may be selected, and only for its exact pose.
+    /// Complete pairs stay bounded until selection; no newer eye can bypass a lost eye.
+    pub fn take_for_prediction(&mut self, frame: u64, pose: u64, now: Duration)
+        -> Result<Option<StereoPair<T>>, Recovery> {
+        self.expire(now)?;
+        let Some((&key, entry)) = self.entries.first_key_value() else { return Ok(None); };
+        if key.0 != frame { return Ok(None); }
+        if key.1 != pose { return Err(self.recover(DropReason::PoseMismatch)); }
+        if entry.eyes.iter().any(Option::is_none) { return Ok(None); }
+        let entry = self.entries.remove(&key).unwrap();
+        let [left, right] = entry.eyes;
+        let (lh, left) = left.unwrap();
+        let (rh, right) = right.unwrap();
+        self.retired = Some((frame, [lh.access_unit_id, rh.access_unit_id]));
+        self.stats.paired += 1;
+        Ok(Some(StereoPair { generation: lh.generation, stereo_frame_id: frame, pose_id: pose,
+            headers: [lh, rh], eyes: [left, right] }))
+    }
+
+    pub fn decoder_fault(&mut self) -> Recovery { self.recover(DropReason::DecoderFault) }
+    pub fn disconnect(&mut self) -> Recovery { self.recover(DropReason::Disconnect) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_packets::dual_stream::Eye;
+    fn now(ms: u64) -> Duration { Duration::from_millis(ms) }
+    fn table(capacity: usize) -> PairingTable<&'static str> {
+        let mut t = PairingTable::new(capacity, now(10)).unwrap();
+        t.begin_generation(1).unwrap(); t
+    }
+    fn h(eye: Eye, frame: u64, pose: u64, au: u64) -> AccessUnitHeader {
+        AccessUnitHeader { stream_id: eye, stereo_frame_id: frame, generation: 1,
+            pose_id: pose, access_unit_id: au, encode_timestamp_ns: 123, byte_count: 4 }
+    }
+    fn put(t: &mut PairingTable<&'static str>, eye: Eye, frame: u64, pose: u64, au: u64, ms: u64) {
+        t.insert(h(eye, frame, pose, au), 4,
+            if eye == Eye::Left { "LEFT" } else { "RIGHT" }, now(ms)).unwrap();
+    }
+    fn recovery(r: Recovery, reason: DropReason) {
+        assert_eq!(r.reason, reason);
+        assert_eq!(r.flush_decoder_queues, [true; 2]);
+        assert_eq!(r.request_idr, [true; 2]);
+        assert!(r.require_new_generation);
+    }
+    #[test]
+    fn distinct_eye_au_ids_and_out_of_order_delivery_keep_eye_and_pose() {
+        let mut t = table(3);
+        put(&mut t, Eye::Right, 2, 102, 22, 0);
+        put(&mut t, Eye::Left, 1, 101, 11, 1);
+        assert!(t.take_for_prediction(1, 101, now(1)).unwrap().is_none());
+        put(&mut t, Eye::Right, 1, 101, 21, 2);
+        put(&mut t, Eye::Left, 2, 102, 12, 3);
+        assert!(t.take_for_prediction(2, 102, now(3)).unwrap().is_none());
+        for (frame, aus) in [(1, [11, 21]), (2, [12, 22])] {
+            let pair = t.take_for_prediction(frame, 100 + frame, now(4)).unwrap().unwrap();
+            assert_eq!(pair.eyes, ["LEFT", "RIGHT"]);
+            assert_eq!(pair.headers.map(|header| header.access_unit_id), aus);
+            assert_eq!((pair.generation, pair.stereo_frame_id, pair.pose_id), (1, frame, 100 + frame));
+        }
+        assert!(t.is_empty()); assert_eq!(t.stats().paired, 2);
+    }
+    #[test]
+    fn one_eye_loss_blocks_newer_pair_and_flushes_both_at_deadline() {
+        let mut t = table(3);
+        put(&mut t, Eye::Left, 1, 101, 11, 0);
+        put(&mut t, Eye::Left, 2, 102, 12, 1);
+        put(&mut t, Eye::Right, 2, 102, 22, 1);
+        assert!(t.take_for_prediction(2, 102, now(9)).unwrap().is_none());
+        recovery(t.expire(now(10)).unwrap_err(), DropReason::Timeout);
+        assert_eq!((t.stats().dropped, t.stats().incomplete, t.stats().late), (2, 1, 1));
+        assert!(t.is_empty());
+        recovery(t.insert(h(Eye::Right, 1, 101, 21), 4, "RIGHT", now(11)).unwrap_err(), DropReason::Generation);
+    }
+    #[test]
+    fn duplicate_drops_whole_frame_and_requires_new_generation() {
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 101, 11, 0);
+        recovery(t.insert(h(Eye::Left, 1, 101, 11), 4, "WRONG", now(1)).unwrap_err(), DropReason::Duplicate);
+        assert_eq!(t.stats().duplicates, 1); assert_eq!(t.stats().dropped, 1);
+        assert!(t.take_for_prediction(1, 101, now(2)).unwrap().is_none());
+    }
+    #[test]
+    fn mismatched_pose_is_never_paired_or_selected() {
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 101, 11, 0);
+        recovery(t.insert(h(Eye::Right, 1, 999, 21), 4, "RIGHT", now(1)).unwrap_err(), DropReason::PoseMismatch);
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 101, 11, 0); put(&mut t, Eye::Right, 1, 101, 21, 0);
+        let result = t.take_for_prediction(1, 999, now(1));
+        recovery(result.err().unwrap(), DropReason::PoseMismatch);
+        assert_eq!(t.stats().paired, 0);
+    }
+    #[test]
+    fn generation_change_flushes_pending_and_cannot_rollback() {
+        let mut t = table(2); put(&mut t, Eye::Left, 1, 101, 11, 0);
+        t.begin_generation(2).unwrap(); assert!(t.is_empty());
+        assert_eq!(t.stats().incomplete, 1);
+        let header = AccessUnitHeader { generation: 2, ..h(Eye::Right, 1, 101, 21) };
+        t.insert(header, 4, "RIGHT", now(0)).unwrap();
+        assert!(t.take_for_prediction(1, 101, now(1)).unwrap().is_none());
+        recovery(t.begin_generation(1).unwrap_err(), DropReason::Generation);
+        recovery(t.begin_generation(2).unwrap_err(), DropReason::Generation);
+        t.begin_generation(3).unwrap();
+        recovery(t.insert(header, 4, "STALE", now(0)).unwrap_err(), DropReason::Generation);
+    }
+    #[test]
+    fn timeout_applies_to_complete_pairs_and_never_extends_for_second_eye() {
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 101, 11, 0); put(&mut t, Eye::Right, 1, 101, 21, 9);
+        let result = t.take_for_prediction(1, 101, now(10));
+        recovery(result.err().unwrap(), DropReason::Timeout);
+        assert_eq!(t.stats().incomplete, 0); assert_eq!(t.stats().paired, 0);
+    }
+    #[test]
+    fn queue_is_bounded_even_if_all_pairs_are_complete() {
+        let mut t = table(2);
+        for frame in 1..=2 {
+            put(&mut t, Eye::Left, frame, frame, frame, 0);
+            put(&mut t, Eye::Right, frame, frame, frame + 100, 0);
+        }
+        assert_eq!(t.len(), 2);
+        recovery(t.insert(h(Eye::Left, 3, 3, 3), 4, "LEFT", now(1)).unwrap_err(), DropReason::QueueFull);
+        assert_eq!(t.stats().queue_full, 1); assert!(t.is_empty());
+        for capacity in [0, MAX_PENDING_PAIRS + 1] {
+            assert!(PairingTable::<()>::new(capacity, now(1)).is_err());
+        }
+        assert!(PairingTable::<()>::new(1, now(0)).is_err());
+    }
+    #[test]
+    fn frame_and_au_wrap_require_new_generation() {
+        let mut t = table(2);
+        put(&mut t, Eye::Left, u64::MAX, 1, u64::MAX, 0);
+        put(&mut t, Eye::Right, u64::MAX, 1, u64::MAX, 0);
+        assert!(t.take_for_prediction(u64::MAX, 1, now(1)).unwrap().is_some());
+        recovery(t.insert(h(Eye::Left, 0, 2, 0), 4, "LEFT", now(2)).unwrap_err(), DropReason::IdOrder);
+        t.begin_generation(2).unwrap();
+        t.insert(AccessUnitHeader { generation: 2, ..h(Eye::Left, 0, 2, 0) }, 4, "LEFT", now(0)).unwrap();
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 1, u64::MAX, 0);
+        recovery(t.insert(h(Eye::Left, 2, 2, 0), 4, "LEFT", now(1)).unwrap_err(), DropReason::IdOrder);
+        let mut t = table(2);
+        put(&mut t, Eye::Left, u64::MAX, 1, u64::MAX, 0);
+        recovery(t.insert(h(Eye::Left, 0, 2, 0), 4, "LEFT", now(1)).unwrap_err(), DropReason::IdOrder);
+    }
+    #[test]
+    fn reused_au_and_displayed_frame_are_rejected() {
+        let mut t = table(2); put(&mut t, Eye::Left, 1, 1, 11, 0);
+        recovery(t.insert(h(Eye::Left, 2, 2, 11), 4, "LEFT", now(1)).unwrap_err(), DropReason::IdOrder);
+        let mut t = table(2);
+        put(&mut t, Eye::Left, 1, 1, 11, 0); put(&mut t, Eye::Right, 1, 1, 21, 0);
+        t.take_for_prediction(1, 1, now(1)).unwrap().unwrap();
+        recovery(t.insert(h(Eye::Right, 1, 1, 21), 4, "RIGHT", now(2)).unwrap_err(), DropReason::IdOrder);
+    }
+    #[test]
+    fn decoder_fault_disconnect_and_bad_payload_flush_everything() {
+        let mut t = table(2); put(&mut t, Eye::Left, 1, 1, 1, 0);
+        recovery(t.decoder_fault(), DropReason::DecoderFault); assert!(t.is_empty());
+        t.begin_generation(2).unwrap(); recovery(t.disconnect(), DropReason::Disconnect);
+        let mut t = table(2); put(&mut t, Eye::Left, 1, 1, 1, 0);
+        recovery(t.insert(h(Eye::Right, 1, 1, 2), 3, "RIGHT", now(1)).unwrap_err(), DropReason::InvalidHeader);
+        assert!(t.is_empty());
+    }
+    #[test]
+    fn clock_regression_and_generation_exhaustion_fail_closed() {
+        let mut t = table(2); t.expire(now(2)).unwrap();
+        recovery(t.expire(now(1)).unwrap_err(), DropReason::ClockRegression);
+        t.begin_generation(u64::MAX).unwrap();
+        recovery(t.begin_generation(0).unwrap_err(), DropReason::Generation);
+    }
+    #[test]
+    fn flush_releases_both_owned_eye_handles() {
+        use std::sync::{Arc, atomic::{AtomicUsize, Ordering}};
+        struct Handle(Arc<AtomicUsize>);
+        impl Drop for Handle {
+            fn drop(&mut self) { self.0.fetch_add(1, Ordering::SeqCst); }
+        }
+        let released = Arc::new(AtomicUsize::new(0));
+        let mut t = PairingTable::new(2, now(10)).unwrap();
+        t.begin_generation(1).unwrap();
+        for eye in [Eye::Left, Eye::Right] {
+            t.insert(h(eye, 1, 1, 1), 4, Handle(Arc::clone(&released)), now(0)).unwrap();
+        }
+        assert_eq!(released.load(Ordering::SeqCst), 0);
+        recovery(t.decoder_fault(), DropReason::DecoderFault);
+        assert_eq!(released.load(Ordering::SeqCst), 2);
+        t.begin_generation(2).unwrap();
+        assert!(t.take_for_prediction(1, 1, now(0)).unwrap().is_none());
+    }
+}
