diff --git a/alvr/packets/src/dual_stream.rs b/alvr/packets/src/dual_stream.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a832d5ad935ea488be5615f95149c0693b2b303e
--- /dev/null
+++ b/alvr/packets/src/dual_stream.rs
@@ -0,0 +1,177 @@
+//! WO-11 framing contract. Pure CPU code; never used for the legacy VIDEO stream.
+pub const VERSION: u16 = 1;
+pub const HEADER_LEN: usize = 56;
+pub const MAX_ACCESS_UNIT_BYTES: u32 = 16 * 1024 * 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Eye { Left, Right }
+
+impl Eye {
+    pub fn index(self) -> usize { match self { Self::Left => 0, Self::Right => 1 } }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AccessUnitHeader {
+    pub stream_id: Eye,
+    pub stereo_frame_id: u64,
+    pub generation: u64,
+    pub pose_id: u64,
+    pub access_unit_id: u64,
+    pub encode_timestamp_ns: u64,
+    pub byte_count: u32,
+}
+
+impl AccessUnitHeader {
+    pub fn to_bytes(self) -> [u8; HEADER_LEN] {
+        let mut bytes = [0; HEADER_LEN];
+        bytes[0..4].copy_from_slice(b"DSH1");
+        bytes[4..6].copy_from_slice(&VERSION.to_le_bytes());
+        bytes[6] = self.stream_id.index() as u8;
+        for (i, value) in [self.generation, self.stereo_frame_id, self.pose_id,
+            self.access_unit_id, self.encode_timestamp_ns].into_iter().enumerate() {
+            bytes[8 + i * 8..16 + i * 8].copy_from_slice(&value.to_le_bytes());
+        }
+        bytes[48..52].copy_from_slice(&self.byte_count.to_le_bytes());
+        bytes
+    }
+
+    /// Header only: the TCP AU receiver must additionally call validate_payload.
+    /// Reserved bytes fail closed; this is not bincode or native struct layout.
+    pub fn from_bytes(bytes: &[u8]) -> Option<Self> {
+        if bytes.len() != HEADER_LEN || &bytes[0..4] != b"DSH1"
+            || u16::from_le_bytes(bytes[4..6].try_into().ok()?) != VERSION
+            || bytes[7] != 0 || bytes[52..56] != [0; 4] {
+            return None;
+        }
+        let stream_id = match bytes[6] { 0 => Eye::Left, 1 => Eye::Right, _ => return None };
+        let read = |offset| u64::from_le_bytes(bytes[offset..offset + 8].try_into().unwrap());
+        let header = Self {
+            stream_id, generation: read(8), stereo_frame_id: read(16), pose_id: read(24),
+            access_unit_id: read(32), encode_timestamp_ns: read(40),
+            byte_count: u32::from_le_bytes(bytes[48..52].try_into().ok()?),
+        };
+        (header.generation != 0 && header.byte_count > 0
+            && header.byte_count <= MAX_ACCESS_UNIT_BYTES).then_some(header)
+    }
+
+    pub fn validate_payload(self, payload: &[u8]) -> bool {
+        self.generation != 0 && self.byte_count > 0
+            && self.byte_count <= MAX_ACCESS_UNIT_BYTES
+            && payload.len() == self.byte_count as usize
+    }
+}
+
+/// A framing capability is not proof of two hardware decoder sessions.
+pub fn negotiate(requested: bool, peer_version: Option<u16>) -> Result<bool, &'static str> {
+    if !requested { return Ok(false); }
+    match peer_version {
+        Some(VERSION) => Ok(true),
+        None => Err("missing_dual_stream_version"),
+        _ => Err("incompatible_dual_stream_version"),
+    }
+}
+
+pub fn validate_negotiated(requested: bool, version: Option<u16>) -> Result<(), &'static str> {
+    if requested != version.is_some() { return Err("dual_stream_request_effective_mismatch"); }
+    negotiate(requested, version).map(|_| ())
+}
+
+/// The signed-pair gate also verifies certificates/artifacts; this is runtime build identity.
+pub fn negotiate_build(requested: bool, peer_build: Option<&str>, local_build: &str)
+    -> Result<(), &'static str> {
+    if !requested { return Ok(()); }
+    if local_build.is_empty() || peer_build != Some(local_build) {
+        return Err("mismatched_dual_stream_build");
+    }
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BitrateSplit { pub total_bps: u64, pub eye_bps: [u64; 2] }
+
+/// Phase-1 candidate policy. Never mutates codec, foveation, transport or bitrate.
+pub fn request_policy(requested: bool, h264: bool, foveated: bool, ten_bit_or_hdr: bool,
+    tcp: bool, constant_mbps: Option<u64>) -> Result<Option<BitrateSplit>, &'static str> {
+    if !requested { return Ok(None); }
+    if !h264 { return Err("h264_only"); }
+    if foveated { return Err("foveation_must_be_off"); }
+    if ten_bit_or_hdr { return Err("eight_bit_sdr_only"); }
+    if !tcp { return Err("tcp_required"); }
+    let mbps = constant_mbps.ok_or("constant_total_bitrate_required")?;
+    if !(5..=500).contains(&mbps) { return Err("total_mbps_must_be_5_to_500"); }
+    let total_bps = mbps * 1_000_000;
+    Ok(Some(BitrateSplit { total_bps, eye_bps: [total_bps / 2; 2] }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn header() -> AccessUnitHeader {
+        AccessUnitHeader { stream_id: Eye::Left, stereo_frame_id: 9, generation: 2,
+            pose_id: 44, access_unit_id: 100, encode_timestamp_ns: 123, byte_count: 3 }
+    }
+    #[test]
+    fn distinct_eye_headers_round_trip_with_exact_little_endian_layout() {
+        for eye in [Eye::Left, Eye::Right] {
+            let h = AccessUnitHeader { stream_id: eye, ..header() };
+            let b = h.to_bytes();
+            assert_eq!(&b[0..8], &[b'D', b'S', b'H', b'1', 1, 0, eye.index() as u8, 0]);
+            assert_eq!(&b[16..24], &9_u64.to_le_bytes());
+            assert_eq!(AccessUnitHeader::from_bytes(&b), Some(h));
+            assert!(h.validate_payload(&[1, 2, 3]));
+            assert!(!h.validate_payload(&[1, 2]));
+        }
+    }
+    #[test]
+    fn malformed_headers_fail_closed() {
+        let b = header().to_bytes();
+        for offset in [0, 4, 6, 7, 52, 55] {
+            let mut bad = b; bad[offset] = 255;
+            assert!(AccessUnitHeader::from_bytes(&bad).is_none());
+        }
+        assert!(AccessUnitHeader::from_bytes(&b[..55]).is_none());
+        assert!(AccessUnitHeader::from_bytes(&[0; 57]).is_none());
+        for h in [AccessUnitHeader { generation: 0, ..header() },
+            AccessUnitHeader { byte_count: 0, ..header() },
+            AccessUnitHeader { byte_count: MAX_ACCESS_UNIT_BYTES + 1, ..header() }] {
+            assert!(AccessUnitHeader::from_bytes(&h.to_bytes()).is_none());
+            assert!(!h.validate_payload(&[1, 2, 3]));
+        }
+    }
+    #[test]
+    fn requested_mode_needs_explicit_matching_version() {
+        assert_eq!(negotiate(false, None), Ok(false));
+        assert_eq!(negotiate(false, Some(999)), Ok(false));
+        assert!(negotiate(true, None).is_err());
+        assert!(negotiate(true, Some(0)).is_err());
+        assert!(negotiate(true, Some(VERSION + 1)).is_err());
+        assert_eq!(negotiate(true, Some(VERSION)), Ok(true));
+        assert_eq!(validate_negotiated(false, None), Ok(()));
+        assert_eq!(validate_negotiated(true, Some(VERSION)), Ok(()));
+        assert!(validate_negotiated(true, None).is_err());
+        assert!(validate_negotiated(false, Some(VERSION)).is_err());
+        let build = "20.13.0-ljk1291.3+0123456789ab";
+        assert_eq!(negotiate_build(false, None, build), Ok(()));
+        assert_eq!(negotiate_build(true, Some(build), build), Ok(()));
+        for peer in [None, Some("20.13.0-ljk1291.2"), Some("20.13.0-ljk1291.3+abcdef012345")] {
+            assert!(negotiate_build(true, peer, build).is_err());
+        }
+    }
+    #[test]
+    fn policy_is_default_off_and_splits_the_total_not_each_eye() {
+        assert_eq!(request_policy(false, false, true, true, false, None), Ok(None));
+        let split = request_policy(true, true, false, false, true, Some(500)).unwrap().unwrap();
+        assert_eq!(split.total_bps, 500_000_000);
+        assert_eq!(split.eye_bps, [250_000_000; 2]);
+        assert_eq!(request_policy(true, true, false, false, true, Some(5)).unwrap().unwrap().eye_bps,
+            [2_500_000; 2]);
+        for value in [0, 4, 501, u64::MAX] {
+            assert!(request_policy(true, true, false, false, true, Some(value)).is_err());
+        }
+        for args in [(false, false, false, true, Some(500)), (true, true, false, true, Some(500)),
+            (true, false, true, true, Some(500)), (true, false, false, false, Some(500)),
+            (true, false, false, true, None)] {
+            assert!(request_policy(true, args.0, args.1, args.2, args.3, args.4).is_err());
+        }
+    }
+}
