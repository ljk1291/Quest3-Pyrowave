 bool Decoder::Impl::dequant(CommandBuffer &cmd)
 {
 	DequantizerPushData push = {};
+	push.reconstruction_offset = bounded_reconstruction_offset();
 
 	cmd.set_specialization_constant_mask(0);
 	cmd.enable_subgroup_size_control(true);
