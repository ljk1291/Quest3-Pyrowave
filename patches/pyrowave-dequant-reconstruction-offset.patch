diff --git a/pyrowave_dequant_reconstruction_offset.hpp b/pyrowave_dequant_reconstruction_offset.hpp
new file mode 100644
index 0000000..a41d234
--- /dev/null
+++ b/pyrowave_dequant_reconstruction_offset.hpp
@@ -0,0 +1,54 @@
+// Copyright (c) 2026 Hans-Kristian Arntzen
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+
+namespace PyroWave
+{
+struct ReconstructionOffset
+{
+	float value = 0.0f;
+	bool valid = true;
+};
+
+// Keep the opt-in range deliberately below one decoded magnitude step. Zero
+// follows the legacy expression exactly, which is part of this experiment's
+// compatibility contract.
+inline ReconstructionOffset parse_reconstruction_offset(const char *requested)
+{
+	ReconstructionOffset result = {};
+	if (!requested || !*requested)
+		return result;
+
+	errno = 0;
+	char *end = nullptr;
+	float parsed = std::strtof(requested, &end);
+	if (errno || end == requested || !end || *end != '\0' || !std::isfinite(parsed) ||
+	    parsed < -0.25f || parsed > 0.25f)
+	{
+		result.valid = false;
+		return result;
+	}
+	result.value = parsed;
+	return result;
+}
+
+// This mirrors wavelet_dequant.comp: magnitudes are offset before scaling and
+// sign restoration, while encoded zeros remain zero.
+inline float reconstruct_dequant_magnitude(float magnitude, float inv_scale, float offset)
+{
+	if (magnitude == 0.0f)
+		return 0.0f;
+	if (offset == 0.0f)
+		return magnitude * inv_scale;
+	return (magnitude + offset) * inv_scale;
+}
+
+inline float restore_dequant_sign(float magnitude, bool negative)
+{
+	return negative ? -magnitude : magnitude;
+}
+}
diff --git a/pyrowave_dequant_reconstruction_offset_test.cpp b/pyrowave_dequant_reconstruction_offset_test.cpp
new file mode 100644
index 0000000..f866e66
--- /dev/null
+++ b/pyrowave_dequant_reconstruction_offset_test.cpp
@@ -0,0 +1,53 @@
+// Copyright (c) 2026 Hans-Kristian Arntzen
+// SPDX-License-Identifier: MIT
+#include "pyrowave_dequant_reconstruction_offset.hpp"
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#define ASSERT_THAT(expr) do { \
+	if (!(expr)) { std::fprintf(stderr, "Assertion failed: %s at line %d.\n", #expr, __LINE__); return 1; } \
+} while (false)
+
+static uint32_t float_bits(float value)
+{
+	uint32_t bits = 0;
+	static_assert(sizeof(bits) == sizeof(value), "Unexpected float size.");
+	std::memcpy(&bits, &value, sizeof(bits));
+	return bits;
+}
+
+static float legacy_deadzone_dequant(float magnitude, float inv_scale)
+{
+	return magnitude == 0.0f ? 0.0f : magnitude * inv_scale;
+}
+
+int main()
+{
+	using namespace PyroWave;
+	const float inv_scale = 0.375f;
+	const float magnitude = 3.5f;
+
+	// The default path must retain the legacy IEEE-754 operation and bits.
+	const float legacy = legacy_deadzone_dequant(magnitude, inv_scale);
+	ASSERT_THAT(float_bits(reconstruct_dequant_magnitude(magnitude, inv_scale, 0.0f)) == float_bits(legacy));
+	ASSERT_THAT(float_bits(reconstruct_dequant_magnitude(magnitude, inv_scale, parse_reconstruction_offset(nullptr).value)) == float_bits(legacy));
+
+	for (float offset : { -0.25f, -0.125f, 0.0f, 0.125f, 0.25f })
+	{
+		const float reconstructed = reconstruct_dequant_magnitude(magnitude, inv_scale, offset);
+		ASSERT_THAT(float_bits(reconstructed) == float_bits((magnitude + offset) * inv_scale));
+		ASSERT_THAT(float_bits(restore_dequant_sign(reconstructed, false)) == float_bits(reconstructed));
+		ASSERT_THAT(float_bits(restore_dequant_sign(reconstructed, true)) == float_bits(-reconstructed));
+		ASSERT_THAT(float_bits(reconstruct_dequant_magnitude(0.0f, inv_scale, offset)) ==
+		            float_bits(legacy_deadzone_dequant(0.0f, inv_scale)));
+	}
+
+	for (const char *accepted : { "-0.25", "-0.125", "0", "0.125", "0.25" })
+		ASSERT_THAT(parse_reconstruction_offset(accepted).valid);
+	for (const char *rejected : { "-0.2501", "0.2501", "nan", "inf", "0x1p-3x" })
+		ASSERT_THAT(!parse_reconstruction_offset(rejected).valid);
+
+	std::puts("PyroWave dequant reconstruction offset default parity, sign/zero, and interval checks passed.");
+	return 0;
+}
