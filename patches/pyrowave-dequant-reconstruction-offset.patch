 	int32_t block_offset_32x32;
 	int32_t block_stride_32x32;
 	int32_t block_count_32x32;
+	float reconstruction_offset;
 };
 
+static float bounded_reconstruction_offset()
+{
+	// Opt-in decoder experiment. Zero is deliberately the exact legacy value.
+	const char *value = getenv("PYROWAVE_DEQUANT_RECONSTRUCTION_OFFSET");
+	if (!value || !*value)
+		return 0.0f;
+	char *end = nullptr;
+	errno = 0;
+	float offset = strtof(value, &end);
+	if (errno || end == value || *end || !std::isfinite(offset) || offset < -0.25f || offset > 0.25f)
+	{
+		LOGW("Ignoring invalid PYROWAVE_DEQUANT_RECONSTRUCTION_OFFSET. Allowed interval is [-0.25, 0.25].\n");
+		return 0.0f;
+	}
+	return offset;
+}
+
 struct Decoder::Impl final : public WaveletBuffers
