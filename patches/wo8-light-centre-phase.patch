diff --git a/alvr/graphics/resources/stream.wgsl b/alvr/graphics/resources/stream.wgsl
index c602c2f8381f28fb97ac89c4c5f169309faabcf1..75c7b51af36a6b6f23a477ffd9b51d9dac14c3be 100644
--- a/alvr/graphics/resources/stream.wgsl
+++ b/alvr/graphics/resources/stream.wgsl
@@ -16,6 +16,10 @@ override ENABLE_FFE: bool = false;
 
 override VIEW_WIDTH_RATIO: f32 = 0.0;
 override VIEW_HEIGHT_RATIO: f32 = 0.0;
+// Expanded per-eye dimensions are required to invert the server's phase
+// translation in source-texel coordinates.
+override FFE_VIEW_WIDTH: f32 = 0.0;
+override FFE_VIEW_HEIGHT: f32 = 0.0;
 override EDGE_X_RATIO: f32 = 0.0;
 override EDGE_Y_RATIO: f32 = 0.0;
 
@@ -96,6 +100,14 @@ fn fragment_main(@location(0) uv: vec2f) -> @location(0) vec4f {
             corrected_uv.x = 1.0 - corrected_uv.x;
         }
 
+        // The Windows compressor moves a half-integral central intercept onto
+        // texel centres. Undo that source-space translation before solving its
+        // unphased inverse. The tie convention and epsilon match HLSL/Python.
+        let expanded_resolution = vec2f(FFE_VIEW_WIDTH, FFE_VIEW_HEIGHT);
+        let intercept_px = c1 * expanded_resolution;
+        let sample_phase_px = floor(intercept_px + vec2f(0.5 - 1e-4)) - intercept_px;
+        corrected_uv = corrected_uv - sample_phase_px / expanded_resolution;
+
         let center = (corrected_uv - c1) * edge_ratio / c2;
         let left_edge = (-b_left + sqrt(b_left * b_left + 4.0 * a_left * corrected_uv)) / (2.0 * a_left);
         let right_edge = (-b_right + sqrt(b_right * b_right - 4.0 * (c_right - a_right * corrected_uv))) / (2.0 * a_right);
