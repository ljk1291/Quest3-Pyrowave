+++ b/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl
@@ -52,6 +52,14 @@ float4 main(FoveationPixelInput input) : SV_Target {
 	float2 rightEdge = g2 * center + (1. - g2) * d3;
 
 	float2 compressedUV = underBound * leftEdge + inBound * center + overBound * rightEdge;
+	// A 32-pixel allocation can leave the central affine intercept halfway
+	// between source texels (Light/Q3 x is 87.5). Move the sampling lattice to
+	// texel centres; exact ties choose the lower texel. This is a constant
+	// translation, hence it leaves ALVR's mapping derivative unchanged. The
+	// reconstruction path applies the exact inverse translation.
+	float2 interceptPx = c1 * targetResolution;
+	float2 samplePhasePx = floor(interceptPx + .5 - 1e-4) - interceptPx;
+	compressedUV += samplePhasePx / targetResolution;
 	if (blurOnly > .5) compressedUV = outputEyeUV;
 
