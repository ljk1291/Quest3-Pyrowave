diff --git a/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl b/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl
--- a/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl
+++ b/alvr/server_openvr/cpp/alvr_server/shader/CompressAxisAlignedPixelShader.hlsl
@@ -35,6 +35,17 @@ float4 main(FoveationPixelInput input) : SV_Target {
 
     float2 loBound = c0 * (shift + 1.) / c2;
     float2 hiBound = c0 * (shift - 1.) / c2 + 1.;
+    // The C++ producer marks H264WidthOnly explicitly. Give its Y component
+    // finite neutral coefficients before the shared vector mapping runs; then
+    // restore the exact unscaled output Y below. This prevents zero-height
+    // peripheral joins from reaching any division or footprint calculation.
+    if (verticalIdentity > .5) {
+        eyeUV.y = outputEyeUV.y;
+        c0.y = .5;
+        c1.y = 0.;
+        c2.y = 1.;
+        loBound.y = .5;
+        hiBound.y = .5;
+    }
@@ -52,6 +63,10 @@ float4 main(FoveationPixelInput input) : SV_Target {
  
      float2 compressedUV = underBound * leftEdge + inBound * center + overBound * rightEdge;
+    if (verticalIdentity > .5) {
+        compressedUV.y = outputEyeUV.y;
+    }
      if (blurOnly > .5) compressedUV = outputEyeUV;
@@ -75,6 +90,9 @@ float4 main(FoveationPixelInput input) : SV_Target {
      float2 mappingDerivative = underBound * leftDerivative
          + inBound * (c2 / edgeRatio) + overBound * rightDerivative;
+    if (verticalIdentity > .5) {
+        mappingDerivative.y = 1.;
+    }
      if (blurOnly > .5) mappingDerivative = float2(1., 1.);
+    // Peripheral softness expands the shared two-axis footprint above. Restore
+    // width-only's identity Y *after* that multiplication so it never blurs Y.
+    if (verticalIdentity > .5) mappingDerivative.y = 1.;


