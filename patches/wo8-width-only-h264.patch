+    float centerShiftRightYAligned = verticalIdentity ? 0.f
+        : ceil(centerShiftRightY * edgeSizeYAligned / (edgeRatioY * 2.))
+            * (edgeRatioY * 2.) / edgeSizeYAligned;
  
      float foveationScaleX = Settings::Instance().m_foveationBlurOnly ? 1.f : (centerSizeXAligned + (1. - centerSizeXAligned) / edgeRatioX);
-    float foveationScaleY = Settings::Instance().m_foveationBlurOnly ? 1.f : (centerSizeYAligned + (1. - centerSizeYAligned) / edgeRatioY);
+    float foveationScaleY = (Settings::Instance().m_foveationBlurOnly || verticalIdentity)
+        ? 1.f : (centerSizeYAligned + (1. - centerSizeYAligned) / edgeRatioY);
@@ -102,6 +114,10 @@ FoveationVars CalculateFoveationVars(
               // different softness value here.
               Settings::Instance().m_foveationPeripheralSoftness,
-             Settings::Instance().m_foveationBlurOnly ? 1.f : 0.f };
+             Settings::Instance().m_foveationBlurOnly ? 1.f : 0.f,
