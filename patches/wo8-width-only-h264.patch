diff --git a/alvr/graphics/src/stream.rs b/alvr/graphics/src/stream.rs
--- a/alvr/graphics/src/stream.rs
+++ b/alvr/graphics/src/stream.rs
@@ -470,6 +470,24 @@ fn set_passthrough_push_constants(render_pass: &mut RenderPass, config: Option<&
  }
  
+/// The fixed server profile overrides the dashboard's numeric fields.  Keep the
+/// receiver's inverse in the same coordinate system. For identity Y, feed the
+/// vector inverse finite H264Fit Y coefficients and let stream.wgsl restore the
+/// decoded Y coordinate before sampling; this avoids evaluating 0/0 joins.
+fn receiver_foveation_profile(mut config: FoveatedEncodingConfig) -> (FoveatedEncodingConfig, bool) {
+    let identity_y = matches!(
+        config.profile,
+        alvr_session::FoveationProfile::H264WidthOnly
+    );
+    if identity_y {
+        config.center_size_x = 23.0 / 41.0;
+        config.edge_ratio_x = 2.0;
+        // Placeholder values are only used by the inactive Y algebra.
+        config.center_size_y = 0.5;
+        config.edge_ratio_y = 2.0;
+    }
+    (config, identity_y)
+}
