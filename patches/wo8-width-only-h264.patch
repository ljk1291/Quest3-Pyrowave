# Layered after patches/wo8-foveation.patch.
#
# This is intentionally a source-only layer. It does not select the profile by
# default and it must be compiled with the matching server/client source before
# any live use.  H264WidthOnly is the one opt-in fixed profile whose Y axis is
# identity.  The explicit verticalIdentity flag avoids treating a full-height
# centre (where the peripheral band has zero height) as normal foveation.

diff --git a/alvr/session/src/settings.rs b/alvr/session/src/settings.rs
--- a/alvr/session/src/settings.rs
+++ b/alvr/session/src/settings.rs
@@ -531,6 +531,8 @@ pub enum FoveationProfile {
      Medium,
      #[schema(strings(display_name = "H.264 fit (0.5 / 2x)"))]
      H264Fit,
+    #[schema(strings(display_name = "H.264 width-only (23/41 / 2x X; identity Y)"))]
+    H264WidthOnly,
      #[schema(strings(display_name = "Custom"))]
      Custom,
  }
@@ -544,7 +546,7 @@ pub struct FoveatedEncodingConfig {
-    #[schema(strings(display_name = "Foveation profile", help = "Light, Medium and H.264 fit pin the documented fixed centre and edge values. Custom exposes the advanced values below. The feature remains disabled until its parent switch is enabled."))]
+    #[schema(strings(display_name = "Foveation profile", help = "Light, Medium and H.264 fit foveate both axes. H.264 width-only uses the H.264 fit X axis and an explicit identity Y axis. The feature remains disabled until its parent switch is enabled."))]
      #[schema(flag = "steamvr-restart")]
      pub profile: FoveationProfile,
  
diff --git a/alvr/server_core/src/connection.rs b/alvr/server_core/src/connection.rs
--- a/alvr/server_core/src/connection.rs
+++ b/alvr/server_core/src/connection.rs
@@ -103,6 +103,7 @@ fn openvr_config_with_env(
                  FoveationProfile::Light => (0.8, 1.5, (0., 0.)),
                  FoveationProfile::Medium => (0.6, 2.0, (0., 0.)),
                  FoveationProfile::H264Fit => (0.5, 2.0, (0., 0.)),
+                FoveationProfile::H264WidthOnly => (23.0 / 41.0, 2.0, (0., 0.)),
                  FoveationProfile::Custom => (config.center_size_x, config.edge_ratio_x,
                      (config.center_shift_x, config.center_shift_y)),
              };
@@ -126,10 +127,14 @@ fn openvr_config_with_env(
                  (false, 0., 0., 0., 0., 1., 1., 0., false)
              } else {
-                let center_y = if matches!(config.profile, FoveationProfile::Custom) {
-                    config.center_size_y
-                } else { center };
-                let edge_y = if matches!(config.profile, FoveationProfile::Custom) {
-                    config.edge_ratio_y
-                } else { edge };
+                // 1.0 / 1.0 is a deliberate identity-Y sentinel. The native
+                // layer below branches before the zero-height band algebra.
+                let center_y = match config.profile {
+                    FoveationProfile::H264WidthOnly => 1.0,
+                    FoveationProfile::Custom => config.center_size_y,
+                    _ => center,
+                };
+                let edge_y = match config.profile {
+                    FoveationProfile::H264WidthOnly => 1.0,
+                    FoveationProfile::Custom => config.edge_ratio_y,
+                    _ => edge,
+                };
                  (true, center, center_y, shift.0, shift.1, edge, edge_y,
                   config.peripheral_softness, config.blur_only)
              }
 
