new file mode 100644
index 0000000000000000000000000000000000000000..29503d43ba260d79812a6978289e67764621adf9
--- /dev/null
+++ b/shaders/idwt_cdf53v2.comp
@@ -0,0 +1,246 @@
+#version 450
+// Copyright (c) 2025 Hans-Kristian Arntzen
+// Copyright (c) 2026 Quest3-Pyrowave contributors
+// SPDX-License-Identifier: MIT
+//
+// Register-only inverse CDF 5/3 (LeGall), one level per dispatch: Decoder V2.
+// idwt.comp loads a 32x32 tile plus a 9/7-sized apron into shared memory, transposes it twice and
+// needs four workgroup barriers; on Adreno 740 that costs about 3x the pair-local Haar pass. 5/3
+// synthesis reaches only one coefficient to each side, so here each invocation rebuilds a 4x4 output
+// block (a 2x2 coefficient quad of each band) straight from the band texels around it, with no
+// shared memory, barrier or transpose. Neighbouring invocations re-fetch the overlap through the
+// texture cache instead.
+//
+// Arithmetic and FP16 rounding points follow idwt.comp at precision 1: vertical lifting, round,
+// horizontal lifting, round, store. Lifting, per dimension, for lows s and highs d of one band:
+//   s'[i] = s[i] - (d[i-1] + d[i]) / 4,  x[2i] = s'[i],  x[2i+1] = d[i] + (s'[i] + s'[i+1]) / 2
+// Boundary extension is the one idwt.comp gets from its mirrored-repeat gathers:
+//   s[N] = s[N-1],  d[-1] = d[0],  d[N] = d[N-2]   (lows never need s[-1] here).
+//
+// Bands: layer 0 = LL, 1 = high in x (HL), 2 = high in y (LH), 3 = HH.
+//
+//   FINAL         output is a decoded plane: add the DC shift and guard stores against the plane
+//                 size, which may be smaller than the aligned pyramid.
+//   PACK_OUTPUT   write 2x2 output quads, one texel each ((0,0), (1,0), (0,1), (1,1) in RGBA): four
+//                 stores per invocation instead of sixteen. RGBA8 for the final luma plane, RGBA16F
+//                 for an LL intermediate that the next level reads with PACKED_INPUT.
+//   PACKED_INPUT  every band holds 2x2 coefficient quads at half size, as wavelet_dequant.comp
+//                 writes them with PACKED (and this shader with PACK_OUTPUT for LL): 25 fetches per
+//                 invocation instead of 49.
+//   DUAL          (compile-time variant) the final 4:2:0 chroma pass rebuilds Cb (uBands) and Cr
+//                 (uBands2) together and stores them as one texel, Cb in R and Cr in G: an RG8
+//                 plane (decoder mode 4), or the right half of the packed YCbCr image (mode 5,
+//                 output_offset = (width / 2, 0)).
+//                 With PACK_OUTPUT too (mode 6), two horizontally adjacent pixels per texel,
+//                 (Cb, Cr) of the left one in RG and of the right one in BA.
+#extension GL_EXT_control_flow_attributes : require
+#if FP16
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#endif
+#if !FP16 && PRECISION == 0
+#undef PRECISION
+#define PRECISION 1
+#endif
+#if FP16 && PRECISION == 0
+#define FLOAT float16_t
+#define VEC4 f16vec4
+#else
+#define FLOAT float
+#define VEC4 vec4
+#endif
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(constant_id = 0) const bool FINAL = false;
+layout(constant_id = 1) const bool PACK_OUTPUT = false;
+layout(constant_id = 2) const bool PACKED_INPUT = false;
+
+layout(set = 0, binding = 0) uniform mediump sampler2DArray uBands;
+layout(set = 0, binding = 1) writeonly mediump uniform image2D uOutput;
+#if DUAL
+layout(set = 0, binding = 2) uniform mediump sampler2DArray uBands2;
+#endif
+
+layout(push_constant) uniform Registers
+{
+	ivec2 band_size;     // coefficients per band, also when PACKED_INPUT
+	ivec2 output_size;   // texels this pass may write, before output_offset
+	ivec2 output_offset; // added to every store (mode 5 chroma: the right half of the image)
+};
+
+FLOAT intermediate(FLOAT v)
+{
+#if PRECISION == 2
+	return v;
+#elif FP16
+	return FLOAT(float16_t(v));
+#else
+	return FLOAT(unpackHalf2x16(packHalf2x16(vec2(float(v), 0.0))).x);
+#endif
+}
+
+// Four output samples 2*i0 .. 2*i0+3 from lows s[i0..i0+2] and highs d[i0-1..i0+2].
+void synthesize(FLOAT s0, FLOAT s1, FLOAT s2, FLOAT dm, FLOAT d0, FLOAT d1, FLOAT d2, out FLOAT x[4])
+{
+	FLOAT e0 = s0 - FLOAT(0.25) * (dm + d0);
+	FLOAT e1 = s1 - FLOAT(0.25) * (d0 + d1);
+	FLOAT e2 = s2 - FLOAT(0.25) * (d1 + d2);
+	x[0] = e0;
+	x[1] = d0 + FLOAT(0.5) * (e0 + e1);
+	x[2] = e1;
+	x[3] = d1 + FLOAT(0.5) * (e1 + e2);
+}
+
+// Coefficients around the invocation's quad, G[ry + 1][rx + 1] for offsets -1..2 from 2 * quad.
+// A low dimension only uses offsets 0..2, a high one -1..2. Everything below is unrolled with
+// literal bounds so the four 4x4 arrays stay in registers.
+#define MIRROR_HIGH(v, n) ((v) < 0 ? 0 : ((v) >= (n) ? 2 * (n) - 2 - (v) : (v)))
+#define LOAD_SCALAR(G, BAND, HX, HY) \
+	[[unroll]] for (int ry = (HY) ? -1 : 0; ry <= 2; ry++) \
+		[[unroll]] for (int rx = (HX) ? -1 : 0; rx <= 2; rx++) \
+		{ \
+			int x_ = c0.x + rx, y_ = c0.y + ry; \
+			x_ = (HX) ? MIRROR_HIGH(x_, band_size.x) : min(x_, band_size.x - 1); \
+			y_ = (HY) ? MIRROR_HIGH(y_, band_size.y) : min(y_, band_size.y - 1); \
+			G[ry + 1][rx + 1] = FLOAT(texelFetch(bands, ivec3(x_, y_, BAND), 0).x); \
+		}
+// Quad offsets -1..1 hold coefficient offsets -1 (quad -1, odd), 0..1 (quad 0) and 2 (quad 1, even).
+// Edges mirror by copying rows and columns: d[-1] = d[0], d[N] = d[N-2], s[N] = s[N-1].
+#define LOAD_PACKED(G, BAND, HX, HY) \
+	[[unroll]] for (int qy = (HY) ? -1 : 0; qy <= 1; qy++) \
+		[[unroll]] for (int qx = (HX) ? -1 : 0; qx <= 1; qx++) \
+		{ \
+			vec4 t_ = texelFetch(bands, ivec3(clamp(quad + ivec2(qx, qy), ivec2(0), quads - 1), BAND), 0); \
+			[[unroll]] for (int e = 0; e < 4; e++) \
+			{ \
+				int rx = 2 * qx + (e & 1), ry = 2 * qy + (e >> 1); \
+				if (rx >= ((HX) ? -1 : 0) && rx <= 2 && ry >= ((HY) ? -1 : 0) && ry <= 2) \
+					G[ry + 1][rx + 1] = FLOAT(t_[e]); \
+			} \
+		} \
+	[[unroll]] for (int r = 0; r < 4; r++) \
+	{ \
+		if ((HX) && left) G[r][0] = G[r][1]; \
+		if (right) G[r][3] = G[r][(HX) ? 1 : 2]; \
+	} \
+	[[unroll]] for (int r = 0; r < 4; r++) \
+	{ \
+		if ((HY) && top) G[0][r] = G[1][r]; \
+		if (bottom) G[3][r] = G[(HY) ? 1 : 2][r]; \
+	}
+
+// The 4x4 output block of one component for the invocation's coefficient quad.
+void reconstruct(mediump sampler2DArray bands, ivec2 quad, FLOAT dc, out FLOAT rows[4][4])
+{
+	ivec2 c0 = 2 * quad;
+	FLOAT LL[4][4], HL[4][4], LH[4][4], HH[4][4];
+	if (PACKED_INPUT)
+	{
+		ivec2 quads = band_size >> 1;
+		bool left = c0.x == 0, top = c0.y == 0;
+		bool right = c0.x + 2 >= band_size.x, bottom = c0.y + 2 >= band_size.y;
+		LOAD_PACKED(LL, 0, false, false)
+		LOAD_PACKED(HL, 1, true, false)
+		LOAD_PACKED(LH, 2, false, true)
+		LOAD_PACKED(HH, 3, true, true)
+	}
+	else
+	{
+		LOAD_SCALAR(LL, 0, false, false)
+		LOAD_SCALAR(HL, 1, true, false)
+		LOAD_SCALAR(LH, 2, false, true)
+		LOAD_SCALAR(HH, 3, true, true)
+	}
+
+	// Vertical pass: low columns (LL over LH) and high columns (HL over HH), rows 4*quad.y .. +3.
+	FLOAT low_cols[3][4], high_cols[4][4];
+	for (int k = 0; k < 3; k++)
+	{
+		FLOAT col[4];
+		synthesize(LL[1][k + 1], LL[2][k + 1], LL[3][k + 1],
+		           LH[0][k + 1], LH[1][k + 1], LH[2][k + 1], LH[3][k + 1], col);
+		for (int r = 0; r < 4; r++)
+			low_cols[k][r] = intermediate(col[r]);
+	}
+	for (int k = 0; k < 4; k++)
+	{
+		FLOAT col[4];
+		synthesize(HL[1][k], HL[2][k], HL[3][k], HH[0][k], HH[1][k], HH[2][k], HH[3][k], col);
+		for (int r = 0; r < 4; r++)
+			high_cols[k][r] = intermediate(col[r]);
+	}
+
+	// Horizontal pass, one output row at a time.
+	for (int r = 0; r < 4; r++)
+	{
+		FLOAT x[4];
+		synthesize(low_cols[0][r], low_cols[1][r], low_cols[2][r],
+		           high_cols[0][r], high_cols[1][r], high_cols[2][r], high_cols[3][r], x);
+		for (int k = 0; k < 4; k++)
+			rows[r][k] = intermediate(x[k]) + dc;
+	}
+}
+
+void main()
+{
+	ivec2 quad = ivec2(gl_GlobalInvocationID.xy);
+	if (any(greaterThanEqual(2 * quad, band_size)))
+		return;
+
+	const FLOAT dc = FINAL ? FLOAT(0.5) : FLOAT(0.0);
+	FLOAT rows[4][4];
+	reconstruct(uBands, quad, dc, rows);
+#if DUAL
+	FLOAT rows2[4][4];
+	reconstruct(uBands2, quad, dc, rows2);
+#endif
+
+	// Workgroup-uniform: interior groups of the final plane store without per-pixel checks.
+#if DUAL
+	// Mode 6: PACK_OUTPUT stores horizontal pixel pairs.
+	ivec2 group_end = (ivec2(gl_WorkGroupID.xy) + 1) * ivec2(gl_WorkGroupSize.xy) * (PACK_OUTPUT ? ivec2(2, 4) : ivec2(4));
+#else
+	ivec2 group_end = (ivec2(gl_WorkGroupID.xy) + 1) * ivec2(gl_WorkGroupSize.xy) * (PACK_OUTPUT ? 2 : 4);
+#endif
+	bool guarded = FINAL && any(greaterThan(group_end, output_size));
+
+#if DUAL
+	if (PACK_OUTPUT)
+	{
+		// Mode 6: (Cb, Cr) of two horizontally adjacent pixels per texel, 8 stores instead of 16.
+		for (int r = 0; r < 4; r++)
+			for (int k = 0; k < 2; k++)
+			{
+				ivec2 pair = ivec2(2, 4) * quad + ivec2(k, r);
+				if (!guarded || all(lessThan(pair, output_size)))
+					imageStore(uOutput, output_offset + pair,
+							   VEC4(rows[r][2 * k], rows2[r][2 * k], rows[r][2 * k + 1], rows2[r][2 * k + 1]));
+			}
+	}
+	else
+#endif
+	if (PACK_OUTPUT)
+	{
+		for (int qy = 0; qy < 2; qy++)
+			for (int qx = 0; qx < 2; qx++)
+			{
+				ivec2 texel = 2 * quad + ivec2(qx, qy);
+				if (!guarded || all(lessThan(texel, output_size)))
+					imageStore(uOutput, output_offset + texel, VEC4(rows[2 * qy][2 * qx], rows[2 * qy][2 * qx + 1],
+					                                rows[2 * qy + 1][2 * qx], rows[2 * qy + 1][2 * qx + 1]));
+			}
+	}
+	else
+	{
+		for (int r = 0; r < 4; r++)
+			for (int k = 0; k < 4; k++)
+			{
+				ivec2 pixel = 4 * quad + ivec2(k, r);
+				if (!guarded || all(lessThan(pixel, output_size)))
+#if DUAL
+					imageStore(uOutput, output_offset + pixel, VEC4(rows[r][k], rows2[r][k], 0.0, 0.0));
+#else
+					imageStore(uOutput, output_offset + pixel, VEC4(rows[r][k]));
+#endif
+			}
+	}
+}
diff --git a/shaders/idwt_haar32.comp b/shaders/idwt_haar32.comp
new file mode 100644
index 0000000000000000000000000000000000000000..fad28e0fdbaa6720a37f20e8022f90485e469938
--- /dev/null
+++ b/shaders/idwt_haar32.comp
@@ -0,0 +1,300 @@
+#version 450
+// Copyright (c) 2025 Hans-Kristian Arntzen
+// Copyright (c) 2026 Quest3-Pyrowave contributors
+// SPDX-License-Identifier: MIT
+//
+// Multi-level inverse Haar (first written for a [3,2] split): one dispatch reconstructs one to
+// three levels.
+// Each invocation owns one root coefficient and rebuilds its subtree in registers, so there is
+// no shared memory, no workgroup barrier and no apron. Haar synthesis is pair-local, and every
+// level of the aligned wavelet pyramid is exactly twice the next coarser one, so every fetch
+// below a valid root is in bounds; only the root and, for the final plane, the stores need
+// guards. The arithmetic and FP16 rounding points are those of idwt.comp's pair-local path. On
+// Adreno 740 the decoded planes still differ from the level-by-level decoder by one code value on
+// about 1% of pixels at equal PSNR: the driver's float-to-half conversion rounds differently
+// depending on code shape (two schedules of this shader with identical arithmetic disagree too).
+//
+//   LEVELS          levels reconstructed (1 to 3), sampled from uLevel0 (coarsest) downwards.
+//   ROOT_BELOW_TOP  the root is a coefficient one level below uLevel0; its LL value is the
+//                   matching quadrant of its parent, recomputed per invocation (four cached
+//                   fetches) instead of exchanged through shared memory. Otherwise the root
+//                   is in uLevel0, whose layer 0 holds its LL value.
+//   FINAL           output is a decoded plane: add the DC shift and guard stores against the
+//                   plane size, which may be smaller than the aligned pyramid.
+//
+// The output image has no format qualifier (shaderStorageImageWriteWithoutFormat, as in
+// idwt.comp), so the same SPIR-V legally writes the R16F/R32F LL intermediates and R8 planes.
+#if FP16
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#endif
+#if !FP16 && PRECISION == 0
+#undef PRECISION
+#define PRECISION 1
+#endif
+#if FP16 && PRECISION == 0
+#define FLOAT float16_t
+#define VEC2 f16vec2
+#define VEC4 f16vec4
+#else
+#define FLOAT float
+#define VEC2 vec2
+#define VEC4 vec4
+#endif
+// DUAL (a separate program): reconstruct two components at once, the second from bindings 4-6,
+// into one two-channel output. The 4:2:0 chroma final pass writes Cb and Cr as one RG8 plane, half
+// the stores of two R8 planes. ELEM is one value per component.
+#if DUAL
+#define ELEM VEC2
+#else
+#define ELEM FLOAT
+#endif
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(constant_id = 0) const int LEVELS = 2;
+layout(constant_id = 1) const bool ROOT_BELOW_TOP = false;
+layout(constant_id = 2) const bool FINAL = false;
+// Cost probe (PYROWAVE_HAAR32_PROBE, never a decode mode): 1 drops the stores unless a value is
+// impossible, 2 replaces band fetches by values derived from the coordinate, 3 drops only the
+// scalar final-plane stores (the 4:2:0 chroma planes in mode 3).
+layout(constant_id = 3) const int PROBE = 0;
+// Bit i set: binding i holds quad-packed coefficients (RGBA = the 2x2 quad (0,0), (1,0), (0,1),
+// (1,1) of one band, at half the level's size), as wavelet_dequant.comp writes them with PACKED.
+layout(constant_id = 4) const int PACKED = 0;
+// The output holds 2x2 quads in the same order, one per texel: the RGBA8 luma plane at half size
+// for the final pass, or a quad-packed LL slot (RGBA16F) for the next pass. A two-level invocation
+// writes four texels instead of sixteen values, a one-level invocation one texel instead of four.
+layout(constant_id = 5) const bool PACK_OUTPUT = false;
+
+layout(set = 0, binding = 0) uniform mediump sampler2DArray uLevel0;
+layout(set = 0, binding = 1) uniform mediump sampler2DArray uLevel1;
+layout(set = 0, binding = 2) uniform mediump sampler2DArray uLevel2;
+layout(set = 0, binding = 3) writeonly mediump uniform image2D uOutput;
+#if DUAL
+layout(set = 0, binding = 4) uniform mediump sampler2DArray uLevel0B;
+layout(set = 0, binding = 5) uniform mediump sampler2DArray uLevel1B;
+layout(set = 0, binding = 6) uniform mediump sampler2DArray uLevel2B;
+#endif
+
+layout(push_constant) uniform Registers
+{
+	ivec2 root_size;
+	ivec2 output_size;
+	// Added to every final-plane store (mode 5 places both planes in one image); bounds checks use
+	// the unshifted coordinate.
+	ivec2 output_offset;
+};
+
+ELEM haar_intermediate(ELEM v)
+{
+#if PRECISION == 2
+	return v;
+#elif FP16
+	return v;
+#elif DUAL
+	return unpackHalf2x16(packHalf2x16(v));
+#else
+	return FLOAT(unpackHalf2x16(packHalf2x16(vec2(float(v), 0.0))).x);
+#endif
+}
+
+vec4 fetch_plane(int plane, int level, ivec2 coord, int band)
+{
+	if (PROBE == 2 && band != 0)
+		return vec4(float((coord.x ^ coord.y) & 7) * 0.125);
+#if DUAL
+	if (plane != 0)
+	{
+		if (level == 0)
+			return texelFetch(uLevel0B, ivec3(coord, band), 0);
+		else if (level == 1)
+			return texelFetch(uLevel1B, ivec3(coord, band), 0);
+		else
+			return texelFetch(uLevel2B, ivec3(coord, band), 0);
+	}
+#endif
+	if (level == 0)
+		return texelFetch(uLevel0, ivec3(coord, band), 0);
+	else if (level == 1)
+		return texelFetch(uLevel1, ivec3(coord, band), 0);
+	else
+		return texelFetch(uLevel2, ivec3(coord, band), 0);
+}
+
+bool packed(int level)
+{
+	return ((PACKED >> level) & 1) != 0;
+}
+
+// One coefficient. A packed level holds it in the quad at coord / 2.
+FLOAT fetch_one(int plane, int level, ivec2 coord, int band)
+{
+	if (!packed(level))
+		return FLOAT(fetch_plane(plane, level, coord, band).x);
+	vec4 quad = fetch_plane(plane, level, coord >> 1, band);
+	return FLOAT(quad[(coord.x & 1) | ((coord.y & 1) << 1)]);
+}
+
+ELEM fetch(int level, ivec2 coord, int band)
+{
+#if DUAL
+	return ELEM(fetch_one(0, level, coord, band), fetch_one(1, level, coord, band));
+#else
+	return fetch_one(0, level, coord, band);
+#endif
+}
+
+// The four coefficients 2 * quad + (i & 1, i >> 1): one texel when packed.
+void fetch_quad_one(int plane, int level, ivec2 quad, int band, out FLOAT v[4])
+{
+	if (packed(level))
+	{
+		vec4 t = fetch_plane(plane, level, quad, band);
+		v[0] = FLOAT(t.x); v[1] = FLOAT(t.y); v[2] = FLOAT(t.z); v[3] = FLOAT(t.w);
+	}
+	else
+	{
+		for (int i = 0; i < 4; i++)
+			v[i] = FLOAT(fetch_plane(plane, level, 2 * quad + ivec2(i & 1, i >> 1), band).x);
+	}
+}
+
+void fetch_quad(int level, ivec2 quad, int band, out ELEM v[4])
+{
+#if DUAL
+	FLOAT a[4], b[4];
+	fetch_quad_one(0, level, quad, band, a);
+	fetch_quad_one(1, level, quad, band, b);
+	for (int i = 0; i < 4; i++)
+		v[i] = ELEM(a[i], b[i]);
+#else
+	fetch_quad_one(0, level, quad, band, v);
+#endif
+}
+
+// One 2x2 synthesis, as in idwt.comp's inverse_haar_pairs: vertical, round, horizontal, round.
+// q[0] = (0,0), q[1] = (1,0), q[2] = (0,1), q[3] = (1,1).
+void synthesize_values(ELEM a, ELEM horizontal, ELEM vertical, ELEM diagonal, out ELEM q[4])
+{
+	ELEM low_even = a - FLOAT(0.5) * vertical;
+	ELEM low_odd = low_even + vertical;
+	ELEM high_even = horizontal - FLOAT(0.5) * diagonal;
+	ELEM high_odd = high_even + diagonal;
+	low_even = haar_intermediate(low_even);
+	low_odd = haar_intermediate(low_odd);
+	high_even = haar_intermediate(high_even);
+	high_odd = haar_intermediate(high_odd);
+	ELEM even_even = low_even - FLOAT(0.5) * high_even;
+	ELEM even_odd = low_odd - FLOAT(0.5) * high_odd;
+	q[0] = haar_intermediate(even_even);
+	q[1] = haar_intermediate(even_even + high_even);
+	q[2] = haar_intermediate(even_odd);
+	q[3] = haar_intermediate(even_odd + high_odd);
+}
+
+void synthesize(ELEM a, int level, ivec2 coord, out ELEM q[4])
+{
+	synthesize_values(a, fetch(level, coord, 1), fetch(level, coord, 2), fetch(level, coord, 3), q);
+}
+
+void store(ivec2 pixel, ELEM value, bool guarded)
+{
+	if (FINAL)
+		value += FLOAT(0.5);
+#if DUAL
+	if ((PROBE == 1 || (PROBE == 3 && FINAL)) && value.x != FLOAT(-12345.0))
+		return;
+	if (!guarded || all(lessThan(pixel, output_size)))
+		imageStore(uOutput, pixel + output_offset, VEC4(value, FLOAT(0.0), FLOAT(0.0)));
+#else
+	if ((PROBE == 1 || (PROBE == 3 && FINAL)) && value != FLOAT(-12345.0))
+		return;
+	if (!guarded || all(lessThan(pixel, output_size)))
+		imageStore(uOutput, pixel + output_offset, VEC4(value));
+#endif
+}
+
+// DUAL with PACK_OUTPUT (mode 6): the pixel quad at texel goes out as two texels of horizontal
+// pixel pairs, (Cb, Cr) of the left pixel in RG and of the right one in BA.
+void store_quad(ivec2 texel, ELEM q[4], bool guarded)
+{
+#if DUAL
+	for (int row = 0; row < 2; row++)
+	{
+		ivec2 pair = ivec2(texel.x, 2 * texel.y + row);
+		VEC4 value = VEC4(q[2 * row], q[2 * row + 1]) + VEC4(FINAL ? 0.5 : 0.0);
+		if ((PROBE == 1 || (PROBE == 3 && FINAL)) && value.x != FLOAT(-12345.0))
+			continue;
+		if (!guarded || all(lessThan(pair, output_size)))
+			imageStore(uOutput, pair + output_offset, value);
+	}
+#else
+	VEC4 value = VEC4(q[0], q[1], q[2], q[3]) + VEC4(FINAL ? 0.5 : 0.0);
+	if (PROBE == 1 && value.x != FLOAT(-12345.0))
+		return;
+	if (!guarded || all(lessThan(texel, output_size)))
+		imageStore(uOutput, texel + output_offset, value);
+#endif
+}
+
+void main()
+{
+	ivec2 root = ivec2(gl_GlobalInvocationID.xy);
+	if (any(greaterThanEqual(root, root_size)))
+		return;
+
+	const int first = ROOT_BELOW_TOP ? 1 : 0;
+	const int depth = LEVELS - first;
+	// Workgroup-uniform: interior groups of the final plane store without per-pixel checks.
+	// output_size counts texels, which are 2x2 pixel quads when PACK_OUTPUT (horizontal pairs
+	// when DUAL too).
+#if DUAL
+	ivec2 shift = PACK_OUTPUT ? ivec2(depth - 1, depth) : ivec2(depth);
+#else
+	ivec2 shift = ivec2(PACK_OUTPUT ? depth - 1 : depth);
+#endif
+	ivec2 group_end = ((ivec2(gl_WorkGroupID.xy) + 1) * ivec2(gl_WorkGroupSize.xy)) << shift;
+	bool guarded = FINAL && any(greaterThan(group_end, output_size));
+
+	ELEM a;
+	if (ROOT_BELOW_TOP)
+	{
+		ELEM parent[4];
+		synthesize(fetch(0, root >> 1, 0), 0, root >> 1, parent);
+		int quadrant = (root.x & 1) | ((root.y & 1) << 1);
+		a = parent[quadrant];
+	}
+	else
+		a = fetch(0, root, 0);
+
+	ELEM children[4];
+	synthesize(a, first, root, children);
+	if (depth == 1)
+	{
+		// The root's four children are the quad at root.
+		if (PACK_OUTPUT)
+		{
+			store_quad(root, children, guarded);
+			return;
+		}
+		for (int i = 0; i < 4; i++)
+			store(2 * root + ivec2(i & 1, i >> 1), children[i], guarded);
+		return;
+	}
+
+	// The children's bands form the quad at root of the next level.
+	ELEM horizontal[4], vertical[4], diagonal[4];
+	fetch_quad(first + 1, root, 1, horizontal);
+	fetch_quad(first + 1, root, 2, vertical);
+	fetch_quad(first + 1, root, 3, diagonal);
+	for (int i = 0; i < 4; i++)
+	{
+		ivec2 child = 2 * root + ivec2(i & 1, i >> 1);
+		ELEM pixels[4];
+		synthesize_values(children[i], horizontal[i], vertical[i], diagonal[i], pixels);
+		if (PACK_OUTPUT)
+			store_quad(child, pixels, guarded);
+		else
+			for (int j = 0; j < 4; j++)
+				store(2 * child + ivec2(j & 1, j >> 1), pixels[j], guarded);
+	}
+}
