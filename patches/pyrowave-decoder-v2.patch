+bool Decoder::Impl::idwt_haar32(CommandBuffer &cmd, const ViewBuffers &views)
+{
+	// A packed luma plane is RGBA8 at half size; anything else would be written out of bounds.
+	if (present_output)
+	{
+		for (int i = 0; i < 2; i++)
+			if (views.planes[i]->get_format() != VK_FORMAT_R8G8B8A8_UNORM ||
+			    int(views.planes[i]->get_view_width()) != present_width() || int(views.planes[i]->get_view_height()) * 2 != height)
+			{
+				LOGE("Present output needs RGBA8 planes 0-1 of %d x height/2.\n", present_width());
+				return false;
+			}
+	}
+	else if (packed_luma_output &&
+	    (views.planes[0]->get_format() != VK_FORMAT_R8G8B8A8_UNORM ||
+	     int(views.planes[0]->get_view_width()) * 2 != width || int(views.planes[0]->get_view_height()) * 2 != height))
+	{
+		LOGE("Packed luma output needs an RGBA8 plane of half the frame size.\n");
+		return false;
+	}
+	if (dual_chroma_output && !present_output && views.planes[1]->get_format() != VK_FORMAT_R8G8_UNORM)
+	{
+		LOGE("Dual chroma output needs an RG8 plane 1.\n");
+		return false;
+	}
+	const int precision = Configuration::get().get_precision();
+	cmd.enable_subgroup_size_control(false);
+	auto start_idwt = cmd.write_timestamp(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+
+	struct
+	{
+		ivec2 root_size;
+		ivec2 output_size;
+		ivec2 output_offset;
+	} push = {};
+
+	// Each pass reconstructs `levels` levels from `top` downwards and ends in an LL intermediate or,
+	// for the last pass, the decoded plane. Luma splits [2,3] (top levels 4 and 2); 4:2:0 chroma has
+	// no level-0 bands and splits [1,3] (top levels 4 and 3). On Quest 3 at 4160x2208 these beat
+	// [3,2]/[2,2] by about 0.13 ms: the heavy bottom levels gain most from staying in registers.
+	// PYROWAVE_HAAR32_LUMA / _CHROMA override the split (level counts, each 1-3) for tuning.
+	auto schedule = [](const char *name, std::vector<int> fallback, int total) {
+		const char *value = getenv(name);
+		if (!value)
+			return fallback;
+		std::vector<int> counts;
+		int sum = 0;
+		for (const char *c = value; *c; c++)
+			if (*c >= '1' && *c <= '3')
+			{
+				counts.push_back(*c - '0');
+				sum += *c - '0';
+			}
+		return sum == total ? counts : fallback;
+	};
+	// Quad-packed levels 0-1 have no scalar LL slot, so the packed mode keeps the default split.
+	const std::vector<int> luma_passes =
+	    quad_packed ? std::vector<int>{ 2, 3 } : schedule("PYROWAVE_HAAR32_LUMA", { 2, 3 }, DecompositionLevels);
+	const std::vector<int> chroma_passes =
+	    quad_packed ? std::vector<int>{ 1, 3 } : schedule("PYROWAVE_HAAR32_CHROMA", { 1, 3 }, DecompositionLevels - 1);
+	const size_t pass_count = std::max(luma_passes.size(), chroma_passes.size());
+
+	for (size_t pass = 0; pass < pass_count; pass++)
+	{
+		cmd.set_specialization_constant_mask(63);
+		cmd.set_specialization_constant(3, haar32_probe);
+		for (int c = 0; c < NumComponents; c++)
+		{
+			const bool subsampled = chroma == ChromaSubsampling::Chroma420 && c != 0;
+			const std::vector<int> &passes = subsampled ? chroma_passes : luma_passes;
+			if (pass >= passes.size())
+				continue;
+			const bool dual = dual_chroma_output && subsampled && pass + 1 == passes.size();
+			// The dual pass for component 1 also reconstructs component 2.
+			if (dual && c == 2)
+				continue;
+			cmd.set_program(shaders.idwt_haar32[precision][dual ? 1 : 0]);
+			int top = DecompositionLevels - 1;
+			for (size_t i = 0; i < pass; i++)
+				top -= passes[i];
+			const int levels = passes[pass];
+			const bool final_pass = pass + 1 == passes.size();
+			// A three-level pass recomputes each root's top-level parent instead of sharing it, which
+			// gives four times the invocations on the tiny top level.
+			const bool root_below_top = levels == 3;
+			const int root_level = root_below_top ? top - 1 : top;
+			const int bottom = top - levels + 1;
+
+			int packed_bindings = 0;
+			for (int i = 0; i < 3; i++)
+			{
+				// Unused bindings still need a valid view; repeat the last level.
+				const int level = std::max(top - i, bottom);
+				cmd.set_texture(0, i, band_view(c, level), *mirror_repeat_sampler);
+				if (dual)
+					cmd.set_texture(0, 4 + i, band_view(2, level), *mirror_repeat_sampler);
+				if (quad_packed && level < packed_levels)
+					packed_bindings |= 1 << i;
+			}
+			cmd.set_specialization_constant(4, packed_bindings);
+
+			push.root_size.x = int(component_layer_views[c][root_level]->get_view_width());
+			push.root_size.y = int(component_layer_views[c][root_level]->get_view_height());
+			// A packed next level takes this pass's LL as quads in its layer 0.
+			const bool packed_ll = !final_pass && quad_packed && bottom - 1 < packed_levels;
+			const ImageView &output = final_pass ? *views.planes[c] :
+			                          packed_ll ? *packed_ll_views[c][bottom - 1] :
+			                                      *component_ll_views[c][bottom - 1];
+			const bool pack_output = packed_ll || (final_pass && c == 0 && packed_luma_output);
+			cmd.set_specialization_constant(5, pack_output);
+			cmd.set_storage_texture(0, 3, output);
+			push.output_size.x = int(output.get_view_width());
+			push.output_size.y = int(output.get_view_height());
+			push.output_offset = ivec2(0);
+			if (final_pass && present_output)
+			{
+				// Luma quads on the left, then one chroma pixel per texel.
+				push.output_size = ivec2(width / 2, height / 2);
+				if (c != 0)
+					push.output_offset.x = width / 2;
+			}
+
+			cmd.set_specialization_constant(0, levels);
+			cmd.set_specialization_constant(1, root_below_top);
+			cmd.set_specialization_constant(2, final_pass);
+			cmd.push_constants(&push, 0, sizeof(push));
+
+			char label[64];
+			snprintf(label, sizeof(label), "iDWT multilevel pass %d, component %d", int(pass), c);
+			cmd.begin_region(label);
+			cmd.dispatch((push.root_size.x + 7) / 8, (push.root_size.y + 7) / 8, 1);
+			cmd.end_region();
+		}
+		cmd.set_specialization_constant_mask(0);
+		cmd.barrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+		            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+	}
+
+	auto end_idwt = cmd.write_timestamp(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+	device->register_time_interval("GPU", std::move(start_idwt), std::move(end_idwt), "iDWT");
+	return true;
+}
+
+bool Decoder::Impl::idwt_cdf53v2(CommandBuffer &cmd, const ViewBuffers &views)
+{
+	// The same output layouts as haar32 modes 3-5.
+	if (present_output)
+	{
+		for (int i = 0; i < 2; i++)
+			if (views.planes[i]->get_format() != VK_FORMAT_R8G8B8A8_UNORM ||
+				int(views.planes[i]->get_view_width()) != present_width() || int(views.planes[i]->get_view_height()) * 2 != height)
+			{
+				LOGE("Present output needs RGBA8 planes 0-1 of %d x height/2.\n", present_width());
+				return false;
+			}
+	}
+	else if (packed_luma_output &&
+		(views.planes[0]->get_format() != VK_FORMAT_R8G8B8A8_UNORM ||
+		 int(views.planes[0]->get_view_width()) * 2 != width || int(views.planes[0]->get_view_height()) * 2 != height))
+	{
+		LOGE("Packed luma output needs an RGBA8 plane of half the frame size.\n");
+		return false;
+	}
+	if (dual_chroma_output && !present_output && views.planes[1]->get_format() != VK_FORMAT_R8G8_UNORM)
+	{
+		LOGE("Dual chroma output needs an RG8 plane 1.\n");
+		return false;
+	}
+	const int precision = Configuration::get().get_precision();
+	cmd.enable_subgroup_size_control(false);
+	auto start_idwt = cmd.write_timestamp(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+
+	struct
+	{
+		ivec2 band_size;
+		ivec2 output_size;
+		ivec2 output_offset;
+	} push = {};
+
+	// PYROWAVE_V2_LEVEL_TIMES=1 adds one GPU interval per level ("iDWT L<n>") for profiling.
+	const bool level_times = getenv("PYROWAVE_V2_LEVEL_TIMES");
+	QueryPoolHandle level_start = level_times ? cmd.write_timestamp(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT) : QueryPoolHandle{};
+	const bool dispatch_times = level_times && atoi(getenv("PYROWAVE_V2_LEVEL_TIMES")) == 2;
+	QueryPoolHandle dispatch_start = dispatch_times ? cmd.write_timestamp(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT) : QueryPoolHandle{};
+
+	for (int input_level = DecompositionLevels - 1; input_level >= 0; input_level--)
+	{
+		cmd.set_specialization_constant_mask(7);
+		for (int c = 0; c < NumComponents; c++)
+		{
+			const bool subsampled = chroma == ChromaSubsampling::Chroma420 && c != 0;
+			// 4:2:0 chroma has no level-0 bands; its level-1 synthesis writes the plane.
+			if (subsampled && input_level == 0)
+				continue;
+			const bool final_pass = input_level == (subsampled ? 1 : 0);
+			// Modes 4-5: one pass reconstructs both chroma components (component 1 does it).
+			const bool dual = dual_chroma_output && subsampled && final_pass;
+			if (dual && c == 2)
+				continue;
+			cmd.set_program(shaders.idwt_cdf53v2[precision][dual ? 1 : 0]);
+			// Mode 3: levels 0-1 are quad-packed, including the LL slot this pass writes for level 0-1.
+			const bool packed_ll = !final_pass && quad_packed && input_level - 1 < packed_levels;
+			const ImageView &output = final_pass ? *views.planes[c] :
+			                          packed_ll ? *packed_ll_views[c][input_level - 1] :
+			                                      *component_ll_views[c][input_level - 1];
+			const bool pack_output = packed_ll || (final_pass && c == 0 && packed_luma_output);
+			cmd.set_texture(0, 0, band_view(c, input_level), *mirror_repeat_sampler);
+			if (dual)
+				cmd.set_texture(0, 2, band_view(2, input_level), *mirror_repeat_sampler);
+			cmd.set_storage_texture(0, 1, output);
+			cmd.set_specialization_constant(0, final_pass);
+			cmd.set_specialization_constant(1, pack_output);
+			cmd.set_specialization_constant(2, quad_packed && input_level < packed_levels);
+			push.band_size.x = int(component_layer_views[c][input_level]->get_view_width());
+			push.band_size.y = int(component_layer_views[c][input_level]->get_view_height());
+			push.output_size.x = int(output.get_view_width());
+			push.output_size.y = int(output.get_view_height());
+			push.output_offset = ivec2(0);
+			if (final_pass && present_output)
+			{
+				// Luma quads on the left, then one chroma pixel per texel.
+				push.output_size = ivec2(width / 2, height / 2);
+				if (c != 0)
+					push.output_offset.x = width / 2;
+			}
+			cmd.push_constants(&push, 0, sizeof(push));
+
+			char label[64];
+			snprintf(label, sizeof(label), "iDWT 5/3 v2 level %d, component %d", input_level, c);
+			cmd.begin_region(label);
+			// One invocation per 2x2 coefficient quad, 8x8 invocations per group.
