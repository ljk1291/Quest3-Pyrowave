+/* Q3PW: Haar 4:2:0 compute path. enabled=1 reconstructs the inverse transform in two dispatches per
+ * plane, luma levels [2,3] and 4:2:0 chroma levels [1,3], with the same arithmetic and FP16 rounding
+ * points as the default level-by-level path. Adreno's float-to-half conversion is not bit-stable
+ * across shaders, so planes can differ from the default path by one code value on about 1% of
+ * pixels at equal PSNR. enabled=2 also stores levels 0-3 quad-packed (RGBA16F, one 2x2 quad of a
+ * band per texel; precision 1 only), which only this pass can read. enabled=3 additionally writes
+ * luma as an RGBA8_UNORM plane of half width and height, each texel one 2x2 pixel quad ((0,0),
+ * (1,0), (0,1), (1,1) in RGBA); the caller must pass such a plane and unpack it. enabled=4 is
+ * enabled=3 that also writes both 4:2:0 chroma planes into plane 1 as R8G8_UNORM (Cb in R, Cr in G);
+ * plane 2 must still be a valid image and is not written. enabled=5 is enabled=4 with planes 0 and 1
+ * both views of one RGBA8_UNORM image of width x height/2 (frame width and height divisible by 4):
+ * the packed luma quads fill x < width/2 and chroma fills x >= width/2, one pixel per texel with Cb
+ * in R, Cr in G and 0 in B and A, so a consumer can bilinear-filter chroma in hardware. Refused (PYROWAVE_ERROR_NOT_IMPLEMENTED, unchanged) for
+ * CDF wavelets, 4:4:4, the fragment path, PYROWAVE_FUSED_HAAR. Default 0. */
+PYROWAVE_PUBLIC_API pyrowave_result pyrowave_decoder_set_haar32(pyrowave_decoder decoder, int enabled);
+
+/* Q3PW Decoder V2: register-only inverse CDF 5/3, one dispatch per level and component with no shared
+ * memory or workgroup barriers. Same lifting and FP16 rounding points as the default 5/3 path, so
+ * planes match it to within one code value. mode=2 additionally writes luma as an RGBA8_UNORM plane
+ * of half width and height, each texel one 2x2 pixel quad ((0,0), (1,0), (0,1), (1,1) in RGBA), as
+ * pyrowave_decoder_set_haar32(3) does; mode=3 also stores levels 0-3 quad-packed (RGBA16F, precision 1
+ * only), as pyrowave_decoder_set_haar32(2) does. mode=4 and mode=5 add the 4:2:0 chroma outputs of
+ * pyrowave_decoder_set_haar32(4) and (5): Cb and Cr together in an R8G8_UNORM plane 1, or the packed
+ * YCbCr layout (planes 0 and 1 both views of one RGBA8_UNORM image of width x height/2, luma quads at
+ * x < width/2, Cb/Cr per texel at x >= width/2; width and height divisible by 4). Refused (PYROWAVE_ERROR_NOT_IMPLEMENTED, unchanged) unless the
+ * decoder is CDF 5/3 on the compute path with fast53 disabled. Default 0.
+ * Set only while idle. PYROWAVE_V2_PACKED_LEVELS=2 restricts packing to levels 0-1;
+ * otherwise levels 0-3 are packed. Modes outside 0..5 are rejected. */
+PYROWAVE_PUBLIC_API pyrowave_result pyrowave_decoder_set_cdf53v2(pyrowave_decoder decoder, int mode);
 
