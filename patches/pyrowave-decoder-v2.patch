+        return;
+    }
+    for (int j = 0; j < 2; j++)
+        for (int i = 0; i < 4; i++)
+            imageStore(uDequantImg, ivec3(coord + ivec2(i, j), layer), vec4(v[j][i]));
+}
+
 
