 }
diff --git a/shaders/wavelet_quant.comp b/shaders/wavelet_quant.comp
index 70794e754d478a1accb1198cf06d4c4a8cfe0d7e..b3a248d16d87cfa959e286cbfe55ca489d8d63fa 100644
