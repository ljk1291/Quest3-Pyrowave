new file mode 100644
index 0000000000000000000000000000000000000000..e862a4a76b8736d34374f20540b7ff56a77ddb62
--- /dev/null
+++ b/alvr/graphics/resources/direct_eye_foveation.glsl
@@ -0,0 +1,40 @@
+// MIT: ALVR v20.13.0 inverse, translated from this fork's stream.wgsl.
+// Shader injection mechanism adapted from JMS1717/Quest3-Pyrowave
+// 2de8ad13973ed9c3a8e72f4c85a79e1e7e5d085a. WO-8 geometry is unchanged.
+uniform highp int view_idx;
+uniform vec2 ffe_expanded;
+uniform vec2 ffe_packed;
+uniform vec2 ffe_view_ratio;
+uniform vec2 ffe_edge_ratio;
+uniform vec2 ffe_c2;
+// Exactly the four vec4s for the current eye in WGSL FfeParams.
+uniform vec4 ffe_p[4];
+
+vec2 direct_foveated_uv(vec2 stereo_uv) {
+    vec2 corrected_uv = vec2(stereo_uv.x * 2.0 - float(view_idx), stereo_uv.y);
+    vec2 c1 = ffe_p[0].xy;
+    vec2 lo_bound = ffe_p[0].zw;
+    vec2 hi_bound = ffe_p[1].xy;
+    vec2 a_left = ffe_p[1].zw;
+    vec2 b_left = ffe_p[2].xy;
+    vec2 a_right = ffe_p[2].zw;
+    vec2 b_right = ffe_p[3].xy;
+    vec2 c_right = ffe_p[3].zw;
+    if (view_idx == 1) corrected_uv.x = 1.0 - corrected_uv.x;
+    vec2 intercept_px = c1 * ffe_expanded;
+    vec2 sample_phase_px = floor(intercept_px + vec2(0.5 - 1e-4)) - intercept_px;
+    corrected_uv -= sample_phase_px / ffe_expanded;
+    vec2 center = (corrected_uv - c1) * ffe_edge_ratio / ffe_c2;
+    vec2 left_edge = (-b_left + sqrt(b_left * b_left + 4.0 * a_left * corrected_uv)) / (2.0 * a_left);
+    vec2 right_edge = (-b_right + sqrt(b_right * b_right - 4.0 * (c_right - a_right * corrected_uv))) / (2.0 * a_right);
+    corrected_uv = vec2(
+        corrected_uv.x < lo_bound.x ? left_edge.x : (corrected_uv.x > hi_bound.x ? right_edge.x : center.x),
+        corrected_uv.y < lo_bound.y ? left_edge.y : (corrected_uv.y > hi_bound.y ? right_edge.y : center.y));
+    corrected_uv *= ffe_view_ratio;
+    if (view_idx == 1) corrected_uv.x = 1.0 - corrected_uv.x;
+    // WGSL samples separate clamp-to-edge eye textures. Match those bounds
+    // before converting back to SBS, including padding and the stereo seam.
+    vec2 half_texel = 0.5 / ffe_packed;
+    corrected_uv = clamp(corrected_uv, half_texel, vec2(1.0) - half_texel);
+    return vec2((corrected_uv.x + float(view_idx)) * 0.5, corrected_uv.y);
+}
