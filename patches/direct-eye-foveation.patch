+            view_ratio: pair("VIEW_WIDTH_RATIO", "VIEW_HEIGHT_RATIO"),
+            edge_ratio: pair("EDGE_X_RATIO", "EDGE_Y_RATIO"),
+            c2: pair("C2_X", "C2_Y"), params: [params; 2] }
+    }
+
+    pub fn valid(&self) -> bool {
+        self.packed.x > 0 && self.packed.y > 0
+            && self.view_ratio.iter().chain(&self.edge_ratio).chain(&self.c2)
+                .chain(self.params.iter().flatten()).all(|v| v.is_finite())
+    }
+}
