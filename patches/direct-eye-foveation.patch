+impl DirectEyeFoveation {
+    pub fn new(expanded: UVec2, config: alvr_session::FoveatedEncodingConfig) -> Self {
+        let (packed, constants) = super::stream::foveated_encoding_shader_constants(expanded, config.clone());
+        let pair = |x: &str, y: &str| [constants[x] as f32, constants[y] as f32];
