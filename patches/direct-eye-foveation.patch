+    #[test]
+    fn software_gles_direct_ffe_matches_production_wgsl_spatial_both_eyes_and_center_update() {
+        assert_eq!(std::env::var("LIBGL_ALWAYS_SOFTWARE").as_deref(), Ok("1"));
+        let context = Rc::new(GraphicsContext::new_gl());
+        assert_eq!(context.adapter.get_info().device_type, wgpu::DeviceType::Cpu);
+        let gl = &context.gl_context;
+        let version = unsafe { gl.get_parameter_string(glow::VERSION) };
+        assert!(version.starts_with("OpenGL ES"), "external-image regression requires real GLES, got {version}");
+        // Includes a half-texel Light phase, unequal axes and allocation padding.
+        let expanded = UVec2::new(176, 160);
+        for profile in [FoveationProfile::Light, FoveationProfile::Medium, FoveationProfile::H264Fit] {
+          for format in [glow::RGBA8, glow::SRGB8_ALPHA8] {
+            let cfg = config(profile.clone());
+            let (packed, _) = foveated_encoding_shader_constants(expanded, cfg.clone());
+            unsafe {
+                context.make_current();
+                let staging_targets = [texture(gl, expanded.x, expanded.y, format, None),
+                    texture(gl, expanded.x, expanded.y, format, None)];
+                let direct_targets = [texture(gl, expanded.x, expanded.y, format, None),
+                    texture(gl, expanded.x, expanded.y, format, None)];
+                let make_renderer = |targets: [glow::Texture; 2]| StreamRenderer::new(
+                    Rc::clone(&context), expanded, expanded,
+                    [vec![targets[0].0.get()], vec![targets[1].0.get()]], format, Some(cfg.clone()),
+                    format == glow::SRGB8_ALPHA8, false, 1.0, None);
+                let mut staging = make_renderer(staging_targets);
+                staging.set_import_copy_sync(true);
+                staging.set_staging_initialization(true);
+                staging.set_staging_isolation(true);
+                let mut direct = make_renderer(direct_targets);
+                direct.set_import_copy_sync(true);
+                // Explicit off control: a requested plain copy cannot warp FFE.
+                direct.set_direct_eye_copy(true, true, false, 0, false, false, false, Some(&cfg));
+                assert!(!direct.direct_eye_enabled);
+                direct.set_direct_eye_copy(true, true, false, 0, false, false, true, Some(&cfg));
+                assert!(direct.direct_eye_enabled, "profile={profile:?} format={format}");
+                for frame in 0..3u32 {
+                    // The actual StreamRenderer update entry point writes BOTH paths.
+                    // Frame 2 is a repeat of frame 1's centre; no local gaze derivation.
+                    if frame < 2 {
+                        let shifts = if frame == 0 { [glam::Vec2::ZERO; 2] } else {
+                            [glam::vec2(0.21, -0.17), glam::vec2(-0.23, 0.19)]
+                        };
+                        staging.set_foveation_center(shifts);
+                        direct.set_foveation_center(shifts);
+                        let stored = direct.direct_eye_renderer.as_ref().unwrap().ffe_params_for_test();
+                        assert_eq!(stored, [foveated_encoding_dynamic_params(expanded, cfg.clone(), shifts[0]),
+                            foveated_encoding_dynamic_params(expanded, cfg.clone(), shifts[1])]);
+                        if frame == 1 { assert_ne!(stored[0], stored[1]); }
+                    }
+                    context.make_current();
+                    let mut pixels = Vec::new();
+                    for y in 0..packed.y { for x in 0..packed.x * 2 {
+                        let eye = x / packed.x;
+                        let px = x % packed.x;
+                        // Smooth gradients, one-texel lines, asymmetric per-eye
+                        // structure, every edge/seam and changing frame content.
+                        let r = 32 + (px * 160 / packed.x) as u8;
+                        let g = 32 + (y * 160 / packed.y) as u8;
+                        let b = if (px + eye * 5 + frame * 3) % 13 == 0 || y % 17 == eye {
+                            224
+                        } else { 48 + (eye * 96 + frame * 12) as u8 };
+                        pixels.extend_from_slice(&[r, g, b, 255]);
+                    }}
+                    let source = texture(gl, packed.x * 2, packed.y, glow::RGBA8, Some(&pixels));
+                    gl.bind_texture(glow::TEXTURE_2D, None);
+                    gl.finish();
+                    let attrs = super::super::image_import_attributes(true).unwrap();
+                    let image = (context.create_image)(context.egl_display.as_ptr(), context.egl_context.as_ptr(),
+                        0x30B1, source.0.get() as usize as *mut _, attrs.as_ptr());
+                    assert!(!image.is_null());
+                    staging.staging_renderer.render_egl_image_for_test(image);
+                    let fov = Fov { left: -0.7, right: 0.7, up: 0.7, down: -0.7 };
+                    staging.render(ptr::null_mut(), [
+                        StreamViewParams { swapchain_index: 0, reprojection_rotation: Quat::IDENTITY, fov },
+                        StreamViewParams { swapchain_index: 0, reprojection_rotation: Quat::IDENTITY, fov }], None);
+                    context.make_current();
+                    direct.direct_eye_renderer.as_ref().unwrap().render_egl_image_for_test(image);
+                    for eye in 0..2 {
+                        let reference = read_eye(&context, staging_targets[eye], expanded);
+                        let actual = read_eye(&context, direct_targets[eye], expanded);
+                        assert!(reference.chunks_exact(4).any(|p| p[0] > 100 && p[1] > 100),
+                            "spatial reference must be populated");
+                        for (index, (a, b)) in actual.iter().zip(&reference).enumerate() {
+                            assert!((i16::from(*a) - i16::from(*b)).abs() <= 2,
+                                "profile={profile:?} format={format} frame={frame} eye={eye} x={} y={} channel={} direct={a} wgsl={b}",
+                                index / 4 % expanded.x as usize, index / 4 / expanded.x as usize, index % 4);
+                        }
+                        // The explicit flip control must change this asymmetric image.
+                        assert_ne!(&actual[..expanded.x as usize * 4],
+                            &actual[actual.len() - expanded.x as usize * 4..]);
+                    }
+                    (context.destroy_image)(context.egl_display.as_ptr(), image);
+                    gl.delete_texture(source);
+                }
+                drop(direct); drop(staging);
+                context.make_current();
+                for target in staging_targets.into_iter().chain(direct_targets) { gl.delete_texture(target); }
+            }
+          }
+        }
+    }
+
+}
