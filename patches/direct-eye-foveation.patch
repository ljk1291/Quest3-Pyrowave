+    unsafe fn read_eye(context: &GraphicsContext, target: glow::Texture, size: UVec2) -> Vec<u8> {
+        context.make_current();
+        let gl = &context.gl_context;
+        let fbo = gl.create_framebuffer().unwrap();
+        gl.bind_framebuffer(glow::READ_FRAMEBUFFER, Some(fbo));
+        gl.framebuffer_texture_2d(glow::READ_FRAMEBUFFER, glow::COLOR_ATTACHMENT0,
+            glow::TEXTURE_2D, Some(target), 0);
+        assert_eq!(gl.check_framebuffer_status(glow::READ_FRAMEBUFFER), glow::FRAMEBUFFER_COMPLETE);
+        gl.bind_buffer(glow::PIXEL_PACK_BUFFER, None);
+        gl.pixel_store_i32(glow::PACK_ALIGNMENT, 1);
+        gl.pixel_store_i32(glow::PACK_ROW_LENGTH, 0);
+        gl.pixel_store_i32(glow::PACK_SKIP_ROWS, 0);
+        gl.pixel_store_i32(glow::PACK_SKIP_PIXELS, 0);
+        let mut bytes = vec![0; (size.x * size.y * 4) as usize];
+        gl.read_pixels(0, 0, size.x as i32, size.y as i32, glow::RGBA, glow::UNSIGNED_BYTE,
+            glow::PixelPackData::Slice(Some(&mut bytes)));
+        crate::check_error(gl, "software direct FFE readback");
+        gl.bind_framebuffer(glow::READ_FRAMEBUFFER, None);
+        gl.delete_framebuffer(fbo);
+        bytes
+    }
