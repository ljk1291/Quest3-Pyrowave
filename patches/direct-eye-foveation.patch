+/// Pure activation policy: rejected requests always retain the staging path.
+fn direct_ffe_eligibility(requested: bool, direct_copy: bool, sync: bool, asynchronous: bool,
+    target_reason: &'static str, config: Option<&FoveatedEncodingConfig>, has_inverse: bool) -> &'static str {
+    if !requested { return "not_requested"; }
+    if !direct_copy { return "direct_eye_copy_required"; }
+    if !sync { return "pyrowave_synchronous_import_required"; }
+    if asynchronous { return "asynchronous_copy"; }
+    if target_reason != "eligible" { return target_reason; }
+    let Some(config) = config else { return "foveation_off"; };
+    if config.blur_only { return "blur_only"; }
+    if config.profile == FoveationProfile::Custom { return "custom_profile"; }
+    if !has_inverse { return "missing_inverse_support"; }
+    "eligible"
+}
