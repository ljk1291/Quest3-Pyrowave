+/// `debug.q3pw.output_queue_max_age_us`: the FIFO's source-timestamp age bound, 1-1,000,000 us.
+/// Default two 90 Hz display periods, rounded up.
+pub fn pyrowave_output_max_age(value: &str) -> Duration {
+    Duration::from_micros(value.trim().parse::<u64>().ok()
+        .filter(|age| (1..=1_000_000).contains(age)).unwrap_or(22_223))
