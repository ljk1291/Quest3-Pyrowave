+/// `debug.q3pw.output_queue`: 2 or 3 selects the decoded-output FIFO of that depth. Anything else,
+/// or a copy handoff (which serializes production and cannot fill a FIFO), keeps depth 1.
+pub fn pyrowave_output_depth(value: &str, handoff: bool) -> usize {
+    if handoff { return 1; }
+    match value.trim() {
+        "2" => 2,
+        "3" => 3,
+        _ => 1,
+    }
+}
