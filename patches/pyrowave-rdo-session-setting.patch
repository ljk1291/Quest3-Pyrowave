diff --git a/pyrowave_rdo_density.hpp b/pyrowave_rdo_density.hpp
index b2b1628fa24c5fb3d505fcf96f5b6a75537077fb..ec2ae178abbfb325434a3d1afe9e36d4cbd9698e 100644
--- a/pyrowave_rdo_density.hpp
+++ b/pyrowave_rdo_density.hpp
@@ -26,6 +26,19 @@ struct RDODensity
 	bool legacy_equivalent = true;
 };
 
+inline RDODensity rdo_density_from_pixels_per_degree(float requested)
+{
+	RDODensity density = {};
+	if (!std::isfinite(requested) || requested <= 0.0f || requested > 10000.0f)
+	{
+		density.valid = false;
+		return density;
+	}
+	density.pixels_per_degree = requested;
+	density.legacy_equivalent = requested == LegacyRDOPixelsPerDegree;
+	return density;
+}
+
 // This is deliberately a value object rather than a logging format. Callers
 // can report the exact density retained by an initialized encoder without
 // reparsing its environment.
@@ -46,19 +59,13 @@ inline RDODensity parse_rdo_pixels_per_degree(const char *requested)
 	errno = 0;
 	char *end = nullptr;
 	float parsed = std::strtof(requested, &end);
-	if (errno == ERANGE || end == requested || !end || *end != '\0' ||
-	    !std::isfinite(parsed) || parsed <= 0.0f || parsed > 10000.0f)
+	if (errno == ERANGE || end == requested || !end || *end != '\0')
 	{
 		density.valid = false;
 		return density;
 	}
 
-	density.pixels_per_degree = parsed;
-	// The explicit PPD knob is deliberately not a DPI alias. 96 PPD therefore
-	// means a 48 cycles/degree Nyquist limit, whereas the legacy default is
-	// 65.28 PPD / 32.64 cycles per degree.
-	density.legacy_equivalent = parsed == LegacyRDOPixelsPerDegree;
-	return density;
+	return rdo_density_from_pixels_per_degree(parsed);
 }
 
 inline float rdo_cpd_nyquist(const RDODensity &density)
