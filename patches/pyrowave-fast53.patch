+    VEC4 l2 = fast53_column(coord + ivec2(0, 2), 0);
+    VEC4 hm = fast53_column(coord - ivec2(0, 1), 1);
+    VEC4 h0 = fast53_column(coord, 1);
+    VEC4 h1 = fast53_column(coord + ivec2(0, 1), 1);
+    VEC4 h2 = fast53_column(coord + ivec2(0, 2), 1);
+    VEC4 e0 = l0 - FLOAT(0.25) * (hm + h0);
+    VEC4 e1 = l1 - FLOAT(0.25) * (h0 + h1);
+    VEC4 e2 = l2 - FLOAT(0.25) * (h1 + h2);
+    VEC4 o0 = h0 + FLOAT(0.5) * (e0 + e1);
