+    FLOAT l2 = fast53_fetch(coord + ivec2(2, 0), band);
+    FLOAT hm = fast53_fetch(coord - ivec2(1, 0), band + 2);
+    FLOAT h0 = fast53_fetch(coord, band + 2);
+    FLOAT h1 = fast53_fetch(coord + ivec2(1, 0), band + 2);
+    FLOAT h2 = fast53_fetch(coord + ivec2(2, 0), band + 2);
