+    VEC4 odd_hi = VEC4(high.hi) + FLOAT(0.5) * (even.hi + next_even.hi);
+    fast53_write(pixel, even.lo);
+    fast53_write(pixel + ivec2(0, 4), even.hi);
+    fast53_write(pixel + ivec2(1, 0), odd_lo);
+    fast53_write(pixel + ivec2(1, 4), odd_hi);
