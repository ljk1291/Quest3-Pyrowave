@@ -6,6 +6,69 @@
 use alvr_packets::PyroWaveDecodeStats;
 use std::sync::Mutex;
 
+#[derive(Default)]
+struct SelectedOutputState {
+    submissions: u64,
+    last_selection_id: u64,
+}
+
+impl SelectedOutputState {
+    /// Returns true only when this is a nonzero, strictly newer source selection.
+    fn record_submission(&mut self, selection_id: u64) -> bool {
+        if selection_id == 0 || selection_id <= self.last_selection_id {
+            return false;
+        }
+        self.last_selection_id = selection_id;
+        self.submissions = self.submissions.saturating_add(1);
+        true
+    }
+}
+
+static SELECTED_OUTPUT_STATE: Mutex<SelectedOutputState> = Mutex::new(SelectedOutputState {
+    submissions: 0,
+    last_selection_id: 0,
+});
+
+pub fn reset_selected_output_submissions() {
+    *SELECTED_OUTPUT_STATE.lock().unwrap() = SelectedOutputState::default();
+}
+
+/// Record a post-render release once for each strictly newer decoder selection.
+/// Timestamp equality is deliberately irrelevant: the identity originates only
+/// when `VideoDecoderSource::get_frame()` dequeues a fresh decoder output.
+pub fn record_selected_output_submission(selection_id: u64) -> bool {
+    let mut state = SELECTED_OUTPUT_STATE.lock().unwrap();
+    state.record_submission(selection_id)
+}
+
+pub fn selected_output_submissions() -> u64 { SELECTED_OUTPUT_STATE.lock().unwrap().submissions }
+
+#[cfg(test)]
+mod selected_output_tests {
+    use super::*;
+
+    #[test]
+    fn source_identity_counts_fresh_outputs_once_without_timestamps() {
+        // Use local state: decoder-creation tests reset the production counter in
+        // parallel, and must not make this regression timing-dependent.
+        let mut state = SelectedOutputState::default();
+        assert!(!state.record_submission(0)); // no source output
+        // The two source dequeues may carry the same timestamp. Only their source-issued
+        // identities reach this counter, so timestamp reuse cannot affect the result.
+        let reused_timestamp = std::time::Duration::from_millis(42);
+        for (selection_id, _timestamp) in [(7, reused_timestamp), (8, reused_timestamp)] {
+            assert!(state.record_submission(selection_id));
+        }
+        assert!(!state.record_submission(8)); // repeated output
+        assert!(!state.record_submission(6)); // stale output
+        assert_eq!(state.submissions, 2);
+        state = SelectedOutputState::default();
+        assert_eq!(state.submissions, 0);
+        assert!(state.record_submission(1));
+        assert_eq!(state.submissions, 1);
+    }
+}
