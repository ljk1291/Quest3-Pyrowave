+#[test]
+fn full_range_display_policy_follows_the_effective_encoder_and_exact_opt_out() {
+    let mut settings = default_settings();
+    for value in [None, Some("0"), Some("1"), Some(""), Some("false"), Some(" 0")] {
+        let env = |key: &str| match key {
+            "ALVR_Q3PW_PYROWAVE_FULL_RANGE" => value.map(str::to_owned),
+            _ => None,
+        };
+        assert_eq!(pyrowave_full_range(&settings, &env), value != Some("0"));
+    }
+    for codec in [CodecType::H264, CodecType::Hevc, CodecType::AV1] {
+        settings.video.preferred_codec = codec;
+        assert!(!pyrowave_full_range(&settings, &|_| None));
+        assert!(!pyrowave_full_range(&settings, &|key| {
+            (key == "ALVR_Q3PW_PYROWAVE_FULL_RANGE").then(|| "1".to_owned())
+        }));
+    }
+    // A server research override can select PyroWave despite the saved codec.
+    assert!(pyrowave_full_range(&settings, &|key| {
+        (key == "ALVR_PYROWAVE").then(|| "1".to_owned())
+    }));
+    assert!(!pyrowave_full_range(&settings, &|key| match key {
+        "ALVR_PYROWAVE" => Some("1".to_owned()),
+        "ALVR_Q3PW_PYROWAVE_FULL_RANGE" => Some("0".to_owned()),
+        _ => None,
+    }));
+}
