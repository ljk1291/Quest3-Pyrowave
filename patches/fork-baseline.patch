+    use super::*;
+
+    const EPSILON: f32 = 0.000_01;
+
+    fn fov(left: f32, right: f32, down: f32, up: f32) -> Fov {
+        Fov {
+            left: left.atan(),
+            right: right.atan(),
+            down: down.atan(),
+            up: up.atan(),
+        }
+    }
+
+    #[test]
+    fn tangent_crop_preserves_each_eye_asymmetric_frustum() {
+        // Session-07 measured OpenVR tangents. The right eye mirrors only the
+        // horizontal sides; both eyes retain their original optical-axis offset.
+        let crop = FovTangentMultipliers {
+            horizontal: 0.854,
+            vertical: 0.850,
+        }
+        .validate()
+        .unwrap();
+        let left = crop.scale_fov(fov(-1.3763819, 0.8390996, -1.4281479, 0.9656888));
+        let right = crop.scale_fov(fov(-0.8390996, 1.3763819, -1.4281479, 0.9656888));
+
+        for (actual, expected) in [
+            (left.left.tan(), -1.3763819 * 0.854),
+            (left.right.tan(), 0.8390996 * 0.854),
+            (right.left.tan(), -0.8390996 * 0.854),
+            (right.right.tan(), 1.3763819 * 0.854),
+            (left.down.tan(), -1.4281479 * 0.850),
+            (right.up.tan(), 0.9656888 * 0.850),
+        ] {
+            assert!((actual - expected).abs() < EPSILON, "{actual} != {expected}");
+        }
+        assert_ne!(left.left, left.right, "left-eye asymmetry must survive");
+        assert_ne!(right.left, right.right, "right-eye asymmetry must survive");
+        assert!((left.left + right.right).abs() < EPSILON);
+        assert!((left.right + right.left).abs() < EPSILON);
+    }
+
+    #[test]
+    fn crop_sizes_preserve_density_and_align_upward() {
+        let crop = FovTangentMultipliers {
+            horizontal: 0.854,
+            vertical: 0.850,
+        };
+        // 3072 * .854 = 2623.488 and 3232 * .85 = 2747.2, so alignment gives
+        // 2624x2752. Runtime intentionally does not force Q3's offline 2776
+        // crop height, which is a separately centred comparison rectangle.
+        assert_eq!(
+            crop.scale_aligned_view_resolution(UVec2::new(3072, 3232), 32),
+            UVec2::new(2624, 2752)
+        );
+        assert_eq!(
+            crop.scale_aligned_view_resolution(UVec2::new(2560, 2688), 32),
+            UVec2::new(2208, 2304)
+        );
+        // Upstream .65 keeps the PC source above a separately configured stream.
+        assert_eq!(
+            crop.scale_aligned_view_resolution(UVec2::new(2080, 2208), 32),
+            UVec2::new(1792, 1888)
+        );
+    }
+
+    #[test]
+    fn identity_and_invalid_multipliers_are_safe() {
+        let full = UVec2::new(3072, 3232);
+        assert_eq!(
+            FovTangentMultipliers::default().scale_aligned_view_resolution(full, 32),
+            full
+        );
+        assert!(FovTangentMultipliers {
+            horizontal: 1.01,
+            vertical: 1.0
+        }
+        .validate()
+        .is_err());
+        assert!(FovTangentMultipliers {
+            horizontal: f32::NAN,
+            vertical: 1.0
+        }
+        .validate()
+        .is_err());
+    }
+
+    fn stream_packet() -> StreamConfigPacket {
+        encode_stream_config(
