+#[test]
+fn profiles_clear_an_existing_fov_crop() {
+    for profile in streaming_profiles() {
+        let mut root = json::to_value(SessionConfig::default().session_settings).unwrap();
+        root["video"]["fov_crop"] = json::json!({
+            "enabled": true,
+            "content": {
+                "horizontal_tangent_multiplier": 0.854,
+                "vertical_tangent_multiplier": 0.850,
+            },
+        });
+        for (path, value) in profile.assignments {
+            let mut node = &mut root;
+            for field in path.split('.') {
+                node = node.get_mut(field).unwrap();
+            }
+            *node = value;
+        }
+        assert_eq!(root["video"]["fov_crop"], json::json!({
+            "enabled": false,
+            "content": {
+                "horizontal_tangent_multiplier": 1.0,
+                "vertical_tangent_multiplier": 1.0,
+            },
+        }), "{} inherited a crop", profile.name);
+    }
