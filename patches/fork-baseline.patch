--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/NvencDimensionPolicy.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <string>
+
+namespace alvr_nvenc_dimension {
+
+enum class Codec { H264, HEVC, AV1, Unknown };
+
+struct Caps {
+    bool width_query_ok;
+    int width_max;
+    bool height_query_ok;
+    int height_max;
+};
+
+inline const char* CodecName(Codec codec) {
+    switch (codec) {
+    case Codec::H264: return "H.264";
+    case Codec::HEVC: return "HEVC";
+    case Codec::AV1: return "AV1";
+    default: return "unknown";
+    }
+}
+
+inline bool Validate(Codec codec, int width, int height, const Caps& caps, std::string* reason) {
+    const auto fail = [reason](const std::string& value) {
+        if (reason) {
+            *reason = value;
+        }
+        return false;
+    };
+    if (codec == Codec::Unknown) return fail("unsupported NVENC codec");
+    if (width <= 0 || height <= 0) return fail("invalid requested dimensions");
+    if (!caps.width_query_ok || caps.width_max <= 0) return fail("WIDTH_MAX query failed or returned a nonpositive cap");
+    if (!caps.height_query_ok || caps.height_max <= 0) return fail("HEIGHT_MAX query failed or returned a nonpositive cap");
+    if (width > caps.width_max) return fail(std::string(CodecName(codec)) + " requested width exceeds WIDTH_MAX");
+    if (height > caps.height_max) return fail(std::string(CodecName(codec)) + " requested height exceeds HEIGHT_MAX");
+    return true;
+}
+
+} // namespace alvr_nvenc_dimension
