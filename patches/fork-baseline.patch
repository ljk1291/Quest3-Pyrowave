+    }
+
+    #[test]
+    fn missing_multiplier_is_legacy_identity_but_bad_values_fail_closed() {
+        let mut missing = stream_packet();
+        let mut json: json::Value = json::from_str(&missing.negotiated).unwrap();
+        json.as_object_mut()
+            .unwrap()
+            .remove("fov_tangent_multipliers");
+        missing.negotiated = json::to_string(&json).unwrap();
+        assert_eq!(
+            decode_stream_config(&missing)
+                .unwrap()
+                .negotiated_config
+                .fov_tangent_multipliers,
+            FovTangentMultipliers::default()
+        );
+
+        let mut invalid = stream_packet();
+        let mut json: json::Value = json::from_str(&invalid.negotiated).unwrap();
+        json["fov_tangent_multipliers"] = json::json!({
+            "horizontal": 0.1,
+            "vertical": 0.85,
+        });
+        invalid.negotiated = json::to_string(&json).unwrap();
+        assert!(decode_stream_config(&invalid).is_err());
+
+        let mut malformed = stream_packet();
+        let mut json: json::Value = json::from_str(&malformed.negotiated).unwrap();
+        json["fov_tangent_multipliers"] = json::json!("not multipliers");
+        malformed.negotiated = json::to_string(&json).unwrap();
+        assert!(decode_stream_config(&malformed).is_err());
+    }
+
+    #[test]
+    fn identity_crop_preserves_runtime_angles_bit_for_bit() {
+        let input = Fov {
+            left: -1.002_345_6,
+            right: 0.731_234_5,
+            up: 0.912_345_6,
+            down: -0.812_345_6,
+        };
+        let output = FovTangentMultipliers::default().scale_fov(input);
+        assert_eq!(output.left.to_bits(), input.left.to_bits());
+        assert_eq!(output.right.to_bits(), input.right.to_bits());
+        assert_eq!(output.up.to_bits(), input.up.to_bits());
+        assert_eq!(output.down.to_bits(), input.down.to_bits());
+    }
+
+    #[test]
+    fn pyrowave_range_policy_defaults_on_and_preserves_explicit_opt_out() {
+        let mut packet = stream_packet();
+        let mut negotiated: json::Value = json::from_str(&packet.negotiated).unwrap();
+        for value in [None, Some(json::json!(true)), Some(json::json!(false))] {
+            negotiated.as_object_mut().unwrap().remove("pyrowave_full_range");
+            if let Some(value) = &value {
+                negotiated["pyrowave_full_range"] = value.clone();
+            }
+            packet.negotiated = json::to_string(&negotiated).unwrap();
+            let decoded = decode_stream_config(&packet).unwrap().negotiated_config;
+            assert_eq!(decoded.pyrowave_full_range, value != Some(json::json!(false)));
+            assert!(decoded.use_full_range, "display policy must not change coded range");
+        }
+        negotiated["pyrowave_full_range"] = json::json!("0");
+        packet.negotiated = json::to_string(&negotiated).unwrap();
+        assert!(decode_stream_config(&packet).is_err());
+
+        // Older hardware-codec servers must keep the platform-decoder remap.
+        negotiated.as_object_mut().unwrap().remove("pyrowave_full_range");
+        packet.negotiated = json::to_string(&negotiated).unwrap();
+        let mut session: json::Value = json::from_str(&packet.session).unwrap();
+        session["session_settings"]["video"]["preferred_codec"]["variant"] = json::json!("H264");
+        packet.session = json::to_string(&session).unwrap();
+        assert!(!decode_stream_config(&packet).unwrap().negotiated_config.pyrowave_full_range);
+    }
+}
