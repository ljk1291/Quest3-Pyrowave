+#[test]
+fn fast_abr_is_opt_in_and_old_sessions_migrate_disabled() {
+    assert!(matches!(default_settings().video.pyrowave.fast_abr, Switch::Disabled));
+    let mut saved = json::to_value(SessionConfig::default()).unwrap();
+    saved["session_settings"]["video"]["pyrowave"].as_object_mut().unwrap().remove("fast_abr");
+    let mut session = SessionConfig::default();
+    session.merge_from_json(&saved).unwrap();
+    assert!(matches!(session.to_settings().video.pyrowave.fast_abr, Switch::Disabled));
+
+    let mut saved = json::to_value(session).unwrap();
+    let abr = &mut saved["session_settings"]["video"]["pyrowave"]["fast_abr"];
+    abr["enabled"] = true.into();
+    abr["content"]["floor"] = json::json!(0.4);
+    let mut session = SessionConfig::default();
+    session.merge_from_json(&saved).unwrap();
+    let Switch::Enabled(config) = session.to_settings().video.pyrowave.fast_abr else {
+        panic!("explicit fast ABR opt-in was lost");
+    };
+    assert_eq!(config.floor, 0.4);
+    assert_eq!(config.decrease, 0.6);
+    assert_eq!(config.recovery, 0.05);
+    assert_eq!(config.mode, PyroWaveFastAbrMode::Aimd);
+    assert_eq!(config.backlog_frames, 0.75);
+    assert_eq!(config.send_buffer_bytes, 0);
+}
+
+#[test]
+fn fast_abr_v1_sessions_keep_their_mode_threshold_and_buffer() {
+    let mut saved = json::to_value(SessionConfig::default()).unwrap();
+    let abr = &mut saved["session_settings"]["video"]["pyrowave"]["fast_abr"];
+    abr["enabled"] = true.into();
+    abr["content"].as_object_mut().unwrap().remove("mode");
+    abr["content"]["backlog_frames"] = json::json!(1.0);
+    abr["content"]["send_buffer_bytes"] = json::json!(1_048_576);
+    let mut session = SessionConfig::default();
+    session.merge_from_json(&saved).unwrap();
+    let Switch::Enabled(config) = session.to_settings().video.pyrowave.fast_abr else { panic!("lost opt-in") };
+    assert_eq!(config.mode, PyroWaveFastAbrMode::Aimd);
+    assert_eq!(config.backlog_frames, 1.0);
+    assert_eq!(config.send_buffer_bytes, 1_048_576);
+
+    let mut saved = json::to_value(session).unwrap();
+    saved["session_settings"]["video"]["pyrowave"]["fast_abr"]["content"]["mode"]["variant"] = "Capacity".into();
+    let mut session = SessionConfig::default();
+    session.merge_from_json(&saved).unwrap();
+    let Switch::Enabled(config) = session.to_settings().video.pyrowave.fast_abr else { panic!("lost opt-in") };
+    assert_eq!(config.mode, PyroWaveFastAbrMode::Capacity);
+    assert_eq!(config.backlog_frames, 1.0);
+    assert_eq!(config.send_buffer_bytes, 1_048_576);
+}
