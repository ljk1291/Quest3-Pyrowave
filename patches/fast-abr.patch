diff --git a/alvr/server_core/src/fast_abr.rs b/alvr/server_core/src/fast_abr.rs
new file mode 100644
index 0000000000000000000000000000000000000000..daeeac51e9d0621b5d47fc6f3ff0d301ab8c2fb0
--- /dev/null
+++ b/alvr/server_core/src/fast_abr.rs
@@ -0,0 +1,305 @@
+//! Per-encode AIMD, with atomic feedback from the TCP video sender. No socket I/O here.
+use std::{
+    sync::atomic::{AtomicBool, AtomicU32, AtomicU64, AtomicUsize, Ordering::Relaxed},
+    time::Instant,
+};
+
+#[derive(Clone, Copy, Debug)]
+pub struct Config {
+    pub floor: f32,
+    pub decrease: f32,
+    pub recovery: f32,
+    pub backlog_frames: f32,
+    pub send_buffer_bytes: u32,
+}
+
+impl Default for Config {
+    fn default() -> Self {
+        Self { floor: 0.35, decrease: 0.6, recovery: 0.05,
+            backlog_frames: 1.0, send_buffer_bytes: 1_048_576 }
+    }
+}
+
+impl Config {
+    pub fn validate(self) -> Result<Self, &'static str> {
+        if !self.floor.is_finite() || !(0.01..=1.0).contains(&self.floor)
+            || !self.decrease.is_finite() || !(0.01..1.0).contains(&self.decrease)
+            || !self.recovery.is_finite() || !(0.0001..=1.0).contains(&self.recovery)
+            || !self.backlog_frames.is_finite() || !(0.25..=8.0).contains(&self.backlog_frames)
+            || !(65536..=16777216).contains(&self.send_buffer_bytes)
+        {
+            return Err("invalid fast ABR parameters");
+        }
+        Ok(self)
+    }
+}
+
+pub fn enabled(requested: bool, pyrowave: bool, udp_video: bool, tcp_stream: bool) -> bool {
+    requested && pyrowave && !udp_video && tcp_stream
+}
+
+fn step(config: Config, multiplier: f32, backlog: f32, dropped: bool) -> f32 {
+    if dropped || backlog > config.backlog_frames {
+        (multiplier * config.decrease).max(config.floor)
+    } else {
+        (multiplier + config.recovery).min(1.0)
+    }
+}
+
+// Bounded histogram: quarter-frame upper bounds; final bucket means > 15.75 frames.
+const BACKLOG_BUCKETS: usize = 65;
+const SCALE: f32 = 1_000_000.0;
+
+pub struct FastAbr {
+    config: Config,
+    epoch: Instant,
+    frame_ns: f64,
+    queued: AtomicUsize,
+    send_started_ns: AtomicU64,
+    completed_send_ns: AtomicU64,
+    drop_pending: AtomicBool,
+    multiplier: AtomicU32,
+    samples: AtomicU64,
+    multiplier_sum: AtomicU64,
+    multiplier_min: AtomicU32,
+    shrunk: AtomicU64,
+    dropped: AtomicU64,
+    send_errors: AtomicU64,
+    backlog: [AtomicU64; BACKLOG_BUCKETS],
+}
+
+impl FastAbr {
+    pub fn new(config: Config, fps: f32) -> Result<Self, &'static str> {
+        let config = config.validate()?;
+        if !fps.is_finite() || !(1.0..=1000.0).contains(&fps) {
+            return Err("invalid fast ABR frame rate");
+        }
+        Ok(Self {
+            config,
+            epoch: Instant::now(),
+            frame_ns: 1e9 / fps as f64,
+            queued: AtomicUsize::new(0),
+            send_started_ns: AtomicU64::new(0),
+            completed_send_ns: AtomicU64::new(0),
+            drop_pending: AtomicBool::new(false),
+            multiplier: AtomicU32::new(1.0_f32.to_bits()),
+            samples: AtomicU64::new(0),
+            multiplier_sum: AtomicU64::new(0),
+            multiplier_min: AtomicU32::new(1.0_f32.to_bits()),
+            shrunk: AtomicU64::new(0),
+            dropped: AtomicU64::new(0),
+            send_errors: AtomicU64::new(0),
+            backlog: std::array::from_fn(|_| AtomicU64::new(0)),
+        })
+    }
+
+    fn now_ns(&self) -> u64 {
+        // Zero is reserved for "no send in progress".
+        (self.epoch.elapsed().as_nanos() as u64).max(1)
+    }
+
+    // Called BEFORE try_send: the consumer must never decrement an unpublished count.
+    pub fn enqueue(&self) {
+        self.queued.fetch_add(1, Relaxed);
+    }
+
+    pub fn enqueue_failed(&self) {
+        self.queued.fetch_sub(1, Relaxed);
+        self.drop_pending.store(true, Relaxed);
+        self.dropped.fetch_add(1, Relaxed);
+    }
+
+    pub fn begin_send(&self) {
+        self.begin_send_at(self.now_ns());
+    }
+
+    fn begin_send_at(&self, now_ns: u64) {
+        self.send_started_ns.store(now_ns, Relaxed);
+        self.queued.fetch_sub(1, Relaxed);
+    }
+
+    pub fn end_send(&self, success: bool) {
+        self.end_send_at(self.now_ns(), success);
+    }
+
+    fn end_send_at(&self, now_ns: u64, success: bool) {
+        let start = self.send_started_ns.load(Relaxed);
+        self.completed_send_ns.fetch_max(now_ns.saturating_sub(start), Relaxed);
+        self.send_started_ns.store(0, Relaxed);
+        if !success {
+            self.drop_pending.store(true, Relaxed);
+            self.dropped.fetch_add(1, Relaxed);
+            self.send_errors.fetch_add(1, Relaxed);
+        }
+    }
+
+    /// One call per PyroWave encode, independently of ALVR's slow bitrate updates.
+    pub fn next_frame(&self) -> f32 {
+        self.next_frame_at(self.now_ns())
+    }
+
+    fn next_frame_at(&self, now_ns: u64) -> f32 {
+        let started = self.send_started_ns.load(Relaxed);
+        let active = if started == 0 { 0 } else { now_ns.saturating_sub(started) };
+        let completed = self.completed_send_ns.swap(0, Relaxed);
+        // This is pressure in frame equivalents, NOT a TCP byte-queue measurement.
+        // A blocked send remains observable even before it returns. Completed durations
+        // are consumed once, so a stale slow send cannot pin the controller at its floor.
+        let backlog = (self.queued.load(Relaxed) as f64 + active as f64 / self.frame_ns)
+            .max(completed as f64 / self.frame_ns) as f32;
+        // The native encoder is the sole caller; feedback/telemetry use only atomics.
+        let previous = f32::from_bits(self.multiplier.load(Relaxed));
+        let value = step(self.config, previous, backlog, self.drop_pending.swap(false, Relaxed));
+        self.multiplier.store(value.to_bits(), Relaxed);
+        self.samples.fetch_add(1, Relaxed);
+        self.multiplier_sum.fetch_add((value * SCALE).round() as u64, Relaxed);
+        self.multiplier_min.fetch_min(value.to_bits(), Relaxed);
+        if value < 1.0 {
+            self.shrunk.fetch_add(1, Relaxed);
+        }
+        let bucket = ((backlog * 4.0).ceil() as usize).min(BACKLOG_BUCKETS - 1);
+        self.backlog[bucket].fetch_add(1, Relaxed);
+        value
+    }
+
+    /// Called once per second by the existing telemetry thread, never the socket sender.
+    /// Atomic interval counters can straddle a sample at the reporting boundary.
+    pub fn take_stats(&self) -> String {
+        let samples = self.samples.swap(0, Relaxed);
+        let sum = self.multiplier_sum.swap(0, Relaxed);
+        let min = f32::from_bits(self.multiplier_min.swap(1.0_f32.to_bits(), Relaxed));
+        let counts: [u64; BACKLOG_BUCKETS] = std::array::from_fn(|i| self.backlog[i].swap(0, Relaxed));
+        let total: u64 = counts.iter().sum();
+        let rank = (total * 95).div_ceil(100);
+        let mut cumulative = 0;
+        let p95 = counts.iter().position(|count| {
+            cumulative += count;
+            cumulative >= rank
+        }).unwrap_or(0);
+        format!(
+            "[Q3PW_FAST_ABR] samples={samples} multiplier_min={min:.3} multiplier_mean={:.3} frames_shrunk={} frames_dropped={} send_errors={} backlog_p95_frames={:.2} backlog_p95_saturated={}",
+            if samples == 0 { 1.0 } else { sum as f64 / SCALE as f64 / samples as f64 },
+            self.shrunk.swap(0, Relaxed), self.dropped.swap(0, Relaxed),
+            self.send_errors.swap(0, Relaxed), p95 as f32 / 4.0,
+            p95 == BACKLOG_BUCKETS - 1,
+        )
+    }
+}
+
+pub fn next_frame(controller: Option<&FastAbr>) -> f32 {
+    controller.map_or(1.0, FastAbr::next_frame)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn config() -> Config {
+        Config { floor: 0.35, decrease: 0.6, recovery: 0.05,
+            backlog_frames: 1.0, send_buffer_bytes: 1_048_576 }
+    }
+
+    fn close(actual: f32, expected: f32) {
+        assert!((actual - expected).abs() < 0.00001, "{actual} != {expected}");
+    }
+
+    #[test]
+    fn step_response_floor_and_recovery_never_exceed_ceiling() {
+        let c = config();
+        let mut value = 1.0;
+        for expected in [0.6, 0.36, 0.35, 0.35] {
+            value = step(c, value, 2.0, false);
+            close(value, expected);
+        }
+        close(step(c, value, 0.0, false), 0.4);
+        for _ in 0..100 { value = step(c, value, 0.0, false); }
+        close(value, 1.0);
+    }
+
+    #[test]
+    fn blocked_send_is_seen_before_completion_and_stale_feedback_is_consumed() {
+        let abr = FastAbr::new(config(), 100.0).unwrap();
+        abr.enqueue(); abr.begin_send_at(1);
+        close(abr.next_frame_at(20_000_001), 0.6);
+        close(abr.next_frame_at(30_000_001), 0.36);
+        abr.end_send_at(30_000_001, true);
+        close(abr.next_frame_at(40_000_001), 0.35);
+        close(abr.next_frame_at(50_000_001), 0.4);
+    }
+
+    #[test]
+    fn queued_frames_and_rejected_enqueue_are_accounted_once() {
+        let abr = FastAbr::new(config(), 90.0).unwrap();
+        abr.enqueue(); abr.enqueue();
+        close(abr.next_frame_at(1), 0.6);
+        abr.enqueue(); abr.enqueue_failed();
+        assert_eq!(abr.queued.load(Relaxed), 2);
+        abr.begin_send_at(1); abr.end_send_at(2, true);
+        abr.begin_send_at(3); abr.end_send_at(4, true);
+        close(abr.next_frame_at(5), 0.36); // full-channel event survives queue drain
+        close(abr.next_frame_at(6), 0.41);
+        assert_eq!(abr.queued.load(Relaxed), 0);
+        let stats = abr.take_stats();
+        assert!(stats.contains("frames_dropped=1"));
+        assert!(stats.contains("backlog_p95_frames=2.00"));
+        assert!(abr.take_stats().contains("samples=0"));
+    }
+
+    #[test]
+    fn send_failure_decreases_and_counts_one_frame() {
+        let abr = FastAbr::new(config(), 90.0).unwrap();
+        abr.enqueue(); abr.begin_send_at(1); abr.end_send_at(2, false);
+        close(abr.next_frame_at(3), 0.6);
+        let stats = abr.take_stats();
+        assert!(stats.contains("frames_dropped=1 send_errors=1"));
+    }
+
+    #[test]
+    fn disabled_or_other_transports_are_no_ops() {
+        close(next_frame(None), 1.0);
+        assert!(!enabled(false, true, false, true));
+        assert!(!enabled(true, false, false, true));
+        assert!(!enabled(true, true, true, true));
+        assert!(!enabled(true, true, false, false));
+        assert!(enabled(true, true, false, true));
+    }
+
+    #[test]
+    fn threshold_and_custom_tuning_are_respected() {
+        let c = Config { floor: 0.5, decrease: 0.8, recovery: 0.02,
+            backlog_frames: 2.0, ..config() };
+        close(step(c, 0.8, 2.0, false), 0.82);
+        close(step(c, 0.8, 2.01, false), 0.64);
+        close(step(c, 0.5, 3.0, false), 0.5);
+    }
+
+    #[test]
+    fn reconnect_starts_at_ceiling_with_no_stale_pressure() {
+        let first = FastAbr::new(config(), 90.0).unwrap();
+        first.enqueue(); first.enqueue();
+        close(first.next_frame_at(1), 0.6);
+        let second = FastAbr::new(config(), 90.0).unwrap();
+        close(second.next_frame_at(1), 1.0);
+        assert_eq!(second.queued.load(Relaxed), 0);
+    }
+
+    #[test]
+    fn invalid_configuration_is_rejected() {
+        for floor in [f32::NAN, f32::INFINITY, 0.0, 1.01] {
+            assert!(Config { floor, ..config() }.validate().is_err());
+        }
+        for decrease in [f32::NAN, 0.0, 1.0] {
+            assert!(Config { decrease, ..config() }.validate().is_err());
+        }
+        for recovery in [f32::NAN, 0.0, 1.01] {
+            assert!(Config { recovery, ..config() }.validate().is_err());
+        }
+        for backlog_frames in [f32::NAN, 0.0, 9.0] {
+            assert!(Config { backlog_frames, ..config() }.validate().is_err());
+        }
+        for send_buffer_bytes in [0, 65535, u32::MAX] {
+            assert!(Config { send_buffer_bytes, ..config() }.validate().is_err());
+        }
+        assert!(FastAbr::new(config(), f32::NAN).is_err());
+    }
+}
