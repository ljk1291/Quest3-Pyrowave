diff --git a/alvr/common/src/version.rs b/alvr/common/src/version.rs
index ce5ecd001d9552aa6d0e7467457e1d4b02045800..51c3174b5f76a6db6e70b03b3c3864dd1590c648 100644
--- a/alvr/common/src/version.rs
+++ b/alvr/common/src/version.rs
@@ -48,3 +48,28 @@ pub fn is_version_compatible(other_version: &Version) -> bool {
 
     protocol_id_u64() == hash_string(&protocol_string)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fork_protocol_rejects_previous_schemas() {
+        // The fork's pre-release tag is its protocol: the previous fork build and upstream's own
+        // build carry other packet and settings schemas, so neither may connect to this one.
+        for previous_schema in [
+            "20.13.0-ljk1291.3",
+            "20.13.0-ljk1291.2",
+            "20.13.0-quest3.pyro.65",
+        ] {
+            let previous_schema = Version::parse(previous_schema).unwrap();
+            assert!(!is_version_compatible(&previous_schema));
+        }
+        assert_eq!(protocol_id(), "20-ljk1291.4");
+        assert!(is_version_compatible(&ALVR_VERSION));
+        // CI stamps "+<commit>" build metadata; it identifies a build without changing protocol.
+        let mut stamped = ALVR_VERSION.clone();
+        stamped.build = semver::BuildMetadata::new("0123456789ab").unwrap();
+        assert!(is_version_compatible(&stamped));
+    }
+}
