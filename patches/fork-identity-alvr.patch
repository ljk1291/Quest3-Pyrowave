--- a/alvr/common/src/version.rs
+++ b/alvr/common/src/version.rs
@@ -48,3 +48,15 @@ pub fn is_version_compatible(other_version: &Version) -> bool {
 
     protocol_id_u64() == hash_string(&protocol_string)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn telemetry_schema_protocol_rejects_the_previous_fork_prerelease() {
+        let previous_schema = Version::parse("20.13.0-ljk1291.1").unwrap();
+        assert!(!is_version_compatible(&previous_schema));
+        assert!(is_version_compatible(&ALVR_VERSION));
+    }
+}
