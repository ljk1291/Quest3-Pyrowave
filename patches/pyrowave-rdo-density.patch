diff --git a/pyrowave_rdo_density.hpp b/pyrowave_rdo_density.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..774a1150cefafbd5a5e6e46fe35f8c611194b143
--- /dev/null
+++ b/pyrowave_rdo_density.hpp
@@ -0,0 +1,76 @@
+// Copyright (c) 2026 ljk1291
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cerrno>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+namespace PyroWave
+{
+// The original encoder used 96 DPI at one metre. Its 0.34 cycles-per-pixel
+// Nyquist model corresponds to 65.28 pixels per degree, not 96 pixels per
+// degree. Keep its expression on the unset path bit-for-bit.
+static constexpr float LegacyRDODpi = 96.0f;
+static constexpr float LegacyRDOViewingDistanceMeters = 1.0f;
+static constexpr float LegacyRDOCyclesPerPixelNyquist = 0.34f;
+static constexpr float LegacyRDOPixelsPerDegree =
+	2.0f * LegacyRDOCyclesPerPixelNyquist * LegacyRDOViewingDistanceMeters * LegacyRDODpi;
+
+struct RDODensity
+{
+	float pixels_per_degree = LegacyRDOPixelsPerDegree;
+	bool valid = true;
+	bool legacy_equivalent = true;
+};
+
+inline RDODensity parse_rdo_pixels_per_degree(const char *requested)
+{
+	RDODensity density = {};
+	if (!requested || !*requested)
+		return density;
+
+	errno = 0;
+	char *end = nullptr;
+	float parsed = std::strtof(requested, &end);
+	if (errno == ERANGE || end == requested || !end || *end != '\0' ||
+	    !std::isfinite(parsed) || parsed <= 0.0f || parsed > 10000.0f)
+	{
+		density.valid = false;
+		return density;
+	}
+
+	density.pixels_per_degree = parsed;
+	// The explicit PPD knob is deliberately not a DPI alias. 96 PPD therefore
+	// means a 48 cycles/degree Nyquist limit, whereas the legacy default is
+	// 65.28 PPD / 32.64 cycles per degree.
+	density.legacy_equivalent = parsed == LegacyRDOPixelsPerDegree;
+	return density;
+}
+
+inline float rdo_cpd_nyquist(const RDODensity &density)
+{
+	if (density.legacy_equivalent)
+	{
+		return LegacyRDOCyclesPerPixelNyquist * LegacyRDOViewingDistanceMeters * LegacyRDODpi;
+	}
+
+	return 0.5f * density.pixels_per_degree;
+}
+
+inline float rdo_quant_csf(const RDODensity &density, int level, int component, int band,
+				  bool chroma420, int decomposition_levels)
+{
+	float horiz_midpoint = (band & 1) ? 0.75f : 0.25f;
+	float vert_midpoint = (band & 2) ? 0.75f : 0.25f;
+	float cpd = std::sqrt(horiz_midpoint * horiz_midpoint + vert_midpoint * vert_midpoint) *
+	            rdo_cpd_nyquist(density) * std::exp2(-float(level));
+	cpd = std::max(cpd, 8.0f);
+	float csf = 2.6f * (0.0192f + 0.114f * cpd) * std::exp(-std::pow(0.114f * cpd, 1.1f));
+	if (component != 0 && level != decomposition_levels - 1 && chroma420)
+		csf *= 0.6f;
+	return csf;
+}
+}
diff --git a/pyrowave_rdo_density_test.cpp b/pyrowave_rdo_density_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0bd64660cdbcb335507be9e0684e6fea50714f1a
--- /dev/null
+++ b/pyrowave_rdo_density_test.cpp
@@ -0,0 +1,64 @@
+// Copyright (c) 2026 ljk1291
+// SPDX-License-Identifier: MIT
+#include "pyrowave_rdo_density.hpp"
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#define ASSERT_THAT(expr) do { \
+	if (!(expr)) { std::fprintf(stderr, "Assertion failed: %s at line %d.\n", #expr, __LINE__); return 1; } \
+} while (false)
+
+static uint32_t float_bits(float value)
+{
+	uint32_t bits = 0;
+	static_assert(sizeof(bits) == sizeof(value), "Unexpected float size.");
+	std::memcpy(&bits, &value, sizeof(bits));
+	return bits;
+}
+
+int main()
+{
+	using namespace PyroWave;
+	constexpr float legacy = 0.34f * 1.0f * 96.0f;
+
+	const auto unset = parse_rdo_pixels_per_degree(nullptr);
+	const auto explicit96 = parse_rdo_pixels_per_degree("96");
+	const auto explicit_legacy_ppd = parse_rdo_pixels_per_degree("65.28");
+	ASSERT_THAT(unset.valid && unset.legacy_equivalent);
+	ASSERT_THAT(explicit_legacy_ppd.valid && explicit_legacy_ppd.legacy_equivalent);
+	ASSERT_THAT(explicit96.valid && !explicit96.legacy_equivalent);
+	ASSERT_THAT(float_bits(rdo_cpd_nyquist(unset)) == float_bits(legacy));
+	ASSERT_THAT(float_bits(rdo_cpd_nyquist(explicit_legacy_ppd)) == float_bits(legacy));
+	ASSERT_THAT(float_bits(rdo_cpd_nyquist(explicit96)) == float_bits(48.0f));
+	ASSERT_THAT(float_bits(unset.pixels_per_degree) == float_bits(2.0f * legacy));
+
+	const auto rdo24 = parse_rdo_pixels_per_degree("24");
+	const auto rdo36 = parse_rdo_pixels_per_degree("36");
+	ASSERT_THAT(rdo24.valid && !rdo24.legacy_equivalent && rdo24.pixels_per_degree == 24.0f);
+	ASSERT_THAT(rdo36.valid && !rdo36.legacy_equivalent && rdo36.pixels_per_degree == 36.0f);
+	ASSERT_THAT(float_bits(rdo_cpd_nyquist(rdo24)) == float_bits(12.0f));
+	ASSERT_THAT(float_bits(rdo_cpd_nyquist(rdo36)) == float_bits(18.0f));
+
+	// The encoder's original distortion-CSF calculation must be exactly
+	// preserved at every band/component/level on the default path.
+	for (int level = 0; level < 5; level++)
+		for (int component = 0; component < 3; component++)
+			for (int band = 0; band < 4; band++)
+			{
+				float horiz = (band & 1) ? 0.75f : 0.25f;
+				float vert = (band & 2) ? 0.75f : 0.25f;
+				float cpd = std::sqrt(horiz * horiz + vert * vert) * legacy * std::exp2(-float(level));
+				cpd = std::max(cpd, 8.0f);
+				float old_csf = 2.6f * (0.0192f + 0.114f * cpd) * std::exp(-std::pow(0.114f * cpd, 1.1f));
+				if (component != 0 && level != 4)
+					old_csf *= 0.6f;
+				ASSERT_THAT(float_bits(rdo_quant_csf(unset, level, component, band, true, 5)) == float_bits(old_csf));
+			}
+
+	for (const char *invalid : { "0", "-1", "nan", "inf", "36x", "10001" })
+		ASSERT_THAT(!parse_rdo_pixels_per_degree(invalid).valid);
+
+	std::puts("PYROWAVE_RDO_PX_PER_DEG default parity and validation passed.");
+	return 0;
+}
