+++ b/alvr/graphics/resources/present_ycbcr.glsl
@@ -0,0 +1,36 @@
+// Adapted from JMS1717/Quest3-Pyrowave adeb86b (MIT), mode 5 only.
+// RGBA8 width x height/2: luma 2x2 quads on the left; Cb/Cr in RG on the right.
+uniform bool q3pw_present_ycbcr;
+uniform highp vec2 q3pw_frame_size;
+
+float q3pw_luma(highp ivec2 p) {
+    highp vec2 size = q3pw_frame_size * vec2(1.0, 0.5);
+    vec4 quad = texture(tex, (vec2(p >> 1) + 0.5) / size);
+    int i = (p.x & 1) | ((p.y & 1) << 1);
+    return i == 0 ? quad.r : i == 1 ? quad.g : i == 2 ? quad.b : quad.a;
+}
+
+vec3 q3pw_present_sample(highp vec2 uv) {
+    highp vec2 pos = uv * q3pw_frame_size;
+    highp ivec2 last = ivec2(q3pw_frame_size) - 1;
+#ifdef Q3PW_FFE
+    // WO-8's mapping is unchanged. Match the original RGB sampler's bilinear
+    // luma interpolation, keeping each eye's samples on its own side of the seam.
+    highp vec2 p = pos - 0.5;
+    highp ivec2 lo = ivec2(uv.x < 0.5 ? 0 : int(q3pw_frame_size.x) / 2, 0);
+    highp ivec2 hi = ivec2(lo.x + int(q3pw_frame_size.x) / 2 - 1, last.y);
+    highp ivec2 a = clamp(ivec2(floor(p)), lo, hi);
+    highp ivec2 b = clamp(ivec2(floor(p)) + 1, lo, hi);
+    vec2 f = fract(p);
+    float Y = mix(mix(q3pw_luma(a), q3pw_luma(ivec2(b.x, a.y)), f.x),
+                  mix(q3pw_luma(ivec2(a.x, b.y)), q3pw_luma(b), f.x), f.y);
+#else
+    float Y = q3pw_luma(clamp(ivec2(pos), ivec2(0), last));
+#endif
+    highp vec2 half_size = q3pw_frame_size * 0.5;
+    highp vec2 c = clamp(pos * 0.5, vec2(0.5), half_size - 0.5);
+    vec2 chroma = texture(tex, vec2((half_size.x + c.x) / q3pw_frame_size.x, c.y / half_size.y)).rg - 0.5;
+    return clamp(vec3(Y + 1.5748 * chroma.y,
+                      Y - 0.1873 * chroma.x - 0.4681 * chroma.y,
+                      Y + 1.8556 * chroma.x), 0.0, 1.0);
+}
