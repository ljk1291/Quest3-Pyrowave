diff --git a/alvr/graphics/src/present_ycbcr.rs b/alvr/graphics/src/present_ycbcr.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7cdc76a222bb831d53913e526a45ce38797a56eb
--- /dev/null
+++ b/alvr/graphics/src/present_ycbcr.rs
@@ -0,0 +1,38 @@
+//! Mode-5 layout recognition and shader binding (JMS1717 adeb86b, MIT).
+use alvr_common::glam::UVec2;
+use glow::{self as gl, HasContext};
+use std::ffi::c_void;
+
+#[cfg(target_os = "android")]
+#[repr(C)]
+#[derive(Default)]
+struct HardwareBufferDesc {
+    width: u32, height: u32, layers: u32, format: u32, usage: u64,
+    stride: u32, rfu0: u32, rfu1: u64,
+}
+
+pub(super) fn layout(buffer: *const c_void, eye: UVec2) -> bool {
+    #[cfg(target_os = "android")]
+    {
+        #[link(name = "android")]
+        extern "C" { fn AHardwareBuffer_describe(buffer: *const c_void, desc: *mut HardwareBufferDesc); }
+        if buffer.is_null() || eye.x == 0 || eye.y == 0 { return false; }
+        let mut desc = HardwareBufferDesc::default();
+        unsafe { AHardwareBuffer_describe(buffer, &mut desc); }
+        // Explicit full stereo geometry, never the render/swapchain size. Normal
+        // RGBA output, including MediaCodec, has full height and fails this check.
+        desc.layers == 1 && desc.format == 1 && desc.width == 2 * eye.x && desc.height * 2 == eye.y
+    }
+    #[cfg(not(target_os = "android"))]
+    { let _ = (buffer, eye); false }
+}
+
+pub(super) fn source(source: &str) -> String {
+    source.replace("// Q3PW_PRESENT_FUNCTION", include_str!("../resources/present_ycbcr.glsl"))
+}
+
+pub(super) unsafe fn bind(gl: &gl::Context, program: gl::Program, present: bool, eye: UVec2) {
+    gl.uniform_1_i32(gl.get_uniform_location(program, "q3pw_present_ycbcr").as_ref(), present as i32);
+    gl.uniform_2_f32(gl.get_uniform_location(program, "q3pw_frame_size").as_ref(),
+        (eye.x * 2) as f32, eye.y as f32);
+}
