+void Encoder::get_rdo_density(float *pixels_per_degree, float *nyquist_cycles_per_degree,
+	                            bool *legacy_equivalent) const
+{
+	const auto report = rdo_density_report(impl->rdo_density);
+	if (pixels_per_degree)
+		*pixels_per_degree = report.pixels_per_degree;
+	if (nyquist_cycles_per_degree)
+		*nyquist_cycles_per_degree = report.nyquist_cycles_per_degree;
+	if (legacy_equivalent)
+		*legacy_equivalent = report.legacy_equivalent;
+}
