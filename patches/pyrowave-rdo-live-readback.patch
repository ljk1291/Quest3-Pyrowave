+pyrowave_result pyrowave_encoder_get_rdo_density(pyrowave_encoder encoder, pyrowave_encoder_rdo_density *density)
+{
+	if (!encoder || !density)
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+
+	bool legacy_equivalent = false;
+	encoder->encoder.get_rdo_density(&density->pixels_per_degree,
+	                                 &density->nyquist_cycles_per_degree,
+	                                 &legacy_equivalent);
+	density->legacy_equivalent = legacy_equivalent ? 1u : 0u;
+	return PYROWAVE_SUCCESS;
+}
