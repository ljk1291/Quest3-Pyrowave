@@ -67,8 +67,44 @@ layout(push_constant) uniform Registers
     int block_offset;
     int block_stride;
     float rdo_distortion_scale;
+    int rdo_local_mode;
+    float rdo_requested_ppd;
+    float rdo_uniform_cpd;
+    float rdo_reserved;
+    vec4 rdo_tangent_x;
+    vec4 rdo_tangent_y;
 } registers;
 
+float rdo_csf(float cpd)
+{
+    return 2.6 * (0.0192 + 0.114 * cpd) * exp(-pow(0.114 * cpd, 1.1));
+}
+
+float local_rdo_scale()
+{
+    if (registers.rdo_local_mode == 0) return 1.0;
+    vec2 uv = (vec2(gl_WorkGroupID.xy) + vec2(0.5)) * 32.0 / vec2(registers.resolution);
+    bool right = uv.x >= 0.5;
+    float eye_u = right ? (uv.x - 0.5) * 2.0 : uv.x * 2.0;
+    float left = right ? registers.rdo_tangent_x.z : registers.rdo_tangent_x.x;
+    float right_edge = right ? registers.rdo_tangent_x.w : registers.rdo_tangent_x.y;
+    float tx = mix(left, right_edge, eye_u);
+    float ty = mix(registers.rdo_tangent_y.x, registers.rdo_tangent_y.y, uv.y);
+    float common = 1.0 + tx * tx + ty * ty;
+    float ppdx = 2624.0 / (right_edge - left) * common / sqrt(1.0 + ty * ty) * 0.017453292519943295;
+    float ppdy = 2776.0 / (registers.rdo_tangent_y.y - registers.rdo_tangent_y.x) * common / sqrt(1.0 + tx * tx) * 0.017453292519943295;
+    float axis_ppdx = 2624.0 / (right_edge - left) * 0.017453292519943295;
+    float axis_ppdy = 2776.0 / (registers.rdo_tangent_y.y - registers.rdo_tangent_y.x) * 0.017453292519943295;
+    float density = registers.rdo_requested_ppd * sqrt(ppdx * ppdy) / sqrt(axis_ppdx * axis_ppdy);
+    if (registers.rdo_local_mode == 2) {
+        float edge = max(max(length(vec2(left, registers.rdo_tangent_y.x)), length(vec2(left, registers.rdo_tangent_y.y))), max(length(vec2(right_edge, registers.rdo_tangent_y.x)), length(vec2(right_edge, registers.rdo_tangent_y.y))));
+        density /= 1.0 + min(1.0, length(vec2(tx, ty)) / edge);
+    }
+    float local_cpd = max(8.0, registers.rdo_uniform_cpd * density / registers.rdo_requested_ppd);
+    float ratio = rdo_csf(local_cpd) / rdo_csf(registers.rdo_uniform_cpd);
+    return ratio * ratio;
+}
