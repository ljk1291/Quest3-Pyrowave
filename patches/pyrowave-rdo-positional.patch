diff --git a/pyrowave_rdo_density.hpp b/pyrowave_rdo_density.hpp
index 774a115..1cf8499 100644
--- a/pyrowave_rdo_density.hpp
+++ b/pyrowave_rdo_density.hpp
@@ -26,6 +26,40 @@ struct RDODensity
 	bool legacy_equivalent = true;
 };
 
+enum class RDOLocalMode { Disabled, Tangent, TangentEccentricity };
+struct RDOProjection { float left, right, bottom, top, width, height; };
+
+inline RDOLocalMode parse_rdo_local_mode(const char *requested)
+{
+	if (!requested || !*requested || std::strcmp(requested, "0") == 0) return RDOLocalMode::Disabled;
+	if (std::strcmp(requested, "1") == 0) return RDOLocalMode::Tangent;
+	if (std::strcmp(requested, "2") == 0) return RDOLocalMode::TangentEccentricity;
+	return RDOLocalMode::Disabled;
+}
+
+inline float rdo_tangent_geomean_ppd(float tx, float ty, const RDOProjection &p)
+{
+	constexpr float radians_per_degree = 0.01745329251994329577f;
+	const float common = 1.0f + tx * tx + ty * ty;
+	const float ppdx = p.width / (p.right - p.left) * common / std::sqrt(1.0f + ty * ty) * radians_per_degree;
+	const float ppdy = p.height / (p.top - p.bottom) * common / std::sqrt(1.0f + tx * tx) * radians_per_degree;
+	return std::sqrt(ppdx * ppdy);
+}
+
+inline float rdo_local_ppd(float requested_ppd, float tx, float ty, const RDOProjection &p, RDOLocalMode mode)
+{
+	if (mode == RDOLocalMode::Disabled) return requested_ppd;
+	const float axis = rdo_tangent_geomean_ppd(0.0f, 0.0f, p);
+	float local = requested_ppd * rdo_tangent_geomean_ppd(tx, ty, p) / axis;
+	if (mode == RDOLocalMode::TangentEccentricity) {
+		const float edge = std::max(std::max(std::hypot(p.left, p.bottom), std::hypot(p.left, p.top)),
+		                            std::max(std::hypot(p.right, p.bottom), std::hypot(p.right, p.top)));
+		const float eccentricity = std::sqrt(tx * tx + ty * ty);
+		local /= 1.0f + std::min(1.0f, eccentricity / edge);
+	}
+	return local;
+}
+
 inline RDODensity parse_rdo_pixels_per_degree(const char *requested)
 {
 	RDODensity density = {};
diff --git a/pyrowave_rdo_density_test.cpp b/pyrowave_rdo_density_test.cpp
index 0bd6466..d19a411 100644
--- a/pyrowave_rdo_density_test.cpp
+++ b/pyrowave_rdo_density_test.cpp
@@ -59,6 +59,26 @@ int main()
 	for (const char *invalid : { "0", "-1", "nan", "inf", "36x", "10001" })
 		ASSERT_THAT(!parse_rdo_pixels_per_degree(invalid).valid);
 
+	// Position-aware mode is a scalar post-factor. Disabled mode is the exact
+	// requested input, preserving the legacy default arithmetic contract.
+	const RDOProjection left = { -1.17589234f, 0.71649807f, -1.22520507f, 0.83088732f, 2624.0f, 2776.0f };
+	const RDOProjection right = { -0.71649807f, 1.17589234f, -1.22520507f, 0.83088732f, 2624.0f, 2776.0f };
+	ASSERT_THAT(float_bits(rdo_local_ppd(24.0f, 0.3f, -0.2f, left, RDOLocalMode::Disabled)) == float_bits(24.0f));
+	ASSERT_THAT(float_bits(rdo_local_ppd(24.0f, 0.0f, 0.0f, left, RDOLocalMode::Tangent)) == float_bits(24.0f));
+	// The two effective crop frusta are mirror images about the optical axis.
+	ASSERT_THAT(std::fabs(rdo_local_ppd(24.0f, -0.5f, 0.3f, left, RDOLocalMode::Tangent) -
+	                      rdo_local_ppd(24.0f, 0.5f, 0.3f, right, RDOLocalMode::Tangent)) < 1.0e-5f);
+	const float tangent_corner = rdo_local_ppd(24.0f, left.left, left.bottom, left, RDOLocalMode::Tangent);
+	const float eccentric_corner = rdo_local_ppd(24.0f, left.left, left.bottom, left, RDOLocalMode::TangentEccentricity);
+	ASSERT_THAT(std::fabs(eccentric_corner * 2.0f - tangent_corner) < 1.0e-5f);
+	const float inside = rdo_local_ppd(24.0f, -0.2f, 0.2f, left, RDOLocalMode::TangentEccentricity);
+	ASSERT_THAT(inside <= rdo_local_ppd(24.0f, -0.2f, 0.2f, left, RDOLocalMode::Tangent));
+	ASSERT_THAT(inside >= rdo_local_ppd(24.0f, -0.2f, 0.2f, left, RDOLocalMode::Tangent) * 0.5f);
+	ASSERT_THAT(parse_rdo_local_mode(nullptr) == RDOLocalMode::Disabled);
+	ASSERT_THAT(parse_rdo_local_mode("1") == RDOLocalMode::Tangent);
+	ASSERT_THAT(parse_rdo_local_mode("2") == RDOLocalMode::TangentEccentricity);
+	ASSERT_THAT(parse_rdo_local_mode("bad") == RDOLocalMode::Disabled);
+
 	std::puts("PYROWAVE_RDO_PX_PER_DEG default parity and validation passed.");
 	return 0;
 }
