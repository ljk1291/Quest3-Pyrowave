+bool NvEncoder::TryGetCapabilityValue(GUID codec, NV_ENC_CAPS cap, int* value) const {
+    if (!value) {
+        return false;
+    }
+
+    *value = 0;
+    if (!m_hEncoder || !m_nvenc.nvEncGetEncodeCaps) {
+        return false;
+    }
+
+    NV_ENC_CAPS_PARAM params = { NV_ENC_CAPS_PARAM_VER };
+    params.capsToQuery = cap;
+    return m_nvenc.nvEncGetEncodeCaps(m_hEncoder, codec, &params, value) == NV_ENC_SUCCESS;
+}
+
+bool NvEncoder::ValidateEncodeDimensions(
+    const NV_ENC_INITIALIZE_PARAMS& params, std::string* reason
+) const {
+    using namespace alvr_nvenc_dimension;
+
+    Codec codec = Codec::Unknown;
+    if (params.encodeGUID == NV_ENC_CODEC_H264_GUID) {
+        codec = Codec::H264;
+    } else if (params.encodeGUID == NV_ENC_CODEC_HEVC_GUID) {
+        codec = Codec::HEVC;
+    } else if (params.encodeGUID == NV_ENC_CODEC_AV1_GUID) {
+        codec = Codec::AV1;
+    }
+
+    int width_max = 0;
+    int height_max = 0;
+    Caps caps = { false, 0, false, 0 };
+    if (codec != Codec::Unknown) {
+        caps = {
+            TryGetCapabilityValue(params.encodeGUID, NV_ENC_CAPS_WIDTH_MAX, &width_max),
+            width_max,
+            TryGetCapabilityValue(params.encodeGUID, NV_ENC_CAPS_HEIGHT_MAX, &height_max),
+            height_max,
+        };
+    }
+
+    const bool valid = Validate(
+        codec,
+        static_cast<int>(params.encodeWidth),
+        static_cast<int>(params.encodeHeight),
+        caps,
+        reason
+    );
+    if (reason) {
+        *reason += " requested=" + std::to_string(params.encodeWidth) + "x"
+            + std::to_string(params.encodeHeight) + " caps=" + std::to_string(width_max) + "x"
+            + std::to_string(height_max);
+    }
+    return valid;
+}
